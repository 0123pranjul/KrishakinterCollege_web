@model School_CRM.Models.TblStudent

<form id="studentForm"
      asp-action="CreateOrEdit"
      asp-controller="Student"
      asp-route-id="@Model.StudentId"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="StudentId" />

    <div class="row g-3">

        <!-- Student Name -->
        <div class="col-12">
            <label asp-for="StudentName" class="form-label fw-semibold">
                Student Name <span class="text-danger">*</span>
            </label>
            <input asp-for="StudentName"
                   class="form-control"
                   placeholder="Enter student full name" />
            <span asp-validation-for="StudentName" class="text-danger small"></span>
        </div>

        <!-- Roll No -->
        <div class="col-12">
            <label asp-for="RollNo" class="form-label fw-semibold">
                Roll No <span class="text-danger">*</span>
            </label>
            <input asp-for="RollNo"
                   class="form-control"
                   placeholder="Enter roll number" />
            <span asp-validation-for="RollNo" class="text-danger small"></span>
        </div>

        <!-- IsActive Dropdown -->
        <div class="col-12">
            <label asp-for="IsActive" class="form-label fw-semibold">
                Status <span class="text-danger">*</span>
            </label>
            <select asp-for="IsActive" class="form-select">
                <option value="">-- Select Status --</option>
                <option value="true"  selected="@(Model.IsActive == true  ? "selected" : null)">Active</option>
                <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">Inactive</option>
            </select>
            <span asp-validation-for="IsActive" class="text-danger small"></span>
        </div>

    </div>

    <!-- Footer Buttons -->
    <div class="modal-footer px-0 pb-0 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Student
        </button>
    </div>

</form>
