@model School_CRM.Models.DTOs.InvMemberDashboardDto
@{ ViewData["Title"] = "My Store Account"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-shopping-bag text-primary me-2"></i>My Store Account</h2>
            <small class="text-muted">Your purchases and dues</small>
        </div>
        <a asp-controller="StoreProduct" asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-search me-1"></i>Browse Products
        </a>
    </div>

    @if (Model.PendingDues > 0)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4">
            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
            <div>
                <strong>Pending Dues: ₹@Model.PendingDues.ToString("F2")</strong><br />
                <small>Please clear your dues at the store counter.</small>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success d-flex align-items-center mb-4 py-2">
            <i class="fas fa-check-circle me-2"></i>
            <small>No pending dues. Your account is clear.</small>
        </div>
    }

    <!-- Unpaid Bills -->
    @if (Model.UnpaidBills.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-danger"><i class="fas fa-file-invoice me-2"></i>Unpaid Bills</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Bill No.</th><th>Date</th><th>Total</th><th>Paid</th><th>Balance</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.UnpaidBills)
                            {
                                <tr>
                                    <td><code>@b.BillNumber</code></td>
                                    <td>@b.SaleDate.ToString("dd/MM/yyyy")</td>
                                    <td>₹@b.TotalAmount.ToString("F2")</td>
                                    <td class="text-success">₹@b.AmountPaid.ToString("F2")</td>
                                    <td class="text-danger fw-bold">₹@b.BalanceDue.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Recent Purchases -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0"><i class="fas fa-history me-2 text-secondary"></i>Recent Purchases</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Bill No.</th><th>Date</th><th>Amount</th><th>Payment</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentPurchases.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No purchase history</td></tr>
                        }
                        @foreach (var b in Model.RecentPurchases)
                        {
                            <tr>
                                <td><code>@b.BillNumber</code></td>
                                <td>@b.SaleDate.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">₹@b.TotalAmount.ToString("F2")</td>
                                <td><span class="badge bg-info text-dark">@b.PaymentMode</span></td>
                                <td><span class="badge @(b.IsPaid ? "bg-success" : "bg-danger")">@(b.IsPaid ? "Paid" : "Pending")</span></td>
                                <td>
                                    <a asp-controller="StoreSale" asp-action="Bill" asp-route-id="@b.SaleId"
                                       class="btn btn-sm btn-outline-secondary" target="_blank">
                                        <i class="fas fa-print"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Item-wise History -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0"><i class="fas fa-box me-2 text-info"></i>Item-wise Purchase History</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Product</th><th>Total Qty</th><th>Last Purchase</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.ItemHistory.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No item history</td></tr>
                        }
                        @foreach (var item in Model.ItemHistory)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td>@item.TotalQty</td>
                                <td class="text-muted">@item.LastPurchase.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
