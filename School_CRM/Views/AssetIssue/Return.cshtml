@model School_CRM.Models.DTOs.ReturnAssetDto
@{ ViewData["Title"] = "Return Asset"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-undo text-success me-2"></i>Return Asset</h2>
            <small class="text-muted">Process asset return and record condition</small>
        </div>
        <a asp-action="Create" class="btn btn-outline-primary"><i class="fas fa-arrow-up me-1"></i>Issue Asset</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null)   { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-qrcode me-2 text-primary"></i>Scan / Enter Asset Tag</h6>
                </div>
                <div class="card-body">
                    <div class="input-group input-group-lg mb-3">
                        <input type="text" id="returnTagInput" class="form-control" placeholder="Scan QR or type tag..." autofocus oninput="fetchReturnInfo()" />
                        <button type="button" class="btn btn-outline-secondary" onclick="clearReturn()"><i class="fas fa-times"></i></button>
                    </div>
                    <div id="scanAlert" class="d-none"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div id="returnDetailsCard" class="d-none">
                <form asp-action="Return" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="AssetTag" type="hidden" id="returnTagHidden" />
                    <input asp-for="IssueId" type="hidden" id="returnIssueId" />
                    <input asp-for="UnitId" type="hidden" id="returnUnitId" />

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0"><i class="fas fa-info-circle me-2 text-primary"></i>Issue Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="text-muted small">Asset</label><div class="fw-bold" id="retAssetName"></div></div>
                                <div class="col-md-6"><label class="text-muted small">Issued To</label><div class="fw-bold" id="retIssuedTo"></div></div>
                                <div class="col-md-4"><label class="text-muted small">Issue Date</label><div id="retIssueDate"></div></div>
                                <div class="col-md-4"><label class="text-muted small">Expected Return</label><div id="retExpReturn"></div></div>
                                <div class="col-md-4"><label class="text-muted small">Days With Member</label><div class="fw-bold" id="retDays"></div></div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0"><i class="fas fa-clipboard-check me-2 text-warning"></i>Return Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="ConditionOnReturn" class="form-label fw-semibold">Condition on Return <span class="text-danger">*</span></label>
                                    <select asp-for="ConditionOnReturn" class="form-select" id="conditionSelect" onchange="updateConditionFlags()">
                                        <option value="Good">Good</option>
                                        <option value="Fair">Fair</option>
                                        <option value="Damaged">Damaged</option>
                                        <option value="Lost">Lost</option>
                                    </select>
                                </div>
                                <div class="col-md-6" id="fineRow" style="display:none">
                                    <label asp-for="DamageFine" class="form-label fw-semibold">Damage / Loss Fine (₹)</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input asp-for="DamageFine" type="number" step="0.01" class="form-control" />
                                    </div>
                                </div>
                                <input asp-for="IsDamaged" type="hidden" id="isDamagedHidden" />
                                <input asp-for="IsLost" type="hidden" id="isLostHidden" />
                                <div class="col-12">
                                    <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg px-5"><i class="fas fa-check me-2"></i>Process Return</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="clearReturn()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let retTimer;
    function fetchReturnInfo() {
        clearTimeout(retTimer);
        retTimer = setTimeout(async () => {
            const tag = document.getElementById('returnTagInput').value.trim();
            const alertDiv = document.getElementById('scanAlert');
            const card     = document.getElementById('returnDetailsCard');
            if (!tag) { alertDiv.classList.add('d-none'); card.classList.add('d-none'); return; }

            const resp   = await fetch(`/Assets/Issue/GetReturnInfo?assetTag=${encodeURIComponent(tag)}`);
            const result = await resp.json();
            alertDiv.classList.remove('d-none');

            if (result.success) {
                const d = result.data;
                alertDiv.innerHTML = `<div class="alert alert-success py-2 mb-0"><i class="fas fa-check-circle me-2"></i>Issue found. Fill return details.</div>`;
                document.getElementById('returnTagHidden').value = tag;
                document.getElementById('returnIssueId').value  = d.issueId;
                document.getElementById('returnUnitId').value   = d.unitId;
                document.getElementById('retAssetName').textContent  = d.assetName;
                document.getElementById('retIssuedTo').textContent   = d.issuedToName ?? '-';
                document.getElementById('retIssueDate').textContent  = new Date(d.issueDate).toLocaleDateString('en-GB');
                document.getElementById('retExpReturn').textContent  = d.expectedReturnDate ? new Date(d.expectedReturnDate).toLocaleDateString('en-GB') : 'N/A';
                document.getElementById('retDays').textContent       = d.daysWithMember + ' days';
                card.classList.remove('d-none');
            } else {
                alertDiv.innerHTML = `<div class="alert alert-warning py-2 mb-0"><i class="fas fa-exclamation-triangle me-2"></i>${result.message}</div>`;
                card.classList.add('d-none');
            }
        }, 500);
    }

    function updateConditionFlags() {
        const cond = document.getElementById('conditionSelect').value;
        document.getElementById('isDamagedHidden').value = cond === 'Damaged' ? 'true' : 'false';
        document.getElementById('isLostHidden').value    = cond === 'Lost'    ? 'true' : 'false';
        document.getElementById('fineRow').style.display = (cond === 'Damaged' || cond === 'Lost') ? '' : 'none';
    }

    function clearReturn() {
        document.getElementById('returnTagInput').value = '';
        document.getElementById('scanAlert').classList.add('d-none');
        document.getElementById('returnDetailsCard').classList.add('d-none');
    }
</script>
}
