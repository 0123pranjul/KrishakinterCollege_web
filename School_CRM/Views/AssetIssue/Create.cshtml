@model School_CRM.Models.DTOs.IssueAssetDto
@{ ViewData["Title"] = "Issue Asset"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-arrow-up text-primary me-2"></i>Issue Asset</h2>
            <small class="text-muted">Issue an asset to staff, teacher, student, or location</small>
        </div>
        <a asp-action="Return" class="btn btn-outline-success"><i class="fas fa-undo me-1"></i>Return Asset</a>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <form asp-action="Create" method="post" id="issueForm">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Step 1: Scan Asset -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><span class="badge bg-primary rounded-circle me-2">1</span>Scan / Enter Asset Tag</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="AssetTag" class="form-label fw-semibold">Asset Tag / QR Scan <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="AssetTag" class="form-control" id="assetTagInput" placeholder="Scan QR or type tag..." autofocus oninput="checkAsset()" />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearAsset()"><i class="fas fa-times"></i></button>
                            </div>
                        </div>
                        <div id="assetAlert" class="d-none"></div>
                        <div id="assetInfoCard" class="d-none">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2">
                                    <div class="fw-bold" id="assetNameDisplay"></div>
                                    <small class="text-muted" id="assetCategoryDisplay"></small>
                                    <div class="mt-1">
                                        <span class="badge bg-success" id="assetConditionBadge"></span>
                                        <span class="badge bg-info ms-1" id="assetLocationBadge"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Select Person -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><span class="badge bg-primary rounded-circle me-2">2</span>Issue To</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="IssuedToType" class="form-label fw-semibold">Issue To Type <span class="text-danger">*</span></label>
                            <select asp-for="IssuedToType" class="form-select" id="issuedToTypeSelect" onchange="loadPersonList()">
                                <option value="">Select Type</option>
                                <option value="Teacher">Teacher</option>
                                <option value="Staff">Staff</option>
                                <option value="Student">Student</option>
                                <option value="Location">Location (Permanent)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Search</label>
                            <input type="text" id="personSearch" class="form-control" placeholder="Type name..." oninput="searchPerson()" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="IssuedToId" class="form-label fw-semibold">Select Person / Location <span class="text-danger">*</span></label>
                            <select asp-for="IssuedToId" class="form-select" id="personSelect">
                                <option value="">Select...</option>
                            </select>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="IssueDate" class="form-label fw-semibold small">Issue Date</label>
                                <input asp-for="IssueDate" type="date" class="form-control form-control-sm" />
                            </div>
                            <div class="col-6">
                                <label asp-for="ExpectedReturnDate" class="form-label fw-semibold small">Expected Return</label>
                                <input asp-for="ExpectedReturnDate" type="date" class="form-control form-control-sm" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Purpose" class="form-label fw-semibold small">Purpose</label>
                                <input asp-for="Purpose" class="form-control form-control-sm" placeholder="Optional..." />
                            </div>
                            <div class="col-12">
                                <label asp-for="TransactionStatus" class="form-label fw-semibold small">Issue Type</label>
                                <select asp-for="TransactionStatus" class="form-select form-select-sm">
                                    <option value="Issued">Temporary Issue</option>
                                    <option value="Permanent">Permanent Assignment</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div id="issueSummary" class="text-muted small">Scan asset and select person to proceed</div>
                        <button type="submit" class="btn btn-primary btn-lg px-5" id="issueBtn" disabled>
                            <i class="fas fa-check me-2"></i>Issue Asset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let assetValid = false, personValid = false;

    let assetTimer;
    function checkAsset() {
        clearTimeout(assetTimer);
        assetTimer = setTimeout(async () => {
            const tag = document.getElementById('assetTagInput').value.trim();
            const alertDiv = document.getElementById('assetAlert');
            const infoCard = document.getElementById('assetInfoCard');
            if (!tag) { alertDiv.classList.add('d-none'); infoCard.classList.add('d-none'); assetValid = false; updateBtn(); return; }

            const resp = await fetch(`/Assets/Issue/CheckAsset?assetTag=${encodeURIComponent(tag)}`);
            const result = await resp.json();
            alertDiv.classList.remove('d-none');

            if (result.isEligible) {
                alertDiv.innerHTML = `<div class="alert alert-success py-2 mb-0"><i class="fas fa-check-circle me-2"></i>Asset available for issue.</div>`;
                document.getElementById('assetNameDisplay').textContent = result.unitDetails?.assetName ?? tag;
                document.getElementById('assetCategoryDisplay').textContent = result.unitDetails?.categoryName ?? '';
                document.getElementById('assetConditionBadge').textContent = result.unitCondition;
                document.getElementById('assetLocationBadge').textContent = result.unitDetails?.locationName ?? '';
                infoCard.classList.remove('d-none');
                assetValid = true;
            } else {
                alertDiv.innerHTML = `<div class="alert alert-danger py-2 mb-0"><i class="fas fa-times-circle me-2"></i>${result.message}</div>`;
                infoCard.classList.add('d-none');
                assetValid = false;
            }
            updateBtn();
        }, 500);
    }

    function clearAsset() {
        document.getElementById('assetTagInput').value = '';
        document.getElementById('assetAlert').classList.add('d-none');
        document.getElementById('assetInfoCard').classList.add('d-none');
        assetValid = false; updateBtn();
    }

    async function loadPersonList() {
        const type = document.getElementById('issuedToTypeSelect').value;
        const sel  = document.getElementById('personSelect');
        sel.innerHTML = '<option value="">Loading...</option>';
        if (!type) { sel.innerHTML = '<option value="">Select...</option>'; return; }
        const resp = await fetch(`/Assets/Issue/GetPersonList?type=${type}`);
        const data = await resp.json();
        sel.innerHTML = '<option value="">Select...</option>';
        data.forEach(p => sel.innerHTML += `<option value="${p.id}">${p.name} (${p.code})</option>`);
    }

    let personTimer;
    function searchPerson() {
        clearTimeout(personTimer);
        personTimer = setTimeout(async () => {
            const type   = document.getElementById('issuedToTypeSelect').value;
            const search = document.getElementById('personSearch').value;
            if (!type || search.length < 2) return;
            const resp = await fetch(`/Assets/Issue/GetPersonList?type=${type}&search=${encodeURIComponent(search)}`);
            const data = await resp.json();
            const sel  = document.getElementById('personSelect');
            sel.innerHTML = '<option value="">Select...</option>';
            data.forEach(p => sel.innerHTML += `<option value="${p.id}">${p.name} (${p.code})</option>`);
        }, 400);
    }

    document.getElementById('personSelect').addEventListener('change', function() {
        personValid = !!this.value; updateBtn();
    });

    function updateBtn() {
        const btn = document.getElementById('issueBtn');
        const sum = document.getElementById('issueSummary');
        btn.disabled = !(assetValid && personValid);
        sum.innerHTML = assetValid && personValid
            ? '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Ready to issue</span>'
            : 'Scan asset and select person to proceed';
    }
</script>
}
