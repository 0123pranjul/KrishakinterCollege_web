@model School_CRM.Models.DTOs.IssueBookDto
@{
    ViewData["Title"] = "Issue Book";
    var policy = ViewBag.Policy as School_CRM.Models.LibFinePolicy;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-arrow-up text-primary me-2"></i>Issue Book</h2>
            <small class="text-muted">Issue a book to a student or teacher</small>
        </div>
        <a asp-action="Return" class="btn btn-outline-success"><i class="fas fa-undo me-1"></i>Return Book</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="issueForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- STEP 1: Member Selection -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">
                            <span class="badge bg-primary rounded-circle me-2">1</span>
                            Select Member
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Member Type <span class="text-danger">*</span></label>
                            <select asp-for="UserType" class="form-select" id="userTypeSelect" onchange="loadMembers()">
                                <option value="">Select Type</option>
                                <option value="Student">Student</option>
                                <option value="Teacher">Teacher</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Search Member</label>
                            <input type="text" id="memberSearch" class="form-control" placeholder="Type name or code..."
                                   oninput="searchMembers()" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label fw-semibold">Member <span class="text-danger">*</span></label>
                            <select asp-for="UserId" class="form-select" id="memberSelect" onchange="checkMemberEligibility()">
                                <option value="">Select Member</option>
                            </select>
                        </div>

                        <!-- Member Info Card -->
                        <div id="memberInfoCard" class="d-none">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <img id="memberPhoto" src="" alt="" class="rounded-circle"
                                             style="width:50px;height:50px;object-fit:cover;display:none;" />
                                        <div>
                                            <div class="fw-bold" id="memberNameDisplay"></div>
                                            <small class="text-muted" id="memberCodeDisplay"></small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Eligibility Alert -->
                        <div id="eligibilityAlert" class="d-none mt-2"></div>
                    </div>
                </div>
            </div>

            <!-- STEP 2: Book Selection -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">
                            <span class="badge bg-primary rounded-circle me-2">2</span>
                            Scan / Enter Book
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="AccessionNo" class="form-label fw-semibold">
                                Accession No. / QR Scan <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="AccessionNo" class="form-control" id="accessionInput"
                                       placeholder="Scan QR or type accession no..." autofocus
                                       oninput="fetchBookInfo()" />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearBook()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Book Info Card -->
                        <div id="bookInfoCard" class="d-none">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2">
                                    <div class="fw-bold" id="bookTitleDisplay"></div>
                                    <small class="text-muted" id="bookAuthorDisplay"></small>
                                    <div class="mt-1">
                                        <span class="badge bg-success" id="bookConditionBadge"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="bookAlert" class="d-none mt-2"></div>

                        <div class="row g-3 mt-1">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Issue Date</label>
                                <input type="text" class="form-control" value="@DateTime.Today.ToString("dd/MM/yyyy")" readonly />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Due Date</label>
                                <input type="text" class="form-control bg-warning-subtle fw-bold" id="dueDateDisplay" readonly />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Optional remarks..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div id="issueSummary" class="text-muted small">
                            Select member and scan book to proceed
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg px-5" id="issueBtn" disabled>
                            <i class="fas fa-check me-2"></i>Issue Book
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let memberEligible = false;
    let bookValid = false;
    let policyIssueDaysStudent = @(policy?.IssueDaysForStudent ?? 14);
    let policyIssueDaysTeacher = @(policy?.IssueDaysForTeacher ?? 30);

    async function loadMembers() {
        const userType = document.getElementById('userTypeSelect').value;
        const select = document.getElementById('memberSelect');
        select.innerHTML = '<option value="">Loading...</option>';
        document.getElementById('memberInfoCard').classList.add('d-none');
        document.getElementById('eligibilityAlert').classList.add('d-none');
        memberEligible = false;
        updateIssueButton();

        if (!userType) {
            select.innerHTML = '<option value="">Select Member</option>';
            return;
        }

        const resp = await fetch(`/Library/Issue/GetMembers?userType=${userType}`);
        const members = await resp.json();
        select.innerHTML = '<option value="">Select Member</option>';
        members.forEach(m => {
            select.innerHTML += `<option value="${m.userId}">${m.name} (${m.code})</option>`;
        });
    }

    async function searchMembers() {
        const userType = document.getElementById('userTypeSelect').value;
        const search = document.getElementById('memberSearch').value;
        if (!userType || search.length < 2) return;

        const resp = await fetch(`/Library/Issue/GetMembers?userType=${userType}&search=${encodeURIComponent(search)}`);
        const members = await resp.json();
        const select = document.getElementById('memberSelect');
        select.innerHTML = '<option value="">Select Member</option>';
        members.forEach(m => {
            select.innerHTML += `<option value="${m.userId}">${m.name} (${m.code})</option>`;
        });
    }

    async function checkMemberEligibility() {
        const userType = document.getElementById('userTypeSelect').value;
        const userId = document.getElementById('memberSelect').value;
        const alertDiv = document.getElementById('eligibilityAlert');
        const infoCard = document.getElementById('memberInfoCard');

        if (!userType || !userId) {
            alertDiv.classList.add('d-none');
            infoCard.classList.add('d-none');
            memberEligible = false;
            updateIssueButton();
            return;
        }

        // Show member info
        const select = document.getElementById('memberSelect');
        const selectedOption = select.options[select.selectedIndex];
        document.getElementById('memberNameDisplay').textContent = selectedOption.text.split('(')[0].trim();
        document.getElementById('memberCodeDisplay').textContent = selectedOption.text;
        infoCard.classList.remove('d-none');

        // Check eligibility
        const resp = await fetch(`/Library/Issue/CheckEligibility?userType=${userType}&userId=${userId}`);
        const result = await resp.json();

        alertDiv.classList.remove('d-none');

        if (result.isEligible) {
            alertDiv.innerHTML = `<div class="alert alert-success py-2 mb-0"><i class="fas fa-check-circle me-2"></i>Member is eligible to borrow books. (${result.currentIssuedCount}/${result.maxAllowed} books issued)</div>`;
            memberEligible = true;
        } else {
            let msgs = result.messages.join('<br>');
            alertDiv.innerHTML = `<div class="alert alert-danger py-2 mb-0"><i class="fas fa-ban me-2"></i>${msgs}</div>`;
            memberEligible = false;
        }

        // Update due date
        updateDueDate(userType);
        updateIssueButton();
    }

    function updateDueDate(userType) {
        const days = userType === 'Student' ? policyIssueDaysStudent : policyIssueDaysTeacher;
        const dueDate = new Date();
        dueDate.setDate(dueDate.getDate() + days);
        document.getElementById('dueDateDisplay').value = dueDate.toLocaleDateString('en-GB');
    }

    let bookFetchTimeout;
    function fetchBookInfo() {
        clearTimeout(bookFetchTimeout);
        bookFetchTimeout = setTimeout(async () => {
            const accNo = document.getElementById('accessionInput').value.trim();
            const bookCard = document.getElementById('bookInfoCard');
            const bookAlert = document.getElementById('bookAlert');

            if (!accNo) {
                bookCard.classList.add('d-none');
                bookAlert.classList.add('d-none');
                bookValid = false;
                updateIssueButton();
                return;
            }

            const resp = await fetch(`/Library/Issue/GetReturnInfo?accessionNo=${encodeURIComponent(accNo)}`);
            const result = await resp.json();

            bookAlert.classList.remove('d-none');

            if (result.success) {
                // Book is currently issued - cannot issue again
                bookAlert.innerHTML = `<div class="alert alert-danger py-2 mb-0"><i class="fas fa-times-circle me-2"></i>This copy is already issued.</div>`;
                bookCard.classList.add('d-none');
                bookValid = false;
            } else {
                // Try to get book info for available copy
                const bookResp = await fetch(`/Library/Book/Scan/${encodeURIComponent(accNo)}`);
                if (bookResp.ok) {
                    bookAlert.innerHTML = `<div class="alert alert-success py-2 mb-0"><i class="fas fa-check-circle me-2"></i>Book found and available.</div>`;
                    document.getElementById('bookTitleDisplay').textContent = accNo;
                    document.getElementById('bookAuthorDisplay').textContent = 'Available for issue';
                    document.getElementById('bookConditionBadge').textContent = 'Available';
                    bookCard.classList.remove('d-none');
                    bookValid = true;
                } else {
                    bookAlert.innerHTML = `<div class="alert alert-warning py-2 mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Book copy not found.</div>`;
                    bookCard.classList.add('d-none');
                    bookValid = false;
                }
            }

            updateIssueButton();
        }, 500);
    }

    function clearBook() {
        document.getElementById('accessionInput').value = '';
        document.getElementById('bookInfoCard').classList.add('d-none');
        document.getElementById('bookAlert').classList.add('d-none');
        bookValid = false;
        updateIssueButton();
    }

    function updateIssueButton() {
        const btn = document.getElementById('issueBtn');
        const summary = document.getElementById('issueSummary');
        const canIssue = memberEligible && bookValid;
        btn.disabled = !canIssue;

        if (canIssue) {
            summary.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Ready to issue</span>';
        } else if (!memberEligible && !bookValid) {
            summary.textContent = 'Select member and scan book to proceed';
        } else if (!memberEligible) {
            summary.innerHTML = '<span class="text-danger"><i class="fas fa-times me-1"></i>Member not eligible</span>';
        } else {
            summary.innerHTML = '<span class="text-warning"><i class="fas fa-exclamation me-1"></i>Scan a valid book</span>';
        }
    }
</script>
}
