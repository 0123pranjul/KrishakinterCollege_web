@model School_CRM.Models.DTOs.ReturnBookDto
@{
    ViewData["Title"] = "Return Book";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-undo text-success me-2"></i>Return Book</h2>
            <small class="text-muted">Process book return and calculate fines</small>
        </div>
        <a asp-action="Create" class="btn btn-outline-primary"><i class="fas fa-arrow-up me-1"></i>Issue Book</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            @if (TempData["FineAmount"] != null && decimal.Parse(TempData["FineAmount"]!.ToString()!) > 0)
            {
                <a href="#" class="btn btn-sm btn-warning ms-3">Collect Fine</a>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Scan Input -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-qrcode me-2 text-primary"></i>Scan / Enter Accession No.</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Accession No. / QR Scan</label>
                        <div class="input-group input-group-lg">
                            <input type="text" id="returnAccessionInput" class="form-control"
                                   placeholder="Scan QR or type accession no..." autofocus
                                   oninput="fetchReturnInfo()" />
                            <button type="button" class="btn btn-outline-secondary" onclick="clearReturn()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <div id="scanAlert" class="d-none"></div>
                </div>
            </div>
        </div>

        <!-- Return Details -->
        <div class="col-lg-7">
            <div id="returnDetailsCard" class="d-none">
                <form asp-action="Return" method="post" id="returnForm">
                    @Html.AntiForgeryToken()
                    <input asp-for="AccessionNo" type="hidden" id="returnAccessionHidden" />
                    <input asp-for="IssueId" type="hidden" id="returnIssueId" />

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0"><i class="fas fa-info-circle me-2 text-primary"></i>Issue Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Member</label>
                                    <div class="fw-bold" id="returnMemberName"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Book</label>
                                    <div class="fw-bold" id="returnBookTitle"></div>
                                    <small class="text-muted" id="returnBookAuthor"></small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Issue Date</label>
                                    <div id="returnIssueDate"></div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Due Date</label>
                                    <div id="returnDueDate" class="fw-bold"></div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Overdue Days</label>
                                    <div id="returnOverdueDays" class="fw-bold text-danger"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Fine Calculation -->
                    <div class="card border-0 shadow-sm mb-3" id="fineCard">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0"><i class="fas fa-rupee-sign me-2 text-warning"></i>Fine Calculation</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="ConditionOnReturn" class="form-label fw-semibold">
                                        Book Condition on Return <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="ConditionOnReturn" class="form-select" id="conditionSelect"
                                            onchange="updateFineDisplay()">
                                        <option value="Good">Good</option>
                                        <option value="Damaged">Damaged</option>
                                        <option value="Lost">Lost</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Calculated Fine</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input type="text" class="form-control fw-bold text-danger" id="calculatedFineDisplay" readonly />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg px-5">
                            <i class="fas fa-check me-2"></i>Process Return
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="clearReturn()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let returnData = null;

    let returnFetchTimeout;
    function fetchReturnInfo() {
        clearTimeout(returnFetchTimeout);
        returnFetchTimeout = setTimeout(async () => {
            const accNo = document.getElementById('returnAccessionInput').value.trim();
            const alertDiv = document.getElementById('scanAlert');
            const detailsCard = document.getElementById('returnDetailsCard');

            if (!accNo) {
                alertDiv.classList.add('d-none');
                detailsCard.classList.add('d-none');
                return;
            }

            const resp = await fetch(`/Library/Issue/GetReturnInfo?accessionNo=${encodeURIComponent(accNo)}`);
            const result = await resp.json();

            alertDiv.classList.remove('d-none');

            if (result.success) {
                returnData = result.data;
                alertDiv.innerHTML = `<div class="alert alert-success py-2 mb-0"><i class="fas fa-check-circle me-2"></i>Issue found. Fill return details below.</div>`;

                // Populate form
                document.getElementById('returnAccessionHidden').value = accNo;
                document.getElementById('returnIssueId').value = returnData.issueId;
                document.getElementById('returnMemberName').textContent = returnData.memberName;
                document.getElementById('returnBookTitle').textContent = returnData.bookTitle;
                document.getElementById('returnBookAuthor').textContent = returnData.author;
                document.getElementById('returnIssueDate').textContent = formatDate(returnData.issueDate);
                document.getElementById('returnDueDate').textContent = formatDate(returnData.dueDate);

                const overdueDays = returnData.overdueDays;
                const overdueEl = document.getElementById('returnOverdueDays');
                if (overdueDays > 0) {
                    overdueEl.textContent = overdueDays + ' days';
                    overdueEl.className = 'fw-bold text-danger';
                } else {
                    overdueEl.textContent = 'None';
                    overdueEl.className = 'fw-bold text-success';
                }

                document.getElementById('calculatedFineDisplay').value = returnData.calculatedFine.toFixed(2);
                detailsCard.classList.remove('d-none');
            } else {
                alertDiv.innerHTML = `<div class="alert alert-warning py-2 mb-0"><i class="fas fa-exclamation-triangle me-2"></i>${result.message}</div>`;
                detailsCard.classList.add('d-none');
                returnData = null;
            }
        }, 500);
    }

    function updateFineDisplay() {
        if (!returnData) return;
        const condition = document.getElementById('conditionSelect').value;
        let fine = returnData.calculatedFine;

        // Note: actual fine calculation happens server-side
        // This is just a visual indicator
        if (condition === 'Damaged') {
            document.getElementById('calculatedFineDisplay').value = (fine + ' + Damage Fine').toString();
        } else if (condition === 'Lost') {
            document.getElementById('calculatedFineDisplay').value = (fine + ' + Lost Fine').toString();
        } else {
            document.getElementById('calculatedFineDisplay').value = fine.toFixed(2);
        }
    }

    function clearReturn() {
        document.getElementById('returnAccessionInput').value = '';
        document.getElementById('scanAlert').classList.add('d-none');
        document.getElementById('returnDetailsCard').classList.add('d-none');
        returnData = null;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '-';
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-GB');
    }
</script>
}
