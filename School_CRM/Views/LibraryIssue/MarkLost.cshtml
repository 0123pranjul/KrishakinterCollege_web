@model School_CRM.Models.DTOs.MarkLostDto
@{
    ViewData["Title"] = "Mark Book as Lost";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-times-circle text-danger me-2"></i>Mark Book as Lost</h2>
            <small class="text-muted">Issue ID: #@Model.IssueId</small>
        </div>
        <a asp-action="Overdue" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Warning:</strong> Marking a book as lost will:
                <ul class="mb-0 mt-1">
                    <li>Apply a lost book fine to the member</li>
                    <li>Block the member's library account</li>
                    <li>Reduce the total copy count permanently</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form asp-action="MarkLost" asp-route-issueId="@Model.IssueId" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="IssueId" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="LostDate" class="form-label fw-semibold">Lost Date</label>
                            <input asp-for="LostDate" type="date" class="form-control" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-semibold">
                                Remarks <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"
                                      placeholder="Reason for marking as lost..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4"
                                    onclick="return confirm('Are you sure you want to mark this book as lost? This action cannot be undone.')">
                                <i class="fas fa-times me-2"></i>Mark as Lost
                            </button>
                            <a asp-action="Overdue" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
