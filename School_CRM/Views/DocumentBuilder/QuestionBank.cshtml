@model School_CRM.Models.ViewModels.QuestionBankVM

@{
    ViewData["Title"] = "Question Bank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0 text-gray-800">Question Bank</h3>
            <p class="text-muted mb-0">Manage reusable questions for the Document Builder</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "DocumentBuilder")" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to Builder
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#questionModal" onclick="openAddModal()">
                <i class="fas fa-plus"></i> Add New Question
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-3">
                    <label class="visually-hidden" for="filterType">Type</label>
                    <select class="form-select" id="filterType" name="filterType">
                        <option value="">All Types</option>
                        <option value="question" selected="@(Model.FilterType == "question")">Standard Question</option>
                        <option value="mcq" selected="@(Model.FilterType == "mcq")">Multiple Choice</option>
                        <option value="trueFalse" selected="@(Model.FilterType == "trueFalse")">True / False</option>
                        <option value="fillBlanks" selected="@(Model.FilterType == "fillBlanks")">Fill in Blanks</option>
                        <option value="matchFollowing" selected="@(Model.FilterType == "matchFollowing")">Match Following</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="visually-hidden" for="classId">Class</label>
                    <select class="form-select" id="classId" name="classId">
                        <option value="">All Classes</option>
                        @foreach(var c in Model.Classes)
                        {
                            <option value="@c.Id" selected="@(Model.FilterClassId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="visually-hidden" for="subjectId">Subject</label>
                    <select class="form-select" id="subjectId" name="subjectId">
                        <option value="">All Subjects</option>
                        @foreach(var s in Model.Subjects)
                        {
                            <option value="@s.Id" selected="@(Model.FilterSubjectId == s.Id)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a href="@Url.Action("QuestionBank")" class="btn btn-light">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Type</th>
                            <th scope="col">Class</th>
                            <th scope="col">Subject</th>
                            <th scope="col" style="width: 30%">Question Text</th>
                            <th scope="col">Marks</th>
                            <th scope="col">Source Document</th>
                            <th scope="col">Added On</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Questions.Any())
                        {
                            foreach (var q in Model.Questions)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-secondary">@q.QuestionType</span>
                                    </td>
                                    <td>@(q.ClassName ?? "-")</td>
                                    <td>@(q.SubjectName ?? "-")</td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;" title="@Html.Raw(System.Text.RegularExpressions.Regex.Replace(q.QuestionText, "<.*?>", String.Empty))">
                                            @Html.Raw(q.QuestionText)
                                        </div>
                                    </td>
                                    <td>@q.Marks</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="fas fa-file-alt text-muted me-1"></i> @q.DocumentName
                                        </span>
                                    </td>
                                    <td>@q.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteQuestion(@q.QuestionId)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-folder-open fa-3x mb-3"></i>
                                        <p class="mb-0">No questions found in the bank.</p>
                                        <small>Create questions in the Document Builder and save, or add them manually here.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Question Modal -->
<div class="modal fade" id="questionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="questionForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add New Question</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Question Type</label>
                            <select class="form-select" id="QuestionType" name="QuestionType" required>
                                <option value="question">Standard Question</option>
                                <option value="mcq">Multiple Choice</option>
                                <option value="trueFalse">True / False</option>
                                <option value="fillBlanks">Fill in Blanks</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Class</label>
                            <select class="form-select" id="AddClassId" name="AddClassId">
                                <option value="">Select Class</option>
                                @foreach(var c in Model.Classes)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Subject</label>
                            <select class="form-select" id="AddSubjectId" name="AddSubjectId">
                                <option value="">Select Subject</option>
                                @foreach(var s in Model.Subjects)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Marks</label>
                            <input type="number" step="0.5" class="form-control" id="Marks" name="Marks" value="1" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Space for Answer (px)</label>
                            <input type="number" class="form-control" id="AnswerSpace" name="AnswerSpace" value="50">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Question Text</label>
                            <textarea class="form-control" id="QuestionText" name="QuestionText" rows="4"></textarea>
                        </div>
                        
                        <!-- Dynamic Options Section for MCQ -->
                        <div class="col-12" id="mcqOptionsSection" style="display: none;">
                            <label class="form-label">Options (for Multiple Choice)</label>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">A</span>
                                        <input type="text" class="form-control mcq-option" data-id="A" placeholder="Option A text">
                                    </div>
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">C</span>
                                        <input type="text" class="form-control mcq-option" data-id="C" placeholder="Option C text">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">B</span>
                                        <input type="text" class="form-control mcq-option" data-id="B" placeholder="Option B text">
                                    </div>
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">D</span>
                                        <input type="text" class="form-control mcq-option" data-id="D" placeholder="Option D text">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveQuestion">Save to Bank</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        let editorInstance;

        // Initialize CKEditor
        ClassicEditor
            .create(document.querySelector('#QuestionText'))
            .then(editor => {
                editorInstance = editor;
            })
            .catch(error => {
                console.error(error);
            });

        // Show/Hide MCQ options based on question type
        document.getElementById('QuestionType').addEventListener('change', function() {
            const mcqSection = document.getElementById('mcqOptionsSection');
            if (this.value === 'mcq') {
                mcqSection.style.display = 'block';
            } else {
                mcqSection.style.display = 'none';
            }
        });

        function openAddModal() {
            document.getElementById('questionForm').reset();
            if (editorInstance) {
                editorInstance.setData('');
            }
            document.getElementById('mcqOptionsSection').style.display = 'none';
        }

        document.getElementById('questionForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveQuestion');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';

            // Extract question text from CKEditor
            let qText = editorInstance ? editorInstance.getData() : document.getElementById('QuestionText').value;
            
            // Build Options JSON if MCQ
            let optionsJson = null;
            if (document.getElementById('QuestionType').value === 'mcq') {
                const opts = [];
                document.querySelectorAll('.mcq-option').forEach(input => {
                    if (input.value.trim() !== '') {
                        opts.push({ id: input.getAttribute('data-id'), text: input.value.trim() });
                    }
                });
                optionsJson = opts.length > 0 ? JSON.stringify(opts) : null;
            }

            const payload = {
                QuestionType: document.getElementById('QuestionType').value,
                Marks: parseFloat(document.getElementById('Marks').value) || 1,
                AnswerSpace: parseInt(document.getElementById('AnswerSpace').value) || 50,
                QuestionText: qText,
                OptionsJson: optionsJson,
                ClassId: parseInt(document.getElementById('AddClassId').value) || null,
                SubjectId: parseInt(document.getElementById('AddSubjectId').value) || null
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('@Url.Action("SaveQuestionApi", "DocumentBuilder")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                if(res.success) {
                    Swal.fire('Saved!', 'Question added to bank.', 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', res.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = 'Save to Bank';
                }
            })
            .catch(err => {
                Swal.fire('Error', 'Network error occurred.', 'error');
                btn.disabled = false;
                btn.innerHTML = 'Save to Bank';
            });
        });

        function deleteQuestion(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This question will be removed from the bank.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const formData = new FormData();
                    formData.append('id', id);

                    fetch('@Url.Action("DeleteQuestionApi", "DocumentBuilder")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    })
                    .then(r => r.json())
                    .then(res => {
                        if(res.success) {
                            Swal.fire('Deleted!', 'Question removed.', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}
