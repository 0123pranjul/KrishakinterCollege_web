<!-- Import Question Modal -->
<div class="modal fade" id="importQuestionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-cloud-download"></i> Import from Question Bank</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Filter bar -->
                <div class="bg-light p-3 border-bottom d-flex gap-2 align-items-center">
                    <select class="form-select form-select-sm w-auto" id="importFilterType" onchange="loadImportQuestions()">
                        <option value="">All Types</option>
                        <option value="question">Standard Question</option>
                        <option value="mcq">Multiple Choice</option>
                        <option value="trueFalse">True / False</option>
                        <option value="fillBlanks">Fill in Blanks</option>
                    </select>
                    <select class="form-select form-select-sm w-auto" id="importClassId" onchange="loadImportQuestions()">
                        <option value="">All Classes</option>
                        @foreach(var c in Model.Classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <select class="form-select form-select-sm w-auto" id="importSubjectId" onchange="loadImportQuestions()">
                        <option value="">All Subjects</option>
                        @foreach(var s in Model.Subjects)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    <span class="text-muted small ms-auto" id="importQuestionCount">0 questions found</span>
                </div>
                <!-- Question List -->
                <div class="list-group list-group-flush" id="importQuestionList">
                    <div class="p-4 text-center text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div> Loading questions...
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <span class="text-muted small me-auto"><span id="selectedImportCount">0</span> selected</span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="insertImportedQuestions()" id="btnInsertQuestions" disabled>
                    <i class="bi bi-plus-circle"></i> Insert Selected
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Global inline helpers invoked by the modals ──

        // Toggle header/footer text inputs based on switch
        document.getElementById('settingHeaderToggle').addEventListener('change', function () {
            document.getElementById('settingHeaderText').disabled = !this.checked;
        });
        document.getElementById('settingFooterToggle').addEventListener('change', function () {
            document.getElementById('settingFooterText').disabled = !this.checked;
        });
        // Watermark opacity readout
        document.getElementById('settingWatermarkOpacity').addEventListener('input', function () {
            document.getElementById('watermarkOpacityValue').textContent = this.value + '%';
        });
        // Image drop zone click
        document.getElementById('imageDropZone').addEventListener('click', function () {
            document.getElementById('imageFileInput').click();
        });
        // Image file preview
        document.getElementById('imageFileInput').addEventListener('change', function () {
            if (this.files && this.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewArea').style.display = 'block';
                    document.getElementById('imageDropZone').style.display = 'none';
                    document.getElementById('btnUploadImage').disabled = false;
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
        function clearImagePreview() {
            document.getElementById('imagePreview').src = '';
            document.getElementById('imagePreviewArea').style.display = 'none';
            document.getElementById('imageDropZone').style.display = '';
            document.getElementById('imageFileInput').value = '';
            document.getElementById('btnUploadImage').disabled = true;
        }

        // Color hex readouts
        document.querySelectorAll('.prop-color').forEach(function (el) {
            el.addEventListener('input', function () {
                var hex = this.parentElement.querySelector('.prop-color-hex');
                if (hex) hex.textContent = this.value;
            });
        });
    </script>
    <script src="~/js/document-builder.js" asp-append-version="true"></script>
}
