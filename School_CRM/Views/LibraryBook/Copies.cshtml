@model List<School_CRM.Models.LibBookCopy>
@{
    ViewData["Title"] = "Book Copies & QR Codes";
    var book = ViewBag.Book as School_CRM.Models.LibBook;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-qrcode text-primary me-2"></i>Book Copies & QR Codes</h2>
            @if (book != null)
            {
                <small class="text-muted">@book.Title — @book.Author</small>
            }
        </div>
        <div class="d-flex gap-2">
            @if (book != null)
            {
                <a asp-action="AddCopies" asp-route-id="@book.BookId" class="btn btn-success">
                    <i class="fas fa-plus me-1"></i>Add More Copies
                </a>
                <button onclick="printAllQR()" class="btn btn-outline-primary">
                    <i class="fas fa-print me-1"></i>Print All QR
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- Book Summary -->
    @if (book != null)
    {
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-body py-3">
                <div class="row">
                    <div class="col-md-3"><strong>Total Copies:</strong> @book.TotalCopies</div>
                    <div class="col-md-3"><strong>Available:</strong> <span class="text-success fw-bold">@book.AvailableCopies</span></div>
                    <div class="col-md-3"><strong>Issued:</strong> <span class="text-warning fw-bold">@(book.TotalCopies - book.AvailableCopies)</span></div>
                    <div class="col-md-3"><strong>Price:</strong> ₹@book.BookPrice.ToString("F2")</div>
                </div>
            </div>
        </div>
    }

    <!-- Copies Grid -->
    <div class="row g-3" id="copiesGrid">
        @foreach (var copy in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 @(!copy.IsAvailable ? "border-start border-warning border-3" : "")">
                    <div class="card-body text-center">
                        <!-- QR Code Image -->
                        @if (!string.IsNullOrEmpty(copy.QrcodeImagePath))
                        {
                            <img src="@copy.QrcodeImagePath" alt="QR Code" class="img-fluid mb-2" style="max-width: 120px;"
                                 id="qr-@copy.CopyId" />
                        }
                        else
                        {
                            <div class="bg-light rounded p-3 mb-2 d-inline-block">
                                <i class="fas fa-qrcode fa-3x text-muted"></i>
                            </div>
                        }

                        <div class="fw-bold">@copy.AccessionNo</div>
                        <div class="mb-2">
                            <span class="badge @(copy.CopyCondition == "Good" ? "bg-success" : copy.CopyCondition == "Damaged" ? "bg-warning text-dark" : "bg-danger")">
                                @copy.CopyCondition
                            </span>
                            <span class="badge @(copy.IsAvailable ? "bg-success" : "bg-secondary") ms-1">
                                @(copy.IsAvailable ? "Available" : "Issued")
                            </span>
                        </div>
                        <div class="text-muted small mb-3">
                            Acquired: @copy.AcquisitionDate.ToString("dd/MM/yyyy")<br />
                            Price: ₹@copy.CopyPrice.ToString("F2")
                        </div>

                        <div class="d-flex gap-1 justify-content-center">
                            <a href="/Library/Book/QRCode/@copy.AccessionNo" target="_blank"
                               class="btn btn-sm btn-outline-primary" title="View QR">
                                <i class="fas fa-eye"></i>
                            </a>
                            <button onclick="printQR('@copy.AccessionNo', '@copy.QrcodeImagePath')"
                                    class="btn btn-sm btn-outline-secondary" title="Print QR">
                                <i class="fas fa-print"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-qrcode fa-3x mb-3 opacity-25"></i>
            <p>No copies found. <a asp-action="AddCopies" asp-route-id="@book?.BookId">Add copies</a></p>
        </div>
    }
</div>

<!-- Print Area (hidden) -->
<div id="printArea" style="display:none;"></div>

@section Scripts {
<script>
    function printQR(accessionNo, imagePath) {
        const printContent = `
            <html><head><title>QR Code - ${accessionNo}</title>
            <style>
                body { font-family: Arial; text-align: center; padding: 20px; }
                img { max-width: 200px; }
                .label { font-size: 14px; font-weight: bold; margin-top: 10px; }
                .sub { font-size: 11px; color: #666; }
            </style></head>
            <body>
                <img src="${imagePath}" alt="QR Code" />
                <div class="label">${accessionNo}</div>
                <div class="sub">@(book?.Title ?? "Library Book")</div>
                <div class="sub">Scan to view book info</div>
            </body></html>`;

        const win = window.open('', '_blank');
        win.document.write(printContent);
        win.document.close();
        win.print();
    }

    function printAllQR() {
        const copies = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Select(c => new { c.AccessionNo, c.QrcodeImagePath }).ToList()));

        let content = `<html><head><title>All QR Codes</title>
            <style>
                body { font-family: Arial; }
                .qr-item { display: inline-block; text-align: center; margin: 10px; padding: 10px; border: 1px solid #ddd; }
                img { max-width: 120px; }
                .label { font-size: 11px; font-weight: bold; }
            </style></head><body>`;

        copies.forEach(c => {
            if (c.qrcodeImagePath) {
                content += `<div class="qr-item">
                    <img src="${c.qrcodeImagePath}" /><br/>
                    <div class="label">${c.accessionNo}</div>
                </div>`;
            }
        });

        content += '</body></html>';
        const win = window.open('', '_blank');
        win.document.write(content);
        win.document.close();
        win.print();
    }
</script>
}
