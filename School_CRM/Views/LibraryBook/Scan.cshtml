@model School_CRM.Models.DTOs.BookScanInfoDto
@{
    ViewData["Title"] = "Book Info";
    Layout = null; // Standalone page for QR scan
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Info - @Model.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light">
    <div class="container py-4" style="max-width: 480px;">
        <div class="card border-0 shadow">
            <div class="card-header bg-primary text-white text-center py-3">
                <i class="fas fa-book fa-2x mb-1 d-block"></i>
                <h5 class="mb-0">Library Book Info</h5>
            </div>
            <div class="card-body">
                <h5 class="fw-bold mb-1">@Model.Title</h5>
                <p class="text-muted mb-3">by @Model.Author</p>

                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="text-muted fw-semibold" style="width:40%">Accession No.</td>
                        <td><code>@Model.AccessionNo</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Category</td>
                        <td>@Model.CategoryName</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Publisher))
                    {
                        <tr>
                            <td class="text-muted fw-semibold">Publisher</td>
                            <td>@Model.Publisher</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShelfLocation))
                    {
                        <tr>
                            <td class="text-muted fw-semibold">Shelf Location</td>
                            <td><span class="badge bg-secondary">@Model.ShelfLocation</span></td>
                        </tr>
                    }
                    <tr>
                        <td class="text-muted fw-semibold">Condition</td>
                        <td>
                            <span class="badge @(Model.CopyCondition == "Good" ? "bg-success" : Model.CopyCondition == "Damaged" ? "bg-warning text-dark" : "bg-danger")">
                                @Model.CopyCondition
                            </span>
                        </td>
                    </tr>
                </table>

                <hr />

                @if (Model.IsAvailable)
                {
                    <div class="alert alert-success text-center mb-0">
                        <i class="fas fa-check-circle fa-2x mb-1 d-block"></i>
                        <strong>Available</strong><br />
                        <small>This book is available for issue</small>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center mb-0">
                        <i class="fas fa-clock fa-2x mb-1 d-block"></i>
                        <strong>Currently Issued</strong><br />
                        @if (Model.DueDate.HasValue)
                        {
                            <small>Due: @Model.DueDate.Value.ToString("dd/MM/yyyy")</small>
                        }
                    </div>
                }
            </div>
            <div class="card-footer text-center text-muted small py-2">
                School Library Management System
            </div>
        </div>
    </div>
</body>
</html>
