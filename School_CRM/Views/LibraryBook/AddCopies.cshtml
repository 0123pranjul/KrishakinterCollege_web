@model School_CRM.Models.DTOs.AddCopiesDto
@{
    ViewData["Title"] = "Add More Copies";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-plus-circle text-success me-2"></i>Add More Copies</h2>
            <small class="text-muted">@Model.BookTitle</small>
        </div>
        <a asp-action="Copies" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Copies
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0">Copy Details</h6>
                </div>
                <div class="card-body">
                    <form asp-action="AddCopies" asp-route-id="@Model.BookId" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="BookId" type="hidden" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Book</label>
                            <input type="text" class="form-control" value="@Model.BookTitle" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NumberOfCopies" class="form-label fw-semibold">
                                Number of Copies <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NumberOfCopies" type="number" class="form-control" min="1" max="100" />
                            <span asp-validation-for="NumberOfCopies" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AcquisitionDate" class="form-label fw-semibold">Acquisition Date</label>
                            <input asp-for="AcquisitionDate" type="date" class="form-control" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="CopyPrice" class="form-label fw-semibold">
                                Copy Price (₹) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="CopyPrice" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="CopyPrice" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-info small">
                            <i class="fas fa-info-circle me-2"></i>
                            QR codes will be automatically generated for each new copy.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-plus me-2"></i>Add Copies
                            </button>
                            <a asp-action="Copies" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
