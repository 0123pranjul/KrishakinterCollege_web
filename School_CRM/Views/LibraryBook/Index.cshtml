@model List<School_CRM.Models.DTOs.BookListItemDto>
@{
    ViewData["Title"] = "Book Catalog";
    int totalCount  = ViewBag.TotalCount;
    int currentPage = ViewBag.CurrentPage;
    int totalPages  = ViewBag.TotalPages;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-books text-primary me-2"></i>Book Catalog</h2>
            <small class="text-muted">@totalCount books found</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Add Book
            </a>
            <a asp-controller="LibraryCategory" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-tags me-1"></i>Categories
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- Search / Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Search</label>
                    <input type="text" name="SearchText" value="@Context.Request.Query["SearchText"]"
                           class="form-control" placeholder="Title, Author, ISBN, Publisher..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" name="OnlyAvailable" value="true"
                               @(Context.Request.Query["OnlyAvailable"] == "true" ? "checked" : "") id="onlyAvail" />
                        <label class="form-check-label" for="onlyAvail">Available Only</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-search me-1"></i>Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Book Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Title / Author</th>
                            <th>ISBN</th>
                            <th>Category</th>
                            <th>Shelf</th>
                            <th>Copies</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    <i class="fas fa-book fa-3x mb-3 d-block opacity-25"></i>
                                    No books found. <a asp-action="Create">Add the first book</a>
                                </td>
                            </tr>
                        }
                        @{int sno = (currentPage - 1) * (int)ViewBag.PageSize + 1;}
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td class="text-muted">@sno++</td>
                                <td>
                                    <div class="fw-semibold">@book.Title</div>
                                    <small class="text-muted">@book.Author</small>
                                </td>
                                <td><code class="small">@(book.ISBN ?? "-")</code></td>
                                <td><span class="badge bg-light text-dark border">@book.CategoryName</span></td>
                                <td class="text-muted small">@(book.ShelfLocation ?? "-")</td>
                                <td>
                                    <span class="@(book.AvailableCopies == 0 ? "text-danger fw-bold" : "text-success fw-bold")">
                                        @book.AvailableCopies
                                    </span>
                                    <span class="text-muted">/ @book.TotalCopies</span>
                                </td>
                                <td>₹@book.BookPrice.ToString("F2")</td>
                                <td>
                                    @if (book.AvailableCopies == 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (!book.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Copies" asp-route-id="@book.BookId" class="btn btn-outline-secondary" title="Copies & QR">
                                            <i class="fas fa-qrcode"></i>
                                        </a>
                                        <a asp-action="AddCopies" asp-route-id="@book.BookId" class="btn btn-outline-success" title="Add Copies">
                                            <i class="fas fa-plus"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">Showing page @currentPage of @totalPages (@totalCount total)</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@(currentPage - 1)"
                                   asp-route-SearchText="@Context.Request.Query["SearchText"]"
                                   asp-route-CategoryId="@Context.Request.Query["CategoryId"]">«</a>
                            </li>
                        }
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@p"
                                   asp-route-SearchText="@Context.Request.Query["SearchText"]"
                                   asp-route-CategoryId="@Context.Request.Query["CategoryId"]">@p</a>
                            </li>
                        }
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@(currentPage + 1)"
                                   asp-route-SearchText="@Context.Request.Query["SearchText"]"
                                   asp-route-CategoryId="@Context.Request.Query["CategoryId"]">»</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
