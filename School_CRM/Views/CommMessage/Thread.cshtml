@model List<School_CRM.Models.CommMessage>
@{
    ViewData["Title"] = "Chat";
    var thread    = ViewBag.Thread    as School_CRM.Models.CommMessageThread;
    string myType = ViewBag.MyType   ?? "";
    int    myId   = ViewBag.MyId;
    string myName = ViewBag.MyName   ?? "Me";
    string otherName = ViewBag.OtherName ?? "User";
    string otherType = ViewBag.OtherType ?? "";
    var lastId    = Model.Any() ? Model.Max(m => m.MessageId) : 0;
}

<style>
    /* ── Layout ── */
    .chat-page     { display:flex; flex-direction:column; height:calc(100vh - 58px);
                     max-width:780px; margin:0 auto; }
    /* ── Header ── */
    .chat-header   { display:flex; align-items:center; gap:12px; padding:10px 16px;
                     background:#fff; border-bottom:1px solid #e8e8e8;
                     box-shadow:0 1px 3px rgba(0,0,0,.06); flex-shrink:0; }
    .chat-avatar   { width:40px; height:40px; border-radius:50%; display:flex;
                     align-items:center; justify-content:center;
                     font-weight:700; color:#fff; font-size:.95rem; flex-shrink:0; }
    .av-Teacher    { background:linear-gradient(135deg,#4f8ef7,#6a5af9); }
    .av-Student    { background:linear-gradient(135deg,#43c6ac,#191654); }
    .av-Admin      { background:linear-gradient(135deg,#f7971e,#ffd200); }
    .chat-hname    { font-weight:600; font-size:.95rem; line-height:1.2; }
    .chat-hsub     { font-size:.78rem; color:#888; }
    /* ── Messages area ── */
    .chat-body     { flex:1; overflow-y:auto; padding:16px 12px;
                     background:#e5ddd5 url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d0ccc4' fill-opacity='0.25'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E"); }
    /* ── Bubble wrapper ── */
    .msg-row       { display:flex; margin-bottom:6px; }
    .msg-row.mine  { justify-content:flex-end; }
    .msg-row.theirs{ justify-content:flex-start; }
    /* ── Bubble ── */
    .bubble        { max-width:72%; padding:8px 12px 6px; border-radius:12px;
                     font-size:.88rem; line-height:1.45; position:relative;
                     word-break:break-word; box-shadow:0 1px 2px rgba(0,0,0,.1); }
    .bubble.mine   { background:#dcf8c6; border-bottom-right-radius:3px; }
    .bubble.theirs { background:#fff;    border-bottom-left-radius:3px; }
    .bubble-time   { font-size:.68rem; color:#999; text-align:right; margin-top:2px;
                     display:flex; justify-content:flex-end; align-items:center; gap:3px; }
    /* Green double tick */
    .tick          { font-size:.75rem; }
    .tick.read     { color:#53bdeb; }
    .tick.sent     { color:#aaa; }
    /* Date divider */
    .date-divider  { text-align:center; margin:12px 0; }
    .date-divider span { background:rgba(255,255,255,.75); padding:3px 12px;
                         border-radius:20px; font-size:.75rem; color:#777; }
    /* Attachment previews */
    .att-img       { max-width:220px; max-height:200px; border-radius:8px;
                     cursor:pointer; display:block; margin-bottom:4px; }
    .att-doc       { display:inline-flex; align-items:center; gap:6px; padding:6px 10px;
                     background:rgba(0,0,0,.06); border-radius:8px; font-size:.82rem;
                     text-decoration:none; color:inherit; margin-bottom:4px; }
    /* ── Input bar ── */
    .chat-footer   { background:#f0f0f0; border-top:1px solid #ddd;
                     padding:8px 12px; flex-shrink:0; }
    .chat-form     { display:flex; align-items:flex-end; gap:8px; }
    .attach-btn    { background:none; border:none; color:#54656f; padding:8px;
                     font-size:1.1rem; cursor:pointer; border-radius:50%;
                     transition:background .15s; flex-shrink:0; }
    .attach-btn:hover { background:#e0e0e0; }
    .msg-input     { flex:1; resize:none; border:none; border-radius:20px;
                     padding:9px 16px; font-size:.9rem; outline:none;
                     background:#fff; max-height:120px; overflow-y:auto;
                     box-shadow:0 1px 2px rgba(0,0,0,.08); }
    .send-btn      { width:42px; height:42px; border-radius:50%; border:none;
                     background:#25d366; color:#fff; font-size:1rem; cursor:pointer;
                     display:flex; align-items:center; justify-content:center;
                     flex-shrink:0; transition:background .15s; }
    .send-btn:hover{ background:#1da851; }
    .attach-preview{ display:none; background:#fff; border-radius:12px;
                     padding:8px 12px; margin-bottom:6px; font-size:.83rem;
                     align-items:center; gap:8px; }
    .attach-preview.show { display:flex; }
    /* Sending spinner overlay */
    .sending-dot   { display:none; font-size:.75rem; color:#aaa; padding:2px 8px; }
</style>

<div class="chat-page">

    <!-- Header -->
    <div class="chat-header">
        <a href="/Communication/Messages" class="text-muted me-1" style="font-size:1.1rem">
            <i class="fas fa-arrow-left"></i>
        </a>
        @{
            var initials = string.Join("", otherName.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
        }
        <div class="chat-avatar av-@otherType">@initials</div>
        <div>
            <div class="chat-hname">@otherName</div>
            <div class="chat-hsub">@otherType &nbsp;·&nbsp; @(thread?.Subject ?? "Direct message")</div>
        </div>
    </div>

    <!-- Messages -->
    <div class="chat-body" id="chatBody">
        @{
            string? lastDate = null;
        }
        @foreach (var msg in Model)
        {
            bool isMine   = msg.SenderType == myType && msg.SenderId == myId;
            string dateStr = msg.SentAt.ToString("dd MMM yyyy");
            string ext     = System.IO.Path.GetExtension(msg.AttachmentPath ?? "").ToLower();
            bool isImage   = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
            bool isPdf     = ext == ".pdf";

            if (dateStr != lastDate)
            {
                lastDate = dateStr;
                <div class="date-divider"><span>@dateStr</span></div>
            }

            <div class="msg-row @(isMine ? "mine" : "theirs")" data-id="@msg.MessageId">
                <div class="bubble @(isMine ? "mine" : "theirs")">
                    @if (!string.IsNullOrEmpty(msg.AttachmentPath))
                    {
                        if (isImage)
                        {
                            <a href="@msg.AttachmentPath" target="_blank">
                                <img src="@msg.AttachmentPath" class="att-img" alt="image" />
                            </a>
                        }
                        else
                        {
                            <a href="@msg.AttachmentPath" target="_blank" class="att-doc">
                                <i class="fas @(isPdf ? "fa-file-pdf text-danger" : "fa-file-alt text-primary")"></i>
                                @System.IO.Path.GetFileName(msg.AttachmentPath)
                            </a>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(msg.MessageBody))
                    {
                        <span>@msg.MessageBody</span>
                    }
                    <div class="bubble-time">
                        @msg.SentAt.ToString("hh:mm tt")
                        @if (isMine)
                        {
                            <span class="tick @(msg.IsRead ? "read" : "sent")">
                                <i class="fas fa-check-double"></i>
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
        <!-- New messages will be injected here by JS -->
    </div>

    <!-- Input bar -->
    <div class="chat-footer">
        <!-- Attachment preview strip -->
        <div class="attach-preview" id="attachPreview">
            <i class="fas fa-paperclip text-muted"></i>
            <span id="attachFileName">file.jpg</span>
            <button type="button" onclick="clearAttach()"
                    style="background:none;border:none;color:#999;margin-left:auto;cursor:pointer">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="chat-form">
            <!-- Hidden file input -->
            <input type="file" id="fileInput" style="display:none"
                   accept="image/*,.pdf,.doc,.docx,.xls,.xlsx"
                   onchange="onFileChosen(this)" />
            <button type="button" class="attach-btn" onclick="document.getElementById('fileInput').click()"
                    title="Attach image or document">
                <i class="fas fa-paperclip"></i>
            </button>

            <textarea id="msgInput" class="msg-input" rows="1"
                      placeholder="Type a message…"
                      onkeydown="handleEnter(event)"
                      oninput="autoGrow(this)"></textarea>

            <button type="button" class="send-btn" onclick="sendMessage()" title="Send">
                <i class="fas fa-paper-plane" id="sendIcon"></i>
            </button>
        </div>
        <div class="sending-dot" id="sendingDot">Sending…</div>
    </div>
</div>

@section Scripts {
<script>
    const THREAD_ID  = @(thread?.ThreadId ?? 0);
    const CSRF_TOKEN = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';
    let   lastMsgId  = @lastId;
    let   pollTimer;

    // ── Scroll to bottom ─────────────────────────────────────────────────
    function scrollBottom(smooth = false) {
        const b = document.getElementById('chatBody');
        b.scrollTo({ top: b.scrollHeight, behavior: smooth ? 'smooth' : 'instant' });
    }
    scrollBottom();

    // ── Auto-grow textarea ────────────────────────────────────────────────
    function autoGrow(el) {
        el.style.height = 'auto';
        el.style.height = Math.min(el.scrollHeight, 120) + 'px';
    }

    // ── Enter to send (Shift+Enter = newline) ─────────────────────────────
    function handleEnter(e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    }

    // ── File attachment ───────────────────────────────────────────────────
    function onFileChosen(input) {
        if (!input.files.length) return;
        const f = input.files[0];
        if (f.size > 5 * 1024 * 1024) {
            alert('File too large! Max 5 MB.');
            input.value = '';
            return;
        }
        document.getElementById('attachFileName').textContent = f.name;
        document.getElementById('attachPreview').classList.add('show');
    }
    function clearAttach() {
        document.getElementById('fileInput').value = '';
        document.getElementById('attachPreview').classList.remove('show');
    }

    // ── Build bubble HTML ─────────────────────────────────────────────────
    function buildBubble(msg) {
        let attachHtml = '';
        if (msg.attachPath) {
            if (msg.attachType === 'image') {
                attachHtml = `<a href="${msg.attachPath}" target="_blank">
                    <img src="${msg.attachPath}" class="att-img" alt="image"></a>`;
            } else {
                const icon = msg.attachType === 'pdf'
                    ? 'fa-file-pdf text-danger' : 'fa-file-alt text-primary';
                const fname = msg.attachPath.split('/').pop();
                attachHtml = `<a href="${msg.attachPath}" target="_blank" class="att-doc">
                    <i class="fas ${icon}"></i>${fname}</a>`;
            }
        }
        const bodyHtml = msg.messageBody
            ? `<span>${escHtml(msg.messageBody)}</span>` : '';
        const tickHtml = msg.isMine
            ? `<span class="tick ${msg.isRead ? 'read' : 'sent'}">
                   <i class="fas fa-check-double"></i></span>` : '';

        return `<div class="msg-row ${msg.isMine ? 'mine' : 'theirs'}" data-id="${msg.messageId}">
            <div class="bubble ${msg.isMine ? 'mine' : 'theirs'}">
                ${attachHtml}${bodyHtml}
                <div class="bubble-time">${msg.sentAt} ${tickHtml}</div>
            </div>
        </div>`;
    }

    function escHtml(t) {
        return t.replace(/&/g,'&amp;').replace(/</g,'&lt;')
                .replace(/>/g,'&gt;').replace(/\n/g,'<br>');
    }

    // ── Check if date divider needed ──────────────────────────────────────
    function maybeAddDateDivider(dateStr) {
        const body = document.getElementById('chatBody');
        const last = body.querySelector('.date-divider:last-of-type span');
        if (!last || last.textContent !== dateStr) {
            const div = document.createElement('div');
            div.className = 'date-divider';
            div.innerHTML = `<span>${dateStr}</span>`;
            body.appendChild(div);
        }
    }

    // ── SEND ──────────────────────────────────────────────────────────────
    async function sendMessage() {
        const input    = document.getElementById('msgInput');
        const fileEl   = document.getElementById('fileInput');
        const body     = input.value.trim();
        const hasFile  = fileEl.files.length > 0;

        if (!body && !hasFile) return;

        // Optimistic UI — show bubble immediately (mine)
        const nowStr = new Date().toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' });
        const tempId = 'temp-' + Date.now();
        const chatBody = document.getElementById('chatBody');
        const todayStr = new Date().toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
        maybeAddDateDivider(todayStr);

        const tempBubble = document.createElement('div');
        tempBubble.id        = tempId;
        tempBubble.className = 'msg-row mine';
        tempBubble.innerHTML = `<div class="bubble mine">
            ${body ? `<span>${escHtml(body)}</span>` : ''}
            <div class="bubble-time">${nowStr}
                <span class="tick sent"><i class="fas fa-clock"></i></span>
            </div></div>`;
        chatBody.appendChild(tempBubble);
        scrollBottom(true);

        // Clear inputs
        input.value = '';
        input.style.height = 'auto';

        // Prepare form data
        const fd = new FormData();
        fd.append('messageBody', body);
        if (hasFile) fd.append('attachment', fileEl.files[0]);
        fd.append('__RequestVerificationToken', CSRF_TOKEN);

        try {
            const res  = await fetch(`/Communication/Message/Send/${THREAD_ID}`, {
                method: 'POST', body: fd
            });
            const json = await res.json();

            // Remove temp bubble — real one will arrive via poll
            const el = document.getElementById(tempId);
            if (el) el.remove();
            clearAttach();

            if (!json.success) alert(json.message || 'Failed to send');
            else {
                lastMsgId = Math.max(lastMsgId, json.messageId);
                // Immediately add the real bubble
                maybeAddDateDivider(json.sentDate);
                const realBubble = document.createElement('div');
                realBubble.innerHTML = buildBubble({
                    messageId: json.messageId, isMine: true, isRead: false,
                    messageBody: body, attachPath: json.attachPath,
                    attachType: json.attachType, sentAt: json.sentAt
                });
                chatBody.appendChild(realBubble.firstElementChild);
                scrollBottom(true);
            }
        } catch (err) {
            const el = document.getElementById(tempId);
            if (el) el.querySelector('.bubble-time').innerHTML +=
                ' <i class="fas fa-exclamation-circle text-danger"></i>';
        }
    }

    // ── POLL for new messages ──────────────────────────────────────────────
    async function pollMessages() {
        try {
            const res  = await fetch(
                `/Communication/Message/Poll/${THREAD_ID}?lastId=${lastMsgId}`);
            const msgs = await res.json();
            if (!Array.isArray(msgs) || !msgs.length) return;

            const chatBody = document.getElementById('chatBody');
            const wasAtBottom = chatBody.scrollHeight - chatBody.clientHeight
                                - chatBody.scrollTop < 60;

            msgs.forEach(msg => {
                // Skip if already rendered (mine messages)
                if (document.querySelector(`[data-id="${msg.messageId}"]`)) return;
                lastMsgId = Math.max(lastMsgId, msg.messageId);

                maybeAddDateDivider(msg.sentDate);
                const el = document.createElement('div');
                el.innerHTML = buildBubble(msg);
                chatBody.appendChild(el.firstElementChild);
            });

            if (wasAtBottom) scrollBottom(true);
        } catch (_) { /* silent fail — will retry */ }
    }

    // Start polling every 3 seconds
    pollTimer = setInterval(pollMessages, 3000);

    // Stop polling when tab hidden, resume when visible
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearInterval(pollTimer);
        else { pollMessages(); pollTimer = setInterval(pollMessages, 3000); }
    });
</script>
}
