@model IEnumerable<School_CRM.Models.TblLessonPlan>
@{
    ViewData["Title"] = "Track Lesson Coverage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .coverage-header {
        background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%);
        color: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .coverage-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: #ffffff;
        transition: transform 0.2s;
        margin-bottom: 20px;
    }
    .coverage-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    .progress-custom {
        height: 12px;
        border-radius: 6px;
        background-color: #f1f5f9;
        margin-top: 10px;
        margin-bottom: 10px;
    }
    .card-title-plan {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
        font-size: 1.15rem;
    }
    .meta-info {
        font-size: 0.85rem;
        color: #64748b;
    }
    .history-item {
        font-size: 0.85rem;
        border-left: 2px solid #e2e8f0;
        padding-left: 10px;
        margin-bottom: 8px;
    }
</style>

<div class="container-fluid mt-4">
    <div class="coverage-header">
        <h4 class="mb-1 fw-bold"><i class="fas fa-tasks me-2"></i>Track Lesson Coverage</h4>
        <p class="mb-0 text-white-75">Log your daily progress against approved lesson plans.</p>
    </div>

    @if(!Model.Any()) {
        <div class="alert alert-info border-0 shadow-sm rounded-3">
            <i class="fas fa-info-circle me-2"></i> You don't have any approved lesson plans to track right now.
        </div>
    }

    <div class="row">
        @foreach (var plan in Model)
        {
            var latestCoverage = plan.TblLessonCoverages.OrderByDescending(c => c.DateCovered).FirstOrDefault();
            int currentPercentage = latestCoverage?.PercentageCompleted ?? 0;
            string progressColor = currentPercentage == 100 ? "bg-success" : (currentPercentage >= 50 ? "bg-info" : "bg-warning");

            <div class="col-md-6 col-lg-4">
                <div class="card coverage-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title-plan">@plan.PlanTitle</h5>
                                <div class="meta-info mb-2">
                                    <i class="fas fa-book me-1"></i> @plan.Subject?.SubjectName &nbsp;|&nbsp; 
                                    <i class="fas fa-users me-1"></i> @plan.Class?.ClassName
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border"><i class="far fa-calendar me-1"></i>@plan.StartDate.ToString("dd MMM")</span>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between meta-info">
                                <span>Progress</span>
                                <span class="fw-bold text-dark">@currentPercentage%</span>
                            </div>
                            <div class="progress progress-custom">
                                <div class="progress-bar @progressColor" role="progressbar" style="width: @currentPercentage%" aria-valuenow="@currentPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="mt-3 mb-4">
                            <h6 class="meta-info fw-bold text-uppercase mb-2">Recent Logs</h6>
                            @if (plan.TblLessonCoverages.Any())
                            {
                                foreach (var log in plan.TblLessonCoverages.OrderByDescending(c => c.DateCovered).Take(2))
                                {
                                    <div class="history-item">
                                        <strong>@log.DateCovered.ToString("dd MMM")</strong> - @log.PercentageCompleted%
                                        <div class="text-muted text-truncate" title="@log.TeacherNotes">@log.TeacherNotes</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small fst-italic">No logs added yet.</div>
                            }
                        </div>

                        <button class="btn btn-outline-primary w-100 rounded-pill btn-log" data-plan-id="@plan.Id" data-title="@plan.PlanTitle" data-current="@currentPercentage">
                            <i class="fas fa-plus me-1"></i> Update Progress
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Log Coverage -->
<div class="modal fade" id="coverageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold">Update Progress: <span id="lblPlanTitle" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnPlanId" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Date Covered <span class="text-danger">*</span></label>
                    <input type="date" id="txtDateCovered" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Total Percentage Completed <span class="text-danger">*</span></label>
                    <div class="d-flex align-items-center">
                        <input type="range" class="form-range flex-grow-1 me-3" id="rngPercentage" min="0" max="100" step="5">
                        <span class="badge bg-primary fs-6" style="width: 60px;" id="lblPercentage">0%</span>
                    </div>
                    <small class="text-muted">Slide to update overall completion status.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Teacher Notes / Remarks</label>
                    <textarea id="txtNotes" class="form-control" rows="3" placeholder="Any issues faced? Did students understand?"></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveCoverage">Save Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Set today
            let d = new Date();
            let today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            $('#txtDateCovered').val(today);

            // Update range label
            $('#rngPercentage').on('input', function() {
                $('#lblPercentage').text($(this).val() + '%');
            });

            $('.btn-log').click(function () {
                let planId = $(this).data('plan-id');
                let title = $(this).data('title');
                let current = $(this).data('current');

                $('#hdnPlanId').val(planId);
                $('#lblPlanTitle').text(title);
                $('#rngPercentage').val(current);
                $('#lblPercentage').text(current + '%');
                $('#txtNotes').val('');
                
                $('#coverageModal').modal('show');
            });

            $('#btnSaveCoverage').click(function () {
                let planId = $('#hdnPlanId').val();
                let dateCovered = $('#txtDateCovered').val();
                let percentage = $('#rngPercentage').val();
                let notes = $('#txtNotes').val().trim();

                if (!dateCovered) {
                    alert('Date is required');
                    return;
                }

                $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Saving...');

                $.post('/LessonCoverage/SaveCoverage', {
                    planId: planId,
                    dateCovered: dateCovered,
                    percentage: percentage,
                    notes: notes
                }, function (res) {
                    if (res.success) {
                        window.location.reload();
                    } else {
                        alert('Error: ' + res.message);
                        $('#btnSaveCoverage').prop('disabled', false).text('Save Update');
                    }
                });
            });
        });
    </script>
}
