@model School_CRM.Models.InvSaleTransaction
@{
    ViewData["Title"] = "Bill - " + Model.BillNumber;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bill @Model.BillNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { font-family: Arial, sans-serif; font-size: 13px; }
        .bill-header { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 10px; }
        @@media print { .no-print { display: none !important; } body { margin: 0; } }
    </style>
</head>
<body class="p-3" style="max-width:600px;margin:auto;">
    <div class="no-print d-flex gap-2 mb-3">
        <button onclick="window.print()" class="btn btn-primary btn-sm"><i class="fas fa-print me-1"></i>Print</button>
        <a href="/Store/Sale/Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>

    <div class="bill-header text-center">
        <h5 class="mb-0 fw-bold">SCHOOL STORE</h5>
        <div class="text-muted small">School Management System</div>
        <div class="fw-bold mt-1">@(Model.BillType == "Issue" ? "ISSUE SLIP" : "SALE BILL")</div>
    </div>

    <div class="row mb-2">
        <div class="col-6">
            <div><strong>Bill No:</strong> @Model.BillNumber</div>
            <div><strong>Date:</strong> @Model.SaleDate.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="col-6 text-end">
            <div><strong>Customer:</strong> @(Model.CustomerName ?? $"{Model.CustomerType} #{Model.CustomerId}")</div>
            <div><strong>Type:</strong> @Model.CustomerType</div>
        </div>
    </div>

    <table class="table table-sm table-bordered">
        <thead class="table-dark">
            <tr><th>#</th><th>Product</th><th>Qty</th><th>Price</th><th>Disc%</th><th>Total</th></tr>
        </thead>
        <tbody>
            @{ int sno = 1; }
            @foreach (var item in Model.InvSaleItems)
            {
                <tr>
                    <td>@sno++</td>
                    <td>@item.Product.ProductName</td>
                    <td>@item.Qty @item.Product.Unit.UnitShort</td>
                    <td>₹@item.UnitSellingPrice.ToString("F2")</td>
                    <td>@item.DiscountPercent%</td>
                    <td>₹@item.LineTotal.ToString("F2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td colspan="5" class="text-end">Sub Total</td><td>₹@Model.SubTotal.ToString("F2")</td></tr>
            @if (Model.DiscountAmount > 0) { <tr><td colspan="5" class="text-end">Discount</td><td>-₹@Model.DiscountAmount.ToString("F2")</td></tr> }
            @if (Model.Gstamount > 0)      { <tr><td colspan="5" class="text-end">GST</td><td>₹@Model.Gstamount.ToString("F2")</td></tr> }
            <tr class="table-success fw-bold"><td colspan="5" class="text-end">Grand Total</td><td>₹@Model.TotalAmount.ToString("F2")</td></tr>
            <tr><td colspan="5" class="text-end">Amount Paid</td><td>₹@Model.AmountPaid.ToString("F2")</td></tr>
            @if (!Model.IsPaid) { <tr class="table-danger"><td colspan="5" class="text-end">Balance Due</td><td>₹@(Model.BalanceDue?.ToString("F2"))</td></tr> }
        </tfoot>
    </table>

    <div class="d-flex justify-content-between">
        <div>
            <strong>Payment:</strong> @Model.PaymentMode
            @if (!Model.IsPaid && Model.DueDate.HasValue) { <span class="text-danger ms-2">Due: @Model.DueDate.Value.ToString("dd/MM/yyyy")</span> }
        </div>
        <div class="text-muted small">Thank you!</div>
    </div>
</body>
</html>
