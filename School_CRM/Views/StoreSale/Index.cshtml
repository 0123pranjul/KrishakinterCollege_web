@model List<School_CRM.Models.InvSaleTransaction>
@{
    ViewData["Title"] = "All Bills";
    int totalCount  = ViewBag.TotalCount ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages  = ViewBag.TotalPages  ?? 1;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-receipt text-primary me-2"></i>All Bills</h2>
            <small class="text-muted">@totalCount bills found</small>
        </div>
        <a asp-action="Create" class="btn btn-success"><i class="fas fa-cash-register me-1"></i>New Bill</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">From Date</label>
                    <input type="date" name="FromDate" class="form-control" value="@Context.Request.Query["FromDate"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">To Date</label>
                    <input type="date" name="ToDate" class="form-control" value="@Context.Request.Query["ToDate"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Customer Type</label>
                    <select name="CustomerType" class="form-select">
                        <option value="">All</option>
                        <option value="Student">Student</option>
                        <option value="Teacher">Teacher</option>
                        <option value="Staff">Staff</option>
                        <option value="Walk-in">Walk-in</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Payment Mode</label>
                    <select name="PaymentMode" class="form-select">
                        <option value="">All</option>
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI</option>
                        <option value="Online">Online</option>
                        <option value="Credit">Credit</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Bill Type</label>
                    <select name="BillType" class="form-select">
                        <option value="">All</option>
                        <option value="Sale">Sale</option>
                        <option value="Issue">Issue</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Bill No.</th><th>Type</th><th>Customer</th><th>Date</th><th>Payment</th><th class="text-end">Amount</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No bills found.</td></tr> }
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td><code class="fw-semibold">@s.BillNumber</code></td>
                                <td><span class="badge @(s.BillType == "Sale" ? "bg-success" : "bg-info text-dark")">@s.BillType</span></td>
                                <td>
                                    <div>@(s.CustomerName ?? $"{s.CustomerType} #{s.CustomerId}")</div>
                                    <small class="text-muted">@s.CustomerType</small>
                                </td>
                                <td>@s.SaleDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@s.PaymentMode</span></td>
                                <td class="text-end fw-semibold">₹@s.TotalAmount.ToString("F2")</td>
                                <td><span class="badge @(s.IsPaid ? "bg-success" : "bg-danger")">@(s.IsPaid ? "Paid" : "Pending")</span></td>
                                <td>
                                    <a asp-action="Bill" asp-route-id="@s.SaleId" class="btn btn-sm btn-outline-secondary" target="_blank" title="Print"><i class="fas fa-print"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">Page @currentPage of @totalPages</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (currentPage > 1) { <li class="page-item"><a class="page-link" asp-action="Index" asp-route-PageNumber="@(currentPage-1)">«</a></li> }
                        @if (currentPage < totalPages) { <li class="page-item"><a class="page-link" asp-action="Index" asp-route-PageNumber="@(currentPage+1)">»</a></li> }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
