@model School_CRM.Models.DTOs.InvSaleDto
@{ ViewData["Title"] = "New Bill"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-cash-register text-success me-2"></i>New Bill</h2>
            <small class="text-muted">Sale or Issue to student / staff</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-list me-1"></i>All Bills</a>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <form asp-action="Create" method="post" id="saleForm">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Bill Header -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-user me-2 text-primary"></i>Bill Details</h6>
                    </div>
                    <div class="card-body">
                        <!-- Bill Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Bill Type</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="BillType" value="Sale" id="typeSale" checked />
                                    <label class="form-check-label" for="typeSale">💰 Sale (Paid)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="BillType" value="Issue" id="typeIssue" />
                                    <label class="form-check-label" for="typeIssue">🆓 Issue (Free)</label>
                                </div>
                            </div>
                        </div>

                        <!-- Customer Type -->
                        <div class="mb-3">
                            <label asp-for="CustomerType" class="form-label fw-semibold">Customer Type</label>
                            <select asp-for="CustomerType" class="form-select" id="customerTypeSelect" onchange="loadCustomers()">
                                <option value="Student">Student</option>
                                <option value="Teacher">Teacher</option>
                                <option value="Staff">Staff</option>
                                <option value="Walk-in">Walk-in</option>
                            </select>
                        </div>

                        <!-- Customer Search -->
                        <div class="mb-3" id="customerSearchRow">
                            <label class="form-label fw-semibold">Search Customer</label>
                            <input type="text" id="customerSearch" class="form-control" placeholder="Type name..." oninput="searchCustomers()" />
                        </div>

                        <div class="mb-3" id="customerSelectRow">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Select Customer</label>
                            <select asp-for="CustomerId" class="form-select" id="customerSelect" onchange="setCustomerName()">
                                <option value="">Select...</option>
                            </select>
                        </div>

                        <div class="mb-3" id="walkInRow" style="display:none">
                            <label asp-for="CustomerName" class="form-label fw-semibold">Customer Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />
                        </div>

                        <!-- Payment -->
                        <div class="mb-3">
                            <label asp-for="PaymentMode" class="form-label fw-semibold">Payment Mode</label>
                            <select asp-for="PaymentMode" class="form-select" id="paymentModeSelect">
                                <option value="Cash">Cash</option>
                                <option value="UPI">UPI</option>
                                <option value="Online">Online</option>
                                <option value="Credit">Credit (Pay Later)</option>
                                <option value="Free">Free</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SaleDate" class="form-label fw-semibold">Date</label>
                            <input asp-for="SaleDate" type="date" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-list me-2 text-success"></i>Items</h6>
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="addItemRow()">
                            <i class="fas fa-plus me-1"></i>Add Item
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0" id="itemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:35%">Product</th>
                                        <th style="width:10%">Stock</th>
                                        <th style="width:10%">Qty</th>
                                        <th style="width:15%">Price</th>
                                        <th style="width:10%">Disc%</th>
                                        <th style="width:15%">Total</th>
                                        <th style="width:5%"></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsBody">
                                    <!-- rows added by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top">
                        <div class="row justify-content-end">
                            <div class="col-md-5">
                                <table class="table table-sm mb-0">
                                    <tr><td>Sub Total</td><td class="text-end fw-semibold" id="subTotalDisplay">₹0.00</td></tr>
                                    <tr><td>Discount</td><td class="text-end text-danger" id="discountDisplay">-₹0.00</td></tr>
                                    <tr><td>GST</td><td class="text-end" id="gstDisplay">₹0.00</td></tr>
                                    <tr class="table-success"><td class="fw-bold">Grand Total</td><td class="text-end fw-bold fs-5" id="grandTotalDisplay">₹0.00</td></tr>
                                </table>
                                <div class="mt-2">
                                    <label class="form-label fw-semibold small">Amount Paid</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" id="amountPaidInput" asp-for="AmountPaid" oninput="calcBalance()" />
                                </div>
                                <div class="mt-1 text-end">
                                    <span class="text-muted small">Balance: </span>
                                    <span class="fw-bold" id="balanceDisplay">₹0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hidden totals -->
                <input asp-for="SubTotal" type="hidden" id="subTotalHidden" />
                <input asp-for="DiscountAmount" type="hidden" id="discountHidden" />
                <input asp-for="GSTAmount" type="hidden" id="gstHidden" />
                <input asp-for="TotalAmount" type="hidden" id="totalHidden" />

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="fas fa-check me-2"></i>Create Bill
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let rowIndex = 0;

    function addItemRow(productId, productName, sellingPrice, stock, unitShort, gstPct) {
        const idx = rowIndex++;
        const row = `
        <tr id="row_${idx}">
            <td>
                <input type="hidden" name="Items[${idx}].ProductId" id="pid_${idx}" value="${productId || ''}" />
                <input type="text" class="form-control form-control-sm" placeholder="Search product..."
                       id="psearch_${idx}" value="${productName || ''}"
                       oninput="searchProduct(${idx}, this.value)" autocomplete="off" />
                <div id="pdrop_${idx}" class="dropdown-menu w-100" style="display:none;position:absolute;z-index:1000;max-height:200px;overflow-y:auto;"></div>
            </td>
            <td><span class="badge bg-secondary" id="pstock_${idx}">${stock || 0}</span></td>
            <td><input type="number" name="Items[${idx}].Qty" class="form-control form-control-sm" min="1" value="1" oninput="calcRow(${idx})" /></td>
            <td><input type="number" name="Items[${idx}].UnitSellingPrice" step="0.01" class="form-control form-control-sm" id="pprice_${idx}" value="${sellingPrice || 0}" oninput="calcRow(${idx})" /></td>
            <td><input type="number" name="Items[${idx}].DiscountPercent" step="0.01" class="form-control form-control-sm" value="0" min="0" max="100" oninput="calcRow(${idx})" /></td>
            <td><input type="text" class="form-control form-control-sm bg-light" id="ptotal_${idx}" readonly value="0.00" /></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(${idx})"><i class="fas fa-times"></i></button></td>
        </tr>`;
        document.getElementById('itemsBody').insertAdjacentHTML('beforeend', row);
        if (productId) calcRow(idx);
    }

    function removeRow(idx) {
        document.getElementById(`row_${idx}`)?.remove();
        calcTotals();
    }

    let searchTimers = {};
    async function searchProduct(idx, query) {
        clearTimeout(searchTimers[idx]);
        if (query.length < 2) { document.getElementById(`pdrop_${idx}`).style.display = 'none'; return; }
        searchTimers[idx] = setTimeout(async () => {
            const resp = await fetch(`/Store/Product/Search?q=${encodeURIComponent(query)}`);
            const data = await resp.json();
            const drop = document.getElementById(`pdrop_${idx}`);
            drop.innerHTML = '';
            data.forEach(p => {
                const item = document.createElement('a');
                item.className = 'dropdown-item';
                item.href = '#';
                item.textContent = `${p.productCode} - ${p.productName} (Stock: ${p.currentStock})`;
                item.onclick = (e) => {
                    e.preventDefault();
                    document.getElementById(`pid_${idx}`).value    = p.productId;
                    document.getElementById(`psearch_${idx}`).value = p.productName;
                    document.getElementById(`pprice_${idx}`).value  = p.sellingPrice;
                    document.getElementById(`pstock_${idx}`).textContent = p.currentStock;
                    drop.style.display = 'none';
                    calcRow(idx);
                };
                drop.appendChild(item);
            });
            drop.style.display = data.length ? 'block' : 'none';
        }, 300);
    }

    function calcRow(idx) {
        const qty      = parseFloat(document.querySelector(`[name="Items[${idx}].Qty"]`)?.value || 0);
        const price    = parseFloat(document.getElementById(`pprice_${idx}`)?.value || 0);
        const disc     = parseFloat(document.querySelector(`[name="Items[${idx}].DiscountPercent"]`)?.value || 0);
        const lineTotal = qty * price * (1 - disc / 100);
        const el = document.getElementById(`ptotal_${idx}`);
        if (el) el.value = lineTotal.toFixed(2);
        calcTotals();
    }

    function calcTotals() {
        let subTotal = 0, discount = 0, gst = 0;
        document.querySelectorAll('[id^="ptotal_"]').forEach(el => {
            subTotal += parseFloat(el.value || 0);
        });
        const grandTotal = subTotal - discount + gst;
        document.getElementById('subTotalDisplay').textContent  = '₹' + subTotal.toFixed(2);
        document.getElementById('discountDisplay').textContent  = '-₹' + discount.toFixed(2);
        document.getElementById('gstDisplay').textContent       = '₹' + gst.toFixed(2);
        document.getElementById('grandTotalDisplay').textContent = '₹' + grandTotal.toFixed(2);
        document.getElementById('subTotalHidden').value  = subTotal.toFixed(2);
        document.getElementById('discountHidden').value  = discount.toFixed(2);
        document.getElementById('gstHidden').value       = gst.toFixed(2);
        document.getElementById('totalHidden').value     = grandTotal.toFixed(2);
        calcBalance();
    }

    function calcBalance() {
        const total = parseFloat(document.getElementById('totalHidden').value || 0);
        const paid  = parseFloat(document.getElementById('amountPaidInput').value || 0);
        document.getElementById('balanceDisplay').textContent = '₹' + (total - paid).toFixed(2);
    }

    async function loadCustomers() {
        const type = document.getElementById('customerTypeSelect').value;
        const isWalkIn = type === 'Walk-in';
        document.getElementById('customerSearchRow').style.display = isWalkIn ? 'none' : '';
        document.getElementById('customerSelectRow').style.display = isWalkIn ? 'none' : '';
        document.getElementById('walkInRow').style.display         = isWalkIn ? '' : 'none';
        if (!isWalkIn) {
            const resp = await fetch(`/Store/Sale/GetPersonList?type=${type}`);
            const data = await resp.json();
            const sel  = document.getElementById('customerSelect');
            sel.innerHTML = '<option value="">Select...</option>';
            data.forEach(p => sel.innerHTML += `<option value="${p.id}">${p.name} (${p.code})</option>`);
        }
    }

    let custTimer;
    async function searchCustomers() {
        clearTimeout(custTimer);
        custTimer = setTimeout(async () => {
            const type   = document.getElementById('customerTypeSelect').value;
            const search = document.getElementById('customerSearch').value;
            if (search.length < 2) return;
            const resp = await fetch(`/Store/Sale/GetPersonList?type=${type}&search=${encodeURIComponent(search)}`);
            const data = await resp.json();
            const sel  = document.getElementById('customerSelect');
            sel.innerHTML = '<option value="">Select...</option>';
            data.forEach(p => sel.innerHTML += `<option value="${p.id}">${p.name} (${p.code})</option>`);
        }, 300);
    }

    function setCustomerName() {
        const sel = document.getElementById('customerSelect');
        const opt = sel.options[sel.selectedIndex];
        if (opt && opt.value) {
            document.querySelector('[name="CustomerName"]').value = opt.text.split('(')[0].trim();
        }
    }

    // Add first row on load
    addItemRow();
</script>
}
