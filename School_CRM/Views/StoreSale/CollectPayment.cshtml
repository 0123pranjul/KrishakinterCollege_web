@model School_CRM.Models.DTOs.InvCreditPaymentDto
@{ ViewData["Title"] = "Collect Payment"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-rupee-sign text-success me-2"></i>Collect Payment</h2>
            <small class="text-muted">@Model.CustomerType — @Model.CustomerName</small>
        </div>
        <a asp-action="CreditPending" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Due Summary -->
            <div class="card border-0 shadow-sm bg-danger text-white mb-4">
                <div class="card-body text-center py-3">
                    <h3 class="fw-bold mb-0">₹@Model.TotalDue.ToString("F2")</h3>
                    <small>Total Pending — @Model.CustomerName (@Model.CustomerType)</small>
                </div>
            </div>

            <!-- Unpaid Bills -->
            @if (Model.UnpaidBills.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">Unpaid Bills</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th>Bill No.</th><th>Date</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Balance</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in Model.UnpaidBills)
                                    {
                                        <tr>
                                            <td><code>@b.BillNumber</code></td>
                                            <td>@b.SaleDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end">₹@b.TotalAmount.ToString("F2")</td>
                                            <td class="text-end text-success">₹@b.AmountPaid.ToString("F2")</td>
                                            <td class="text-end fw-bold text-danger">₹@b.BalanceDue.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Payment Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0">Collect Payment</h6>
                </div>
                <div class="card-body">
                    <form asp-action="CollectPayment" asp-route-type="@Model.CustomerType"
                          asp-route-id="@Model.CustomerId" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="CustomerType" type="hidden" />
                        <input asp-for="CustomerId" type="hidden" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AmountPaid" class="form-label fw-semibold">
                                    Amount Paid (₹) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="AmountPaid" type="number" step="0.01"
                                           class="form-control" max="@Model.TotalDue" />
                                </div>
                                <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PaymentMode" class="form-label fw-semibold">Payment Mode</label>
                                <select asp-for="PaymentMode" class="form-select">
                                    <option value="Cash">Cash</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Online">Online</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PaymentDate" class="form-label fw-semibold">Payment Date</label>
                                <input asp-for="PaymentDate" type="date" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="fas fa-check me-2"></i>Collect Payment
                            </button>
                            <a asp-action="CreditPending" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
