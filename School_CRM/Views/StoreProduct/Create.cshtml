@model School_CRM.Models.DTOs.InvProductDto
@{ ViewData["Title"] = "Add Product"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-plus-circle text-primary me-2"></i>Add Product</h2>
            <small class="text-muted">Add a new item to the store catalog</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div> }

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-4">

            <!-- Product Details -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-box me-2 text-primary"></i>Product Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="ProductName" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                                <input asp-for="ProductName" class="form-control" placeholder="e.g. English Grammar Book - Class 8, White Shirt - Size M" />
                                <span asp-validation-for="ProductName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">Select Category</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UnitId" class="form-label fw-semibold">Unit <span class="text-danger">*</span></label>
                                <select asp-for="UnitId" class="form-select" asp-items="ViewBag.Units">
                                    <option value="">Select Unit</option>
                                </select>
                                <span asp-validation-for="UnitId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CostPrice" class="form-label fw-semibold">Cost Price (₹) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="CostPrice" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="CostPrice" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SellingPrice" class="form-label fw-semibold">Selling Price (₹) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="GSTPercent" class="form-label fw-semibold">GST %</label>
                                <div class="input-group">
                                    <input asp-for="GSTPercent" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ReorderLevel" class="form-label fw-semibold">Reorder Level</label>
                                <input asp-for="ReorderLevel" type="number" class="form-control" />
                                <small class="text-muted">Alert when stock falls below this</small>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxStockLevel" class="form-label fw-semibold">Max Stock Level</label>
                                <input asp-for="MaxStockLevel" type="number" class="form-control" placeholder="Optional" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OpeningStock" class="form-label fw-semibold">Opening Stock</label>
                                <input asp-for="OpeningStock" type="number" class="form-control" />
                                <small class="text-muted">Current stock on hand</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HSNCode" class="form-label fw-semibold">HSN Code</label>
                                <input asp-for="HSNCode" class="form-control" placeholder="For GST" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Barcode" class="form-label fw-semibold">Barcode</label>
                                <input asp-for="Barcode" class="form-control" placeholder="Optional barcode" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional description..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Image & Settings -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-image me-2 text-secondary"></i>Product Image</h6>
                    </div>
                    <div class="card-body">
                        <input asp-for="ProductImage" type="file" class="form-control" accept="image/*" />
                        <small class="text-muted">Optional. JPG, PNG, max 2MB</small>
                    </div>
                </div>

                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h6 class="fw-bold mb-2"><i class="fas fa-info-circle me-2 text-primary"></i>Auto-Generated</h6>
                        <p class="small text-muted mb-0">
                            Product Code will be auto-generated in format:<br />
                            <code>INV-[CATCODE]-[SEQ]</code><br />
                            e.g. <code>INV-BK-001</code>
                        </p>
                        @if (Model.OpeningStock > 0)
                        {
                            <hr class="my-2" />
                            <p class="small text-muted mb-0">
                                <i class="fas fa-check-circle text-success me-1"></i>
                                Opening stock adjustment will be created automatically.
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="fas fa-save me-2"></i>Save Product
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
