@model School_CRM.Models.TblStudentExtraCharge

<div class="row g-3">

    <!-- Student Info -->
    <div class="col-md-6">
        <div class="card h-100 border-primary">
            <div class="card-header bg-primary text-white py-2">
                <h6 class="mb-0"><i class="fas fa-user-graduate me-2"></i>Student Info</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted" width="40%">Name</td>
                        <td class="fw-semibold">@(Model.Student?.StudentName ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Roll No</td>
                        <td class="fw-semibold">@(Model.Student?.RollNo ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Session</td>
                        <td class="fw-semibold">@(Model.Session?.SessionName ?? "-")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Charge Info -->
    <div class="col-md-6">
        <div class="card h-100 border-danger">
            <div class="card-header bg-danger text-white py-2">
                <h6 class="mb-0"><i class="fas fa-receipt me-2"></i>Charge Info</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted" width="40%">Fee Type</td>
                        <td class="fw-semibold">@(Model.FeeType?.FeeName ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Charge Date</td>
                        <td class="fw-semibold">
                            @(Model.ChargeDate.HasValue ? Model.ChargeDate.Value.ToString("dd-MM-yyyy") : "-")
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Status</td>
                        <td>
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Amount + Payment Status -->
    <div class="col-md-6">
        <div class="card border-0 bg-light text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block mb-1">Charge Amount</small>
                <h2 class="text-danger fw-bold mb-0">
                    ₹@(Model.Amount.HasValue ? Model.Amount.Value.ToString("0.00") : "0.00")
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 bg-light text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block mb-1">Payment Status</small>
                @if (Model.IsPaid == true)
                {
                    <h4 class="mb-0"><span class="badge bg-success fs-6">✓ Paid</span></h4>
                }
                else
                {
                    <h4 class="mb-0"><span class="badge bg-warning text-dark fs-6">⏳ Pending</span></h4>
                }
            </div>
        </div>
    </div>

    <!-- Reason -->
    @if (!string.IsNullOrWhiteSpace(Model.Reason))
    {
        <div class="col-12">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark py-2">
                    <h6 class="mb-0"><i class="fas fa-comment-alt me-2"></i>Reason</h6>
                </div>
                <div class="card-body py-2">
                    <p class="mb-0">@Model.Reason</p>
                </div>
            </div>
        </div>
    }

    <!-- Timestamps -->
    <div class="col-md-6">
        <small class="text-muted d-block">Created Date</small>
        <span class="fw-semibold">
            @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd-MM-yyyy hh:mm tt") : "-")
        </span>
    </div>
    @if (Model.UpdatedDate.HasValue)
    {
        <div class="col-md-6">
            <small class="text-muted d-block">Last Updated</small>
            <span class="fw-semibold">
                @Model.UpdatedDate.Value.ToString("dd-MM-yyyy hh:mm tt")
            </span>
        </div>
    }

</div>
