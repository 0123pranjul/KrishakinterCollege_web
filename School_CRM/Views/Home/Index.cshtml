                <div class="enquiry-modal-header-content">
                    <div class="enquiry-modal-icon">
                        <i class="bx bxs-graduation"></i>
                    </div>
                    <h3>Admissions Open 2026-27</h3>
                    <p>Secure your child's seat at Krishak Inter College</p>
                </div>
            </div>
            <div class="enquiry-modal-body">
                <div id="modalFormContainer">
                    <div id="modalValidationError" style="display: none; background-color: #ffeef0; color: #d9383a; font-size: 13px; padding: 10px 14px; margin-bottom: 16px; border-radius: 8px; border: 1px solid #fec8cb; text-align: center;"></div>
                    <form id="publicEnquiryForm" onsubmit="handleEnquirySubmit(event)">
                        <div class="enquiry-modal-field">
                            <i class="bx bx-user"></i>
                            <input type="text" id="modalStudentName" placeholder="Student's Full Name *" required />
                        </div>
                        <div class="enquiry-modal-field">
                            <i class="bx bx-user-voice"></i>
                            <input type="text" id="modalParentName" placeholder="Parent / Guardian Name *" required />
                        </div>
                        <div class="enquiry-modal-field">
                            <i class="bx bx-phone"></i>
                            <input type="tel" id="modalMobileNo" placeholder="10-Digit Mobile Number *" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="10" required />
                        </div>
                        <div class="enquiry-modal-field">
                            <i class="bx bx-book-open"></i>
                            <select id="modalInterestedClassId" required>
                                <option value="">-- Select Class -- </option>
                            </select>
                        </div>
                        <div class="enquiry-modal-field" style="display: none;">
                            <i class="bx bx-calendar"></i>
                            <select id="modalSessionId">
                                <option value="">Select Academic Session</option>
                            </select>
                        </div>

                        <!-- Captcha Block -->
                        <div class="enquiry-modal-field d-flex align-items-center gap-2" style="margin-bottom: 16px;">
                            <div class="captcha-img-wrapper" style="flex-shrink: 0;">
                                <img src="/Enquiry/GetCaptchaImage" id="enquiryCaptchaImg" alt="Captcha" style="height: 38px; border-radius: 8px; border: 1.5px solid #e2e8f0;" />
                            </div>
                            <button type="button" onclick="refreshEnquiryCaptcha()" class="btn p-0 border-0 bg-transparent text-secondary-light cursor-pointer" style="font-size: 24px; color: #94a3b8; outline: none; line-height: 1;" title="Refresh Captcha">
                                <i class="bx bx-refresh"></i>
                            </button>
                            <input type="text" id="modalCaptchaInput" placeholder="Code *" style="max-width: 110px; text-transform: uppercase; padding-left: 12px !important;" required autocomplete="off" />
                        </div>
                        
                        <button type="submit" class="enquiry-modal-submit-btn">Submit Enquiry</button>
                    </form>
                </div>
                <div id="modalSuccessContainer" style="display: none; text-align: center; padding: 30px 10px;">
                    <div class="success-icon-wrap" style="font-size: 60px; color: #2eca7f; margin-bottom: 20px;">
                        <i class="bx bx-check-circle"></i>
                    </div>
                    <h4 style="font-weight: 700; color: #1a1a2e; margin-bottom: 10px;">Enquiry Submitted!</h4>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.5;">Thank you for your interest. Our admissions team will review your enquiry and contact you within 24 hours.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Links of JS files -->
    <script src="~/collage/collage_project/assets/js/jquery.min.js"></script>
    <script src="~/collage/collage_project/assets/js/aos.js"></script>
    <script src="~/collage/collage_project/assets/js/bootstrap.min.js"></script>
    <script src="~/collage/collage_project/assets/js/magnific-popup.min.js"></script>
    <script src="~/collage/collage_project/assets/js/owl.carousel.min.js"></script>
    <script src="~/collage/collage_project/assets/js/main.js"></script>

    <!-- Custom script to initialize background slider -->
    <script>
        $(document).ready(function() {
            $('.banner-slider').owlCarousel({
                items: 1,
                loop: true,
                autoplay: true,
                autoplayTimeout: 5000,
                autoplaySpeed: 1000,
                navSpeed: 1000,
                dotsSpeed: 1000,
                dragEndSpeed: 1000,
                dots: false,
                nav: false,
                mouseDrag: false,
                touchDrag: false
            });
        });

        function toggleSocialBar() {
            const bar = document.querySelector('.sticky-social-bar');
            bar.classList.toggle('collapsed');
            const icon = bar.querySelector('.social-bar-toggle i');
            if (bar.classList.contains('collapsed')) {
                icon.className = 'bx bx-chevrons-left';
            } else {
                icon.className = 'bx bx-chevrons-right';
            }
        }

        function sharePage() {
            if (navigator.share) {
                navigator.share({
                    title: document.title,
                    url: window.location.href
                }).catch(err => console.log(err));
            } else {
                const dummy = document.createElement('input');
                document.body.appendChild(dummy);
                dummy.value = window.location.href;
                dummy.select();
                document.execCommand('copy');
                document.body.removeChild(dummy);
                alert('Link copied to clipboard!');
            }
        }

        let isEnquiryDataLoaded = false;
        let latestSessionId = null;

        function refreshEnquiryCaptcha() {
            const img = document.getElementById('enquiryCaptchaImg');
            if (img) {
                img.src = '/Enquiry/GetCaptchaImage?t=' + new Date().getTime();
            }
        }

        function openEnquiryModal() {
            const modal = document.getElementById('enquiryModal');
            modal.style.display = 'flex';
            setTimeout(() => {
                modal.classList.add('active');
            }, 10);

            // Always get a fresh Captcha when opening
            refreshEnquiryCaptcha();

            if (!isEnquiryDataLoaded) {
                // Load classes from the whitelisted GetClasses endpoint
                fetch('/Enquiry/GetClasses')
                    .then(res => res.json())
                    .then(data => {
                        const classList = Array.isArray(data) ? data : (data.value || []);
                        const classSelect = document.getElementById('modalInterestedClassId');
                        classList.forEach(c => {
                            const opt = document.createElement('option');
                            const id = c.classId !== undefined ? c.classId : c.ClassId;
                            const name = c.className !== undefined ? c.className : c.ClassName;
                            opt.value = id;
                            opt.textContent = name;
                            classSelect.appendChild(opt);
                        });
                        isEnquiryDataLoaded = true;
                    })
                    .catch(err => console.error("Error loading classes:", err));

                // Load sessions from the whitelisted GetSessions endpoint
                fetch('/Enquiry/GetSessions')
                    .then(res => res.json())
                    .then(data => {
                        const sessionList = Array.isArray(data) ? data : (data.value || []);
                        if (sessionList && sessionList.length > 0) {
                            latestSessionId = sessionList[0].sessionId !== undefined ? sessionList[0].sessionId : sessionList[0].SessionId;
                            const sessionSelect = document.getElementById('modalSessionId');
                            sessionList.forEach(s => {
                                const opt = document.createElement('option');
                                const id = s.sessionId !== undefined ? s.sessionId : s.SessionId;
                                const name = s.sessionName !== undefined ? s.sessionName : s.SessionName;
                                opt.value = id;
                                opt.textContent = name;
                                sessionSelect.appendChild(opt);
                            });
                            sessionSelect.value = latestSessionId;
                        }
                    })
                    .catch(err => console.error("Error loading sessions:", err));
            }
        }

        function closeEnquiryModal() {
            const modal = document.getElementById('enquiryModal');
            modal.classList.remove('active');
            setTimeout(() => {
                modal.style.display = 'none';
                // Reset form and errors
                document.getElementById('publicEnquiryForm').reset();
                document.getElementById('modalValidationError').style.display = 'none';
                document.getElementById('modalValidationError').textContent = '';
                if (document.getElementById('modalCaptchaInput')) {
                    document.getElementById('modalCaptchaInput').value = '';
                }
                document.getElementById('modalFormContainer').style.display = 'block';
                document.getElementById('modalSuccessContainer').style.display = 'none';
            }, 300);
        }

        function handleEnquirySubmit(event) {
            event.preventDefault();

            const studentName = document.getElementById('modalStudentName').value.trim();
            const parentName = document.getElementById('modalParentName').value.trim();
            const mobileNo = document.getElementById('modalMobileNo').value.trim();
            const classId = document.getElementById('modalInterestedClassId').value;
            const sessionId = document.getElementById('modalSessionId').value || latestSessionId;
            const captchaInput = document.getElementById('modalCaptchaInput').value.trim();

            const errorDiv = document.getElementById('modalValidationError');
            errorDiv.style.display = 'none';
            errorDiv.textContent = '';

            if (!studentName) {
                errorDiv.textContent = 'Please enter the Student Full Name.';
                errorDiv.style.display = 'block';
                return;
            }
            if (!parentName) {
                errorDiv.textContent = 'Please enter the Parent / Guardian Name.';
                errorDiv.style.display = 'block';
                return;
            }
            if (!mobileNo) {
                errorDiv.textContent = 'Please enter the Mobile Number.';
                errorDiv.style.display = 'block';
                return;
            }
            if (!/^\d{10}$/.test(mobileNo)) {
                errorDiv.textContent = 'Please enter a valid 10-digit Mobile Number.';
                errorDiv.style.display = 'block';
                return;
            }
            if (!classId) {
                errorDiv.textContent = 'Please select an Interested Class.';
                errorDiv.style.display = 'block';
                return;
            }
            if (!captchaInput) {
                errorDiv.textContent = 'Please enter the Verification Code.';
                errorDiv.style.display = 'block';
                return;
            }

            const submitBtn = event.target.querySelector('.enquiry-modal-submit-btn');
            const originalBtnText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            const payload = {
                StudentName: studentName,
                DateOfBirth: null,
                Gender: null,
                ParentName: parentName,
                MobileNo: mobileNo,
                AlternateMobile: null,
                Email: null,
                Address: null,
                City: null,
                InterestedClassId: parseInt(classId),
                SessionId: sessionId ? parseInt(sessionId) : null,
                CaptchaInput: captchaInput
            };

            fetch('/Enquiry/SubmitPublicForm', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('modalFormContainer').style.display = 'none';
                    document.getElementById('modalSuccessContainer').style.display = 'block';
                    setTimeout(() => {
                        closeEnquiryModal();
                    }, 4000);
                } else {
                    errorDiv.textContent = data.message;
                    errorDiv.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalBtnText;
                    refreshEnquiryCaptcha();
                }
            })
            .catch(err => {
                console.error(err);
                errorDiv.textContent = 'Error submitting enquiry. Please try again.';
                errorDiv.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
                refreshEnquiryCaptcha();
            });
        }

        $(document).ready(function() {
            // Auto open admission enquiry modal after 5 seconds on load
            setTimeout(() => {
                const modal = document.getElementById('enquiryModal');
                if (modal && !modal.classList.contains('active')) {
                    openEnquiryModal();
                }
            }, 5000);
        });
    </script>
</body>
</html>











