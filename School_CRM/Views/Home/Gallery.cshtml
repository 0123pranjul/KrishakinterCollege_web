@{
    Layout = null;
}
<!doctype html>
<html lang="zxx">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Links of CSS files -->
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/aos.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/boxicons.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/style.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/header.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/responsive.css">

    <title>Image Gallery - Krishak Inter College</title>
    <link rel="icon" type="image/png" href="~/kic_logo.png">
    
    <style>
            .kic-logo-text {
                font-size: 22px;
                font-weight: 800;
                letter-spacing: 1px;
                line-height: 1.2;
            }

                .kic-logo-text span {
                    display: block;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 2px;
                    text-transform: uppercase;
                    opacity: 0.85;
                }

            .logo-light .kic-logo-text {
                color: #fff;
            }

            .logo-dark .kic-logo-text {
                color: #1a1a2e;
            }

            .navbar-brand .logo-light, .navbar-brand .logo-dark {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .kic-logo-img {
                width: 42px;
                height: 42px;
                object-fit: contain;
                border-radius: 8px;
                flex-shrink: 0;
                background: var(--whiteColor);
                padding: 2px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }

            /* Fix dual logo display bug */
            .navbar-area.style-2 .navbar-brand .logo-dark {
                display: none !important;
            }
            .navbar-area.style-2.sticky .navbar-brand .logo-light {
                display: none !important;
            }
            .navbar-area.style-2.sticky .navbar-brand .logo-dark {
                display: flex !important;
            }

            /* Gallery Styles */
            .gallery-area {
                padding-top: 80px;
                padding-bottom: 80px;
                background-color: var(--secounderyColor) !important;
            }
            .gallery-filters {
                display: flex;
                justify-content: center;
                gap: 12px;
                margin-bottom: 45px;
                flex-wrap: wrap;
            }
            .filter-btn {
                background-color: var(--whiteColor);
                color: var(--blackColor);
                border: 1px solid rgba(0, 33, 71, 0.08);
                padding: 10px 24px;
                font-size: 14px;
                font-weight: 600;
                border-radius: 30px;
                cursor: pointer;
                transition: all 0.3s ease;
            }
            .filter-btn.active, .filter-btn:hover {
                background-color: var(--mainColor);
                color: var(--whiteColor);
                border-color: var(--mainColor);
                box-shadow: 0 4px 15px rgba(46, 202, 127, 0.2);
            }
            .gallery-card {
                background-color: var(--whiteColor);
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
                margin-bottom: 30px;
                transition: all 0.4s ease;
                border: 1px solid rgba(0, 0, 0, 0.02);
                position: relative;
            }
            .gallery-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 35px rgba(46, 202, 127, 0.15);
            }
            .gallery-image-box {
                position: relative;
                overflow: hidden;
                height: 240px;
            }
            .gallery-image-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease;
            }
            .gallery-card:hover .gallery-image-box img {
                transform: scale(1.08);
            }
            .gallery-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 33, 71, 0.7);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                transition: all 0.4s ease;
            }
            .gallery-card:hover .gallery-overlay {
                opacity: 1;
            }
            .zoom-icon {
                color: var(--whiteColor);
                background-color: var(--mainColor);
                width: 48px;
                height: 48px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                transform: scale(0.7);
                transition: all 0.4s ease;
            }
            .gallery-card:hover .zoom-icon {
                transform: scale(1);
            }
            .gallery-info {
                padding: 18px;
                text-align: center;
            }
            .gallery-info h4 {
                font-size: 15px;
                font-weight: 700;
                margin-bottom: 5px;
                color: var(--blackColor);
            }
            .gallery-info span {
                font-size: 12px;
                color: var(--paragraphColor);
                text-transform: uppercase;
                font-weight: 600;
                letter-spacing: 0.5px;
            }
            /* Page Banner */
            .page-banner-area {
                background-color: var(--blackColor);
                padding-top: 160px;
                padding-bottom: 70px;
                text-align: center;
                position: relative;
                z-index: 1;
            }
            .page-banner-area h1 {
                color: var(--whiteColor);
                font-size: 38px;
                margin-bottom: 12px;
            }
            .page-banner-breadcrumb {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                justify-content: center;
                gap: 8px;
                color: var(--paragraphColorSecond);
                font-size: 14px;
            }
            .page-banner-breadcrumb a {
                color: var(--whiteColor);
            }
            .page-banner-breadcrumb li.active {
                color: var(--mainColor);
            }
    </style>
</head>
<body>

    <!-- preloader -->
    <div class="preloader-container" id="preloader">
        <div class="preloader-dot"></div>
        <div class="preloader-dot"></div>
        <div class="preloader-dot"></div>
        <div class="preloader-dot"></div>
        <div class="preloader-dot"></div>
    </div>

    <!-- Start Navbar Area Start -->
    <div class="navbar-area style-2" id="navbar">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-lg">
                <a class='navbar-brand' asp-controller="Home" asp-action="Index">
                    <div class="logo-light d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#fff;">Krishak<span>Inter College</span></div>
                    </div>
                    <div class="logo-dark d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                    </div>
                </a>
               @*  <div class="other-option d-lg-none">
                    <div class="option-item">
                        <button type="button" class="search-btn" data-bs-toggle="offcanvas" data-bs-target="#staticBackdrop">
                            <i class='bx bx-search'></i>
                        </button>
                    </div>
                </div> *@
                <a class="navbar-toggler" data-bs-toggle="offcanvas" href="#navbarOffcanvas" role="button" aria-controls="navbarOffcanvas">
                    <i class='bx bx-menu'></i>
                </a>
                <div class="collapse navbar-collapse justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link active">
                                About & Gallery
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="about">About Us</a></li>
                                <li class="nav-item"><a class='nav-link active' asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Home" asp-action="contacts">
                                Contact
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                           @*  <a class='nav-link' asp-controller="Account" asp-action="Register"> Register </a> *@
                        </li>
                    </ul>
                    <div class="others-option d-flex align-items-center">
                        @* <div class="option-item">
                            <div class="nav-btn">
                                <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                            </div>
                        </div> *@
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- End Navbar Area Start -->

    <!-- Start Responsive Navbar Area -->
    <div class="responsive-navbar offcanvas offcanvas-end" data-bs-backdrop="static" tabindex="-1" id="navbarOffcanvas">
        <div class="offcanvas-header">
            <a class='logo d-inline-block' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="accordion" id="navbarAccordion">
                <div class="accordion-item">
                    <a class="accordion-link without-icon" asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                </div>
                <div class="accordion-item">
                    <button class="accordion-button collapsed active" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        About & Gallery
                    </button>
                    <div id="collapseTwo" class="accordion-collapse collapse show" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <div class="accordion" id="navbarAccordion8">
                                <div class="accordion-item">
                                    <a class='accordion-link' asp-controller="Home" asp-action="about">
                                        About Us
                                    </a>
                                </div>
                                <div class="accordion-item">
                                    <a class='accordion-link active' asp-controller="Home" asp-action="Gallery">
                                        Gallery
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <a class='accordion-link without-icon' asp-controller="Home" asp-action="contacts">
                        Contact Us
                    </a>
                </div>
                <div class="accordion-item">
                    <a class='accordion-link without-icon' asp-controller="Account" asp-action="Login">Login</a>
                </div>
               @*  <div class="accordion-item">
                    <a class='accordion-link without-icon' asp-controller="Account" asp-action="Register"> Register </a>
                </div> *@
            </div>
        </div>
    </div>
    <!-- End Responsive Navbar Area -->

    <!-- Page Banner Area -->
    <div class="page-banner-area">
        <div class="container">
            <h1>School Image Gallery</h1>
            <ul class="page-banner-breadcrumb">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li>/</li>
                <li class="active">Gallery</li>
            </ul>
        </div>
    </div>

    <!-- Gallery Area -->
    <div class="gallery-area">
        <div class="container">
            <div class="gallery-filters" data-aos="fade-up">
                <button class="filter-btn active" data-filter="all">All Photos</button>
                <button class="filter-btn" data-filter="campus">Campus Facilities</button>
                <button class="filter-btn" data-filter="classrooms">Smart Classrooms</button>
                <button class="filter-btn" data-filter="sports">Sports & Athletics</button>
                <button class="filter-btn" data-filter="events">School Events</button>
            </div>

            <div class="row justify-content-center popup-gallery">
                @for (int i = 1; i <= 43; i++)
                {
                    string category = "campus";
                    string categoryTitle = "Campus Facilities";
                    
                    if (i > 10 && i <= 20) 
                    { 
                        category = "classrooms"; 
                        categoryTitle = "Smart Classrooms"; 
                    }
                    else if (i > 20 && i <= 30) 
                    { 
                        category = "sports"; 
                        categoryTitle = "Sports & Athletics"; 
                    }
                    else if (i > 30) 
                    { 
                        category = "events"; 
                        categoryTitle = "School Events"; 
                    }

                    string imgPath = $"/Gprp/image/g{i}.jpeg";

                    <div class="col-lg-3 col-md-4 col-sm-6 gallery-item" data-category="@category" data-aos="fade-up" data-aos-delay="@((i % 4) * 80)">
                        <div class="gallery-card">
                            <div class="gallery-image-box">
                                <img src="@imgPath" alt="Krishak Inter College Gallery Image @i" loading="lazy" />
                                <a href="@imgPath" title="Krishak Inter College Gallery - @categoryTitle" class="gallery-overlay">
                                    <div class="zoom-icon">
                                        <i class="bx bx-plus"></i>
                                    </div>
                                </a>
                            </div>
                            <div class="gallery-info">
                                <h4>Photo @i</h4>
                                <span>@categoryTitle</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Start Footer Area -->
    <div class="footer-area">
        <div class="footer-widget-info ptb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index"><i class='bx bx-chevron-right'></i> Home</a></li>
                                <li><a asp-controller="Home" asp-action="about"><i class='bx bx-chevron-right'></i> About Us</a></li>
                                <li><a asp-controller="Home" asp-action="Gallery"><i class='bx bx-chevron-right'></i> Gallery</a></li>
                                <li><a asp-controller="Home" asp-action="contacts"><i class='bx bx-chevron-right'></i> Contact Us</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Account</h4>
                            <ul>
                                <li><a asp-controller="Account" asp-action="Login"><i class='bx bx-chevron-right'></i> Login</a></li>
                               @*  <li><a asp-controller="Account" asp-action="Register"><i class='bx bx-chevron-right'></i> Register</a></li> *@
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Contact Info</h4>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 10px;"><i class="bx bxs-map me-2" style="color: var(--mainColor);"></i> Krishak Inter College, India</p>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 10px;"><i class="bx bxs-envelope me-2" style="color: var(--mainColor);"></i> <a href="mailto:info@kic.in" style="color: var(--paragraphColorSecond);">info@kic.in</a></p>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 0;"><i class="bx bxs-time me-2" style="color: var(--mainColor);"></i> Mon - Sat: 8:00 - 17:00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copy-right-area style-2">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-4">
                        <div class="cpr-left">
                            <p>Copyright© <a href="https://kic.in">Krishak Inter College</a>. All rights reserved.</p>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="cpr-right">
                            <ul>
                                <li><a href="#">Privacy Policy</a></li>
                                <li><a href="#">Cookie Policy</a></li>
                            </ul>
                            <ul class="social-list">
                                <li><a href="#"><i class='bx bxl-facebook'></i></a></li>
                                <li><a href="#"><i class='bx bxl-instagram-alt'></i></a></li>
                                <li><a href="#"><i class='bx bxl-twitter'></i></a></li>
                                <li><a href="#"><i class='bx bxl-linkedin-square'></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="copy-logo">
                    <img src="/kic_logo.png" alt="Krishak Inter College" style="height: 60px; width: auto; background: var(--whiteColor); padding: 5px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);" />
                </div>
            </div>
        </div>
    </div>
    <!-- End Footer Area -->

    <div class="go-top active">
        <i class="bx bx-up-arrow-alt"></i>
    </div>

    <!-- Links of JS files -->
    <script src="~/collage/collage_project/assets/js/jquery.min.js"></script>
    <script src="~/collage/collage_project/assets/js/aos.js"></script>
    <script src="~/collage/collage_project/assets/js/bootstrap.min.js"></script>
    <script src="~/collage/collage_project/assets/js/magnific-popup.min.js"></script>
    <script src="~/collage/collage_project/assets/js/owl.carousel.min.js"></script>
    <script src="~/collage/collage_project/assets/js/main.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize Magnific Popup for Gallery zoom effect
            $('.popup-gallery').magnificPopup({
                delegate: 'a.gallery-overlay',
                type: 'image',
                gallery: {
                    enabled: true,
                    navigateByImgClick: true,
                    preload: [0, 1]
                },
                image: {
                    tError: '<a href="%url%">The image</a> could not be loaded.',
                    titleSrc: function (item) {
                        return item.el.attr('title') || 'Krishak Inter College Gallery';
                    }
                }
            });

            // Filtering gallery items dynamically
            $('.filter-btn').on('click', function () {
                var filter = $(this).attr('data-filter');
                $('.filter-btn').removeClass('active');
                $(this).addClass('active');

                if (filter === 'all') {
                    $('.gallery-item').fadeIn(400);
                } else {
                    $('.gallery-item').hide();
                    $('.gallery-item[data-category="' + filter + '"]').fadeIn(400);
                }
            });
        });
    </script>
</body>
</html>
