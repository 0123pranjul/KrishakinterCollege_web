@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="hi">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Links of CSS files -->
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/aos.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/boxicons/2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/style.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/header.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <title>संचालक संदेश - कृषक इण्टर कॉलेज</title>
    <link rel="icon" type="image/png" href="~/kic_logo.png">

    <style>
        /* Shared Header Logo styling to match index/contacts page */
        .kic-logo-text {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 1px;
            line-height: 1.2;
        }

        .kic-logo-text span {
            display: block;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
            opacity: 0.85;
        }

        .logo-light .kic-logo-text {
            color: #fff;
        }

        .logo-dark .kic-logo-text {
            color: #1a1a2e;
        }

        .navbar-brand .logo-light, .navbar-brand .logo-dark {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .kic-logo-img {
            width: 55px;
            height: 55px;
            object-fit: contain;
            border-radius: 12px;
            flex-shrink: 0;
            background: var(--whiteColor);
            padding: 4px;
            box-shadow: 0 4px 15px rgba(46, 202, 127, 0.35);
            border: 2px solid var(--mainColor);
            transition: all 0.3s ease;
        }
        .kic-logo-img:hover {
            transform: scale(1.08);
            box-shadow: 0 8px 25px rgba(46, 202, 127, 0.5);
            border-color: var(--blackColor);
        }
        
        /* Fix dual logo display bug */
        .navbar-area.style-2 .navbar-brand .logo-dark {
            display: none !important;
        }
        .navbar-area.style-2.sticky .navbar-brand .logo-light {
            display: none !important;
        }
        .navbar-area.style-2.sticky .navbar-brand .logo-dark {
            display: flex !important;
        }

        /* Make navbar solid dark navy by default on inner pages */
        .navbar-area.style-2 {
            background: #120f2d !important;
            position: relative !important;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 99;
            padding-top: 15px;
            padding-bottom: 15px;
        }

        /* Premium Director Section Styles */
        .director-hero-section {
            background: linear-gradient(135deg, #0b0920 0%, #151b3d 100%);
            padding: 90px 0;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .director-hero-section::before {
            content: '';
            position: absolute;
            top: -30%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(46, 202, 127, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .director-card-premium {
            background: #ffffff;
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
            padding: 50px;
            margin-top: -60px;
            position: relative;
            z-index: 10;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .director-photo-frame {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            border: 5px solid #fff;
            transition: transform 0.3s ease;
        }
        .director-photo-frame:hover {
            transform: translateY(-5px);
        }
        .director-photo-frame img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }

        .director-badge {
            display: inline-block;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            background-color: var(--mainColor);
            border-radius: 50px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(46, 202, 127, 0.2);
        }

        .director-title-block h2 {
            font-size: 32px;
            font-weight: 800;
            color: #120f2d;
            margin-bottom: 5px;
        }
        .director-title-block h3 {
            font-size: 18px;
            font-weight: 600;
            color: var(--mainColor);
            margin-bottom: 25px;
        }

        .message-p {
            font-size: 18px;
            line-height: 1.8;
            color: var(--paragraphColor);
            margin-bottom: 20px;
            text-align: justify;
        }

        /* Objectives Section */
        .objectives-title {
            font-size: 28px;
            font-weight: 800;
            color: #120f2d;
            margin-top: 45px;
            margin-bottom: 30px;
            border-left: 5px solid var(--mainColor);
            padding-left: 15px;
        }

        .objective-item {
            background-color: #fdfdfd;
            border: 1px solid #f0f3fa;
            border-radius: 16px;
            padding: 24px;
            height: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.01);
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }
        .objective-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(46, 202, 127, 0.08);
            border-color: rgba(46, 202, 127, 0.25);
            background-color: #fff;
        }
        .objective-icon-num {
            background-color: rgba(46, 202, 127, 0.1);
            color: var(--mainColor);
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            flex-shrink: 0;
            box-shadow: inset 0 0 10px rgba(46, 202, 127, 0.05);
        }
        .objective-text h5 {
            font-size: 16px;
            font-weight: 700;
            color: #120f2d;
            margin-bottom: 0;
            line-height: 1.6;
        }
    </style>
</head>
<body>

    <!-- Start Navbar Area -->
    <div class="navbar-area style-2">
        <div class="container">
            <nav class="navbar navbar-expand-lg">
                <a class='navbar-brand logo' asp-controller="Home" asp-action="Index">
                    <div class="logo-light d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#fff;">Krishak<span>Inter College</span></div>
                    </div>
                    <div class="logo-dark d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                    </div>
                </a>

                <a class="navbar-toggler" data-bs-toggle="offcanvas" href="#navbarOffcanvas" role="button" aria-controls="navbarOffcanvas">
                    <i class='bx bx-menu'></i>
                </a>
                <div class="collapse navbar-collapse justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link">
                                Home
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="Index">Home </a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link active">
                                About & Gallery
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="about">About Us</a></li>
                                <li class="nav-item"><a class='nav-link active' asp-controller="Home" asp-action="DirectorMessage">Director's Message</a></li>
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Home" asp-action="contacts">
                                Contact
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    </ul>
                    <div class="others-option d-flex align-items-center">
                        <div class="option-item">
                            <div class="nav-btn">
                                <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- End Navbar Area -->

    <!-- Start Responsive Navbar Area -->
    <div class="responsive-navbar offcanvas offcanvas-end" data-bs-backdrop="static" tabindex="-1" id="navbarOffcanvas">
        <div class="offcanvas-header">
            <a class='logo d-inline-block' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="accordion" id="navbarAccordion">
                <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        Home
                    </button>
                    <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-button collapsed active" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="true" aria-controls="collapseTwo">
                        About & Gallery
                    </button>
                    <div id="collapseTwo" class="accordion-collapse collapse show" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <ul>
                                <li><a asp-controller="Home" asp-action="about">About Us</a></li>
                                <li><a class="active" asp-controller="Home" asp-action="DirectorMessage">Director's Message</a></li>
                                <li><a asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <a class='accordion-button no-after' asp-controller="Home" asp-action="contacts">
                        Contact
                    </a>
                </div>
                <div class="accordion-item">
                    <a class='accordion-button no-after' asp-controller="Account" asp-action="Login">
                        Login
                    </a>
                </div>
            </div>
            <div class="others-option">
                <div class="option-item">
                    <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                </div>
            </div>
        </div>
    </div>
    <!-- End Responsive Navbar Area -->

    <!-- Start Hero Section -->
    <div class="director-hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12 text-center" data-aos="fade-up">
                    <h1 style="font-size: 46px; font-weight: 800; line-height: 1.2; margin-bottom: 15px;">संचालक संदेश</h1>
                    <p style="font-size: 18px; opacity: 0.9; max-width: 700px; margin: 0 auto;">विद्यालय स्थापना के उद्देश्य एवं संचालक विचार</p>
                </div>
            </div>
        </div>
    </div>
    <!-- End Hero Section -->

    <!-- Start Message Desk Section -->
    <div class="container pb-100">
        <div class="director-card-premium" data-aos="fade-up">
            <div class="row">
                <!-- Left: Photo Frame & Profile Details -->
                <div class="col-lg-4 text-center mb-5 mb-lg-0" data-aos="fade-right" data-aos-delay="100">
                    <div class="pe-lg-4">
                        <div class="director-photo-frame mb-4">
                            <img src="/krasha_photo/director_Sudama_Prashad.jpeg" alt="श्री सुदामा प्रसाद सचान" />
                        </div>
                        <div class="director-title-block">
                            <h2>सुदामा प्रसाद सचान</h2>
                            <h3>संचालक</h3>
                        </div>
                    </div>
                </div>

                <!-- Right: Message and Vision Contents -->
                <div class="col-lg-8" data-aos="fade-left" data-aos-delay="200">
                    <span class="director-badge">संचालक डेस्क से</span>
                    
                    <div id="content-hindi">
                        <p class="message-p">
                            "विद्यालय स्थापना से हमारा उद्देश्य ग्रामीण परिवेश के समाज में शिक्षा का दीप प्रज्वलित कर केवल अध्यापन की व्यवस्था करना या अनुशासन स्थापित करना ही नहीं अपितु छात्रों के व्यवहार में अपेक्षित परिवर्तन लाना है और उनके सर्वांगीण विकास के लिए उचित वातावरण का निर्माण करना है। कोरोना काल में शिक्षा की अत्यधिक गिरावट हुयी है जिसको सुधारने के लिए हमे क्षेत्र वासियों को सहयोग अपेक्षित है।"
                        </p>
                        <p class="message-p">
                            "हम अपने क्षेत्र की शिक्षा को उन्नत बनाने हेतु पूर्ण कोशिश करते आ रहे है व करते रहेंगे ऐसे वातावरण का सृजन करना जिसमें विद्यार्थियों की प्रतिभा के विकास का अधिकतम अवसर उपलब्ध हो सके। इस महत्वपूर्ण लक्ष्य को ध्यान में रखते हुए हमने विद्यालय स्थापना के निम्नलिखित उद्देश्य किये:"
                        </p>
                        
                        <h4 class="objectives-title">विद्यालय स्थापना के 10 मुख्य उद्देश्य</h4>
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">01</div>
                                    <div class="objective-text">
                                        <h5>सीखने और सिखाने के लिए उचित वातावरण का निर्माण करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">02</div>
                                    <div class="objective-text">
                                        <h5>शिक्षा के उद्देश्य की पूर्ति में सहायता करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">03</div>
                                    <div class="objective-text">
                                        <h5>छात्रों में सामुदायिक भावना का विकास करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">04</div>
                                    <div class="objective-text">
                                        <h5>समाज के लिए त्याग करने वाले नागरिकों का निर्माण करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">05</div>
                                    <div class="objective-text">
                                        <h5>प्रत्येक विद्यार्थी में विद्यार्थियों की कार्य-कुशलता में वृद्धि करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">06</div>
                                    <div class="objective-text">
                                        <h5>छात्रों में सहयोगात्मक ढंग से कार्य करने की आदत डालना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">07</div>
                                    <div class="objective-text">
                                        <h5>छात्रों में स्वस्थ और वैज्ञानिक दृष्टिकोण का विकास करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">08</div>
                                    <div class="objective-text">
                                        <h5>अपनी सांस्कृतिक धरोहर से परिचित कराना तथा समाज के प्रति उत्तरदायित्व का भाव विकसित करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">09</div>
                                    <div class="objective-text">
                                        <h5>छात्रों में जनतंत्रीय आदर्शों के प्रति आस्था उत्पन्न करना तथा जनतंत्रीय जीवन-पद्धति अपनाने का अभ्यास करना।</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="objective-item">
                                    <div class="objective-icon-num">10</div>
                                    <div class="objective-text">
                                        <h5>छात्रों को शैक्षिक तथा व्यावसायिक निर्देशन देना।</h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- End Message Desk Section -->

    <!-- Start Footer Area -->
    <div class="footer-area">
        <div class="footer-widget-info ptb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index"><i class='bx bx-chevron-right'></i> Home</a></li>
                                <li><a asp-controller="Home" asp-action="about"><i class='bx bx-chevron-right'></i> About Us</a></li>
                                <li><a asp-controller="Home" asp-action="Gallery"><i class='bx bx-chevron-right'></i> Gallery</a></li>
                                <li><a asp-controller="Home" asp-action="contacts"><i class='bx bx-chevron-right'></i> Contact Us</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Account</h4>
                            <ul>
                                <li><a asp-controller="Account" asp-action="Login"><i class='bx bx-chevron-right'></i> Login</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Contact Info</h4>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 10px;"><i class="bx bxs-map me-2" style="color: var(--mainColor);"></i> Krishak Inter College Bijauli, Bijauli, Uttar Pradesh 212631, India</p>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 10px;"><i class="bx bxs-phone-call me-2" style="color: var(--mainColor);"></i> <a href="tel:+918127940079" style="color: var(--paragraphColorSecond);">+91 81279 40079</a>, <a href="tel:+919628613374" style="color: var(--paragraphColorSecond);">+91 96286 13374</a></p>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 10px;"><i class="bx bxs-envelope me-2" style="color: var(--mainColor);"></i> <a href="mailto:krishakintercollege2015@gmail.com" style="color: var(--paragraphColorSecond);">krishakintercollege2015@gmail.com</a></p>
                            <p style="color: var(--paragraphColorSecond); line-height: 1.8; margin-bottom: 0;"><i class="bx bxs-time me-2" style="color: var(--mainColor);"></i> Mon - Sat: 8:00 - 17:00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copy-right-area style-2">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-4">
                        <div class="cpr-left">
                            <p>Copyright© <a href="https://kic.in">Krishak Inter College</a>. All rights reserved. | Designed & Developed by <a href="https://corevista.tech/" target="_blank">Corevista</a></p>
                        </div>
