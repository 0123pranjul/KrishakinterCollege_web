    <title>Contact Us - Krishak Inter College</title>
    <link rel="icon" type="image/png" href="~/kic_logo.png">

    <style>
            /* Header custom styling to match index page logo */
            .kic-logo-text {
                font-size: 22px;
                font-weight: 800;
                letter-spacing: 1px;
                line-height: 1.2;
            }

            .kic-logo-text span {
                display: block;
                font-size: 11px;
                font-weight: 400;
                letter-spacing: 2px;
                text-transform: uppercase;
                opacity: 0.85;
            }

            .logo-light .kic-logo-text {
                color: #fff;
            }

            .logo-dark .kic-logo-text {
                color: #1a1a2e;
            }

            .navbar-brand .logo-light, .navbar-brand .logo-dark {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .kic-logo-img {
                width: 55px;
                height: 55px;
                object-fit: contain;
                border-radius: 12px;
                flex-shrink: 0;
                background: var(--whiteColor);
                padding: 4px;
                box-shadow: 0 4px 15px rgba(46, 202, 127, 0.35);
                border: 2px solid var(--mainColor);
                transition: all 0.3s ease;
            }
            .kic-logo-img:hover {
                transform: scale(1.08);
                box-shadow: 0 8px 25px rgba(46, 202, 127, 0.5);
                border-color: var(--blackColor);
            }
            
            /* Fix dual logo display bug by overriding d-flex's display: flex !important */
            .navbar-area.style-2 .navbar-brand .logo-dark {
                display: none !important;
            }
            .navbar-area.style-2.sticky .navbar-brand .logo-light {
                display: none !important;
            }
            .navbar-area.style-2.sticky .navbar-brand .logo-dark {
                display: flex !important;
            }

            /* Make navbar solid dark navy by default on inner page */
            .navbar-area.style-2 {
                background: #120f2d !important;
                position: relative !important;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 99;
                padding-top: 15px;
                padding-bottom: 15px;
            }

            /* Custom form controls and inputs with icons */
            .form-icon-group {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
            }
            .form-icon-group .input-icon {
                position: absolute;
                left: 16px;
                color: #94a3b8;
                font-size: 20px;
                transition: color 0.3s ease;
                z-index: 5;
                pointer-events: none;
            }
            .form-control-custom-with-icon {
                width: 100%;
                border: 1.5px solid #cbd5e1;
                padding: 12px 16px 12px 48px;
                border-radius: 10px;
                font-size: 14px;
                color: #334155;
                background-color: #fff;
                transition: all 0.3s ease;
            }
            .form-control-custom-with-icon:focus {
                border-color: var(--mainColor) !important;
                box-shadow: 0 0 0 4px rgba(46, 202, 127, 0.15) !important;
                outline: none;
            }
            .form-select-custom-with-icon {
                width: 100%;
                border: 1.5px solid #cbd5e1;
                padding: 12px 16px 12px 48px;
                border-radius: 10px;
                font-size: 14px;
                color: #334155;
                background-color: #fff;
                transition: all 0.3s ease;
                appearance: none;
                background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='none' stroke='%23475569' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3E%3C/svg%3E");
                background-repeat: no-repeat;
                background-position: right 16px center;
                background-size: 16px 12px;
            }
            .form-select-custom-with-icon:focus {
                border-color: var(--mainColor) !important;
                box-shadow: 0 0 0 4px rgba(46, 202, 127, 0.15) !important;
                outline: none;
            }
            .form-icon-group textarea.form-control-custom-with-icon {
                padding-top: 14px;
                min-height: 120px;
            }
            .form-icon-group.textarea-group .input-icon {
                top: 14px;
            }
            .form-icon-group:focus-within .input-icon {
                color: var(--mainColor);
            }

            /* Align spacing of labels */
            .form-label-custom {
                font-weight: 600;
                color: #475569;
                font-size: 14px;
                margin-bottom: 6px;
            }
            
            /* Overwrite active state for go-top to behave natively */
            .go-top.active {
                opacity: 1;
                visibility: visible;
            }

            /* Glowing map card */
            .glowing-map-card {
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 10px 30px rgba(46, 202, 127, 0.15);
                border: 2px solid rgba(46, 202, 127, 0.2);
                transition: all 0.3s ease;
                margin-bottom: 30px;
            }
            .glowing-map-card:hover {
                box-shadow: 0 15px 35px rgba(46, 202, 127, 0.3);
                border-color: var(--mainColor);
                transform: translateY(-2px);
            }

            /* Beautiful contact detail card styling */
            .info-details-card-custom {
                background: #ffffff;
                border-radius: 20px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.04);
                border: 1px solid rgba(46, 202, 127, 0.15);
                padding: 30px;
                transition: all 0.3s ease;
            }
            .info-details-card-custom:hover {
                border-color: rgba(46, 202, 127, 0.4);
                box-shadow: 0 15px 45px rgba(46, 202, 127, 0.08);
            }

            /* Info Card styling */
            .info-list-custom {
                list-style: none;
                padding-left: 0;
                margin-bottom: 0;
            }
            .info-list-custom li {
                position: relative;
                padding-left: 50px;
                margin-bottom: 25px;
                font-size: 15px;
                color: #475569;
                line-height: 1.6;
            }
            .info-list-custom li:last-child {
                margin-bottom: 0;
            }
            .info-list-custom li i {
                position: absolute;
                left: 0;
                top: 2px;
                width: 36px;
                height: 36px;
                background: rgba(46, 202, 127, 0.1);
                color: var(--mainColor);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                border: 1px solid rgba(46, 202, 127, 0.2);
            }
            .info-list-custom li a {
                color: #475569;
                transition: color 0.3s ease;
            }
            .info-list-custom li a:hover {
                color: var(--mainColor);
            }
    </style>
</head>
