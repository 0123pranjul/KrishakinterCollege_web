    <!-- Start Contact Area -->
    <div class="contact-area ptb-100" style="background: #f4f6fa;">
        <div class="container">
            <div class="row justify-content-center">
                
                <!-- Left Form Column -->
                <div class="col-lg-8" data-aos="fade-right" data-aos-delay="100">
                    <div class="contact-form-wrapper" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.04); border: 1px solid rgba(46, 202, 127, 0.15); padding: 40px;">
                        
                        <div class="header-content mb-4">
                            <h3 style="font-weight: 800; font-size: 26px; color: var(--blackColor); margin-bottom: 10px;">We'd Love To Hear From You</h3>
                            <p style="color: #64748b; font-size: 15px; line-height: 1.6;">For general questions, admissions status, or feedback, please write to us. Our desk team will connect back with you within 24 hours.</p>
                        </div>

                        <form id="contactForm">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label-custom">First Name <span style="color:red;">*</span></label>
                                        <div class="form-icon-group">
                                            <i class='bx bx-user input-icon'></i>
                                            <input type="text" id="firstName" class="form-control-custom-with-icon" placeholder="Enter first name" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label-custom">Last Name</label>
                                        <div class="form-icon-group">
                                            <i class='bx bx-user input-icon'></i>
                                            <input type="text" id="lastName" class="form-control-custom-with-icon" placeholder="Enter last name" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label-custom">Email Address <span style="color:red;">*</span></label>
                                        <div class="form-icon-group">
                                            <i class='bx bx-envelope input-icon'></i>
                                            <input type="email" id="email" class="form-control-custom-with-icon" placeholder="email@example.com" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label-custom">Phone Number <span style="color:red;">*</span></label>
                                        <div class="form-icon-group">
                                            <i class='bx bx-phone input-icon'></i>
                                            <input type="tel" id="phoneNumber" class="form-control-custom-with-icon" placeholder="10-digit phone" maxlength="10" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label class="form-label-custom">Inquiry Type</label>
                                        <div class="form-icon-group">
                                            <i class='bx bx-help-circle input-icon'></i>
                                            <select id="inquiryType" class="form-select-custom-with-icon">
                                                <option>Admission Enquiry</option>
                                                <option>General Question</option>
                                                <option>Academics & Curriculum</option>
                                                <option>Hostel & Boarding Facility</option>
                                                <option>Careers & Employment</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label class="form-label-custom">Your Message <span style="color:red;">*</span></label>
                                        <div class="form-icon-group textarea-group">
                                            <i class='bx bx-message-dots input-icon'></i>
                                            <textarea id="message" class="form-control-custom-with-icon" rows="5" placeholder="Enter your detailed query..." style="resize: none;" required></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 pt-2">
                                    <button type="submit" class="default-btn" style="border: none; padding: 14px 45px; font-size: 16px; display: inline-flex; align-items: center; gap: 8px;">
                                        <i class='bx bxs-paper-plane'></i> Submit Message
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>

                <!-- Right Sidebar Column -->
                <div class="col-lg-4 mt-5 mt-lg-0" data-aos="fade-left" data-aos-delay="200">
                    <div class="contact-sidebar-wrap">
                        
                        <!-- Map card -->
                        <div id="map" class="glowing-map-card">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3581.67308964442!2d80.1897!3d26.1422!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399c5682dae8eddd%3A0x34722182ffc6215e!2sGPRP%20Education%20Centre!5e0!3m2!1sen!2sin!4v1784098834238!5m2!1sen!2sin" width="100%" height="320" style="border:0; display: block;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                        </div>

                        <!-- Details card -->
                        <div class="info-details-card-custom">
                            <h4 style="font-weight: 800; font-size: 20px; color: var(--blackColor); margin-bottom: 20px; border-bottom: 2px solid #f1f3f7; padding-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                                <i class='bx bxs-directions' style="color: var(--mainColor);"></i> Campus Contact
                            </h4>
                            <ul class="info-list-custom">
                                <li>
                                    <i class='bx bxs-phone-call'></i>
                                    <strong>General Desk:</strong><br />
                                    <a href="tel:+919451608855">+91 99351 06067</a>
                                </li>
                                <li>
                                    <i class='bx bxs-phone-call'></i>
                                    <strong>Admissions Help:</strong><br />
                                    <a href="tel:+919452000000">+918765501933</a>
                                </li>
                                <li>
                                    <i class='bx bxs-envelope'></i>
                                    <strong>Email Address:</strong><br />
                                    <a href="mailto:kic.otp@gmail.com">kic.otp@gmail.com</a>
                                </li>
                                <li>
                                    <i class='bx bxs-map'></i>
                                    <strong>School Address:</strong><br />
                                    SH-46, Jahanabad Road, Ghatampur, Kanpur Nagar, Uttar Pradesh 209206
                                </li>
                                <li>
                                    <i class='bx bxs-time'></i>
                                    <strong>Working Hours:</strong><br />
                                    Mon - Sat: 8:00 AM - 5:00 PM
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- End Contact Area -->

