@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="hi">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Links of CSS files -->
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/aos.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/boxicons/2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/style.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/header.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <title>हमारे बारे में - कृषक इण्टर कॉलेज</title>
    <link rel="icon" type="image/png" href="~/kic_logo.png">

    <style>
        /* Shared Header Logo styling to match index/contacts page */
        .kic-logo-text {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 1px;
            line-height: 1.2;
        }

        .kic-logo-text span {
            display: block;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
            opacity: 0.85;
        }

        .logo-light .kic-logo-text {
            color: #fff;
        }

        .logo-dark .kic-logo-text {
            color: #1a1a2e;
        }

        .navbar-brand .logo-light, .navbar-brand .logo-dark {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .kic-logo-img {
            width: 55px;
            height: 55px;
            object-fit: contain;
            border-radius: 12px;
            flex-shrink: 0;
            background: var(--whiteColor);
            padding: 4px;
            box-shadow: 0 4px 15px rgba(46, 202, 127, 0.35);
            border: 2px solid var(--mainColor);
            transition: all 0.3s ease;
        }
        .kic-logo-img:hover {
            transform: scale(1.08);
            box-shadow: 0 8px 25px rgba(46, 202, 127, 0.5);
            border-color: var(--blackColor);
        }
        
        /* Fix dual logo display bug */
        .navbar-area.style-2 .navbar-brand .logo-dark {
            display: none !important;
        }
        .navbar-area.style-2.sticky .navbar-brand .logo-light {
            display: none !important;
        }
        .navbar-area.style-2.sticky .navbar-brand .logo-dark {
            display: flex !important;
        }

        /* Make navbar solid dark navy by default on inner pages */
        .navbar-area.style-2 {
            background: #120f2d !important;
            position: relative !important;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 99;
            padding-top: 15px;
            padding-bottom: 15px;
        }

        /* Premium About Us Styles */
        .about-hero-section {
            background: linear-gradient(135deg, #0b0920 0%, #151b3d 100%);
            padding: 100px 0;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .about-hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(46, 202, 127, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero-image-frame {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            border: 5px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        }
        .hero-image-frame img {
            width: 100%;
            height: auto;
            display: block;
        }

        .section-header-sub {
            color: var(--mainColor);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            display: block;
            margin-bottom: 10px;
        }

        .section-main-title {
            font-size: 32px;
            font-weight: 800;
            color: #120f2d;
            margin-bottom: 25px;
            border-left: 5px solid var(--mainColor);
            padding-left: 15px;
            text-transform: uppercase;
        }

        .history-p {
            font-size: 16px;
            line-height: 1.8;
            color: var(--paragraphColor);
            margin-bottom: 20px;
            text-align: justify;
        }

        /* Feature card highlights */
        .feature-box-card {
            background: #fff;
            padding: 25px;
            border-radius: 16px;
            border: 1px solid #f0f2f8;
            box-shadow: 0 5px 15px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
            height: 100%;
        }
        .feature-box-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(46, 202, 127, 0.1);
            border-color: rgba(46, 202, 127, 0.2);
        }
        .feature-icon-wrapper {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: rgba(46, 202, 127, 0.1);
            color: var(--mainColor);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .feature-box-card h4 {
            font-size: 18px;
            font-weight: 700;
            color: #120f2d;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        /* Rules lists styling */
        .rules-card {
            background: #fff;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            border: 1px solid #eef2fa;
            height: 100%;
        }
        .rules-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .rules-list li {
            position: relative;
            padding-left: 30px;
            margin-bottom: 15px;
            font-size: 15px;
            line-height: 1.6;
            color: var(--paragraphColor);
        }
        .rules-list li::before {
            content: "\e9a5";
            font-family: 'boxicons' !important;
            position: absolute;
            left: 0;
            top: 2px;
            color: var(--mainColor);
            font-size: 18px;
            font-weight: bold;
        }
        .rules-list.numeric {
            counter-reset: rules-counter;
        }
        .rules-list.numeric li {
            counter-increment: rules-counter;
            padding-left: 35px;
        }
        .rules-list.numeric li::before {
            content: counter(rules-counter, decimal-leading-zero);
            font-family: inherit;
            background: rgba(46, 202, 127, 0.1);
            color: var(--mainColor);
            width: 26px;
            height: 26px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            left: 0;
            top: 0;
        }

        /* Uniform card styling */
        .uniform-card {
            background: #fff;
            border-radius: 20px;
            padding: 30px;
            border: 1px solid #eef2fa;
            box-shadow: 0 8px 25px rgba(0,0,0,0.02);
        }
        .uniform-badge {
            background: #120f2d;
            color: #fff;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 700;
            border-radius: 30px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 15px;
            display: inline-block;
        }
        .uniform-section-title {
            font-size: 18px;
            font-weight: 700;
            color: #120f2d;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .uniform-section-title i {
            color: var(--mainColor);
            font-size: 22px;
        }

        /* Timetable styling */
        .timetable-table {
            width: 100%;
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #eef2fa;
            box-shadow: 0 8px 25px rgba(0,0,0,0.02);
        }
        .timetable-table th {
            background: #120f2d;
            color: #fff;
            padding: 18px;
            font-weight: 700;
            font-size: 16px;
        }
        .timetable-table td {
            padding: 18px;
            font-size: 16px;
            color: var(--paragraphColor);
            border-bottom: 1px solid #eef2fa;
        }
        .timetable-table tr:last-child td {
            border-bottom: none;
        }

        /* Leader desk styles */
        .leader-card-premium {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            padding: 40px;
            border: 1px solid #eef2fa;
        }
        .leader-badge-desk {
            display: inline-block;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 700;
            color: #fff;
            border-radius: 30px;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .leader-photo-wrapper img {
            width: 100%;
            height: auto;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border: 4px solid #fff;
        }
        .leader-signature-block {
            margin-top: 25px;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }
        .leader-sig-name {
            font-size: 18px;
            font-weight: 700;
            color: #120f2d;
        }
        .leader-sig-title {
            font-size: 13px;
            color: var(--mainColor);
            font-weight: 600;
        }

        /* Gallery Grid styling */
        .about-img-grid {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            border: 4px solid #fff;
            transition: all 0.3s ease;
        }
        .about-img-grid img {
            width: 100%;
            height: auto;
            display: block;
        }
        .about-img-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            padding: 20px;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
        }
    </style>
</head>
<body>

    <!-- Start Navbar Area -->
    <div class="navbar-area style-2">
        <div class="container">
            <nav class="navbar navbar-expand-lg">
                <a class='navbar-brand logo' asp-controller="Home" asp-action="Index">
                    <div class="logo-light d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#fff;">Krishak<span>Inter College</span></div>
                    </div>
                    <div class="logo-dark d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                    </div>
                </a>

                <a class="navbar-toggler" data-bs-toggle="offcanvas" href="#navbarOffcanvas" role="button" aria-controls="navbarOffcanvas">
                    <i class='bx bx-menu'></i>
                </a>
                <div class="collapse navbar-collapse justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link">
                                Home
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="Index">Home </a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link active">
                                About & Gallery
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link active' asp-controller="Home" asp-action="about">About Us</a></li>
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="DirectorMessage">Director's Message</a></li>
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Home" asp-action="contacts">
                                Contact
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    </ul>
                    <div class="others-option d-flex align-items-center">
                        <div class="option-item">
                            <div class="nav-btn">
                                <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- End Navbar Area -->

    <!-- Start Responsive Navbar Area -->
    <div class="responsive-navbar offcanvas offcanvas-end" data-bs-backdrop="static" tabindex="-1" id="navbarOffcanvas">
        <div class="offcanvas-header">
            <a class='logo d-inline-block' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="accordion" id="navbarAccordion">
                <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        Home
                    </button>
                    <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-button collapsed active" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="true" aria-controls="collapseTwo">
                        About & Gallery
                    </button>
                    <div id="collapseTwo" class="accordion-collapse collapse show" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <ul>
                                <li><a class="active" asp-controller="Home" asp-action="about">About Us</a></li>
                                <li><a asp-controller="Home" asp-action="DirectorMessage">Director's Message</a></li>
                                <li><a asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <a class='accordion-button no-after' asp-controller="Home" asp-action="contacts">
                        Contact
                    </a>
                </div>
                <div class="accordion-item">
                    <a class='accordion-button no-after' asp-controller="Account" asp-action="Login">
                        Login
                    </a>
                </div>
            </div>
            <div class="others-option">
                <div class="option-item">
                    <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                </div>
            </div>
        </div>
    </div>
    <!-- End Responsive Navbar Area -->

    <!-- Start About Hero Section -->
    <div class="about-hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="100">
                    <div class="hero-text-content">
                        <span class="section-header-sub">कृषक इण्टर कॉलेज</span>
                        <h1 style="font-size: 44px; font-weight: 800; line-height: 1.2; margin-bottom: 20px;">ज्ञान, संस्कार एवं आत्मनिर्भरता का संगम</h1>
                        <p style="font-size: 18px; line-height: 1.8; opacity: 0.9; margin-bottom: 30px;">
                            हमारा उद्देश्य बच्चों को न केवल शैक्षणिक रूप से सुदृढ़ बनाना है, बल्कि उन्हें नैतिक रूप से समृद्ध, अनुशासित और समाज के प्रति जिम्मेदार नागरिक बनाना है।
                        </p>
                        <a class="default-btn" asp-controller="Home" asp-action="contacts" style="background: var(--mainColor); border-color: var(--mainColor); color:#fff;">सम्पर्क करें</a>
                    </div>
                </div>
                <div class="col-lg-6 mt-5 mt-lg-0" data-aos="fade-left" data-aos-delay="200">
                    <div class="hero-image-frame">
                        <img src="/krasha_photo/WhatsApp%20Image%202026-07-23%20at%204.26.27%20PM.jpeg" alt="Krishak Inter College Building" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End About Hero Section -->

    <!-- Start History Section -->
    <div class="ptb-100">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7" data-aos="fade-right">
                    <h2 class="section-main-title">विद्यालय का संक्षिप्त इतिहास</h2>
                    <p class="history-p">
                        ईश्वर की असीम अनुकम्पा एवं पूर्वजों के आशीर्वाद से क्षेत्र की गरीब जनता के लिए बालक एवं बालिकाओं की शिक्षा हेतु इस विद्यालय की स्थापना जुलाई 1968 में तत्कालीन शिक्षाविद् ग्राम वासियों के द्वारा की गयी थी। यह विद्यालय निरंतर प्रगति के मार्ग पर चलते हुए 20 मार्च 1982 में अस्थायी मान्यता उत्तर प्रदेश सरकार द्वारा प्रदान की गयी, क्षेत्रीय जनता के विश्वास पर खरा उतरते हुए अप्रैल 1996 में कक्षा 06 से 08 तक विद्यालय को वित्तीय सहायता प्राप्त हुई। सन 2015 में हाईस्कूल की मान्यता एवं 2017 में इण्टरमीडिएट की स्थायी मान्यता प्राप्त करने में विद्यालय सफल हुआ।
                    </p>
                    <p class="history-p">
                        वर्तमान समय में कक्षा 01 से 12 तक लगभग 800 छात्र एवं छात्राएँ शिक्षा अर्जित कर रहे हैं। यहाँ सुयोग्य एवं प्रशिक्षित शिक्षकों के माध्यम से शिक्षा दी जाती है। शिक्षकों के अथक प्रयास के कारण ही इस विद्यालय का परीक्षा परिणाम शत प्रतिशत रहता है, विज्ञान के छात्रों को प्रयोगात्मक कार्य हेतु प्रयोगशाला (लैब) उपलब्ध कराये गये है। आशा है कि हम अपने लक्ष्य प्राप्ति में सफल रहेंगे जिससे हम अपने छात्र/छात्राओं को आगे बढ़ा सकें जिससे केवल छात्रों को ही नहीं, बल्कि सम्पूर्ण राष्ट्र को भी लाभ होगा।
                    </p>
                </div>
                <div class="col-lg-5 mt-5 mt-lg-0 text-center" data-aos="fade-left">
                    <div class="hero-image-frame">
                        <img src="/krasha_photo/WhatsApp%20Image%202026-07-23%20at%204.26.48%20PM.jpeg" alt="School Life Activities" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End History Section -->

    <!-- Start Features Section -->
    <div class="pb-100 alt-bg" style="background-color: #f8fafc; padding-top: 100px;">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up">
                <h2 style="font-size: 32px; font-weight: 800; color: #120f2d;">विद्यालय की विशेषतायें</h2>
                <p style="color: var(--paragraphColor); max-width: 600px; margin: 0 auto; margin-top: 10px;">कृषक इण्टर कॉलेज को एक उत्कृष्ट शिक्षण संस्थान बनाने वाले प्रमुख बिंदु:</p>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-box-card">
                        <div class="feature-icon-wrapper"><i class='bx bxs-culture'></i></div>
                        <h4>भारतीय संस्कृति आधारित शिक्षा</h4>
                        <p>भारतीय संस्कृति पर आधारित सर्वांगीण विकास हेतु आधुनिक शिक्षा की उत्तम व्यवस्था।</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-box-card">
                        <div class="feature-icon-wrapper"><i class='bx bxs-video'></i></div>
                        <h4>सीसीटीवी कैमरा निगरानी</h4>
                        <p>प्रत्येक कक्ष में दोनों ओर कैमरों के माध्यम से निगरानी कर प्रशिक्षित अध्यापकों द्वारा शिक्षण कार्य।</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-box-card">
