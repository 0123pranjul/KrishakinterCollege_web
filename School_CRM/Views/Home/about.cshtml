        <div class="offcanvas-header">
            <a class='logo d-inline-block' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="accordion" id="navbarAccordion">
                <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        Home
                    </button>
                    <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
