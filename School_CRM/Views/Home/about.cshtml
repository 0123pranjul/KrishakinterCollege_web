    <!-- End Responsive Navbar Area -->

    <!-- Start Search Modal / Offcanvas -->
    <div class="clgun offcanvas offcanvas-start" data-bs-backdrop="static" tabindex="-1" id="staticBackdrop">
        <div class="offcanvas-header">
            <a class='logo' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="search-box">
                <div class="searchwrapper"> 
                    <div class="searchbox"> 
                        <div class="row align-items-center"> 
                            <div class="col-md-9"><input type="text" class="form-control" placeholder="Search school portal..."></div> 
                            <div class="col-lg-3"> 
                                <a class="btn" href="#">Search</a> 
                            </div> 
                        </div> 
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Search Modal -->

    <!-- Start About Hero Section -->
    <div class="about-hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="100">
                    <div class="hero-text-content">
                        <span class="section-header-sub" style="color: var(--mainColor); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 10px;">About Krishak Inter College</span>
                        <h1 style="font-size: 48px; font-weight: 800; line-height: 1.2; margin-bottom: 20px;">Nurturing Conscience &amp; Shaping Excellence</h1>
                        <p style="font-size: 18px; line-height: 1.8; opacity: 0.9; margin-bottom: 30px;">At Krishak Inter College, we embrace the individuality of each learner. Through an interdisciplinary, art-integrated curriculum and enriching extra-curricular activities, we focus relentlessly on each child's ability to amaze, learn, and lead.</p>
                        <a class="default-btn" asp-controller="Home" asp-action="contacts" style="background: var(--mainColor); border-color: var(--mainColor); color:#fff;">Get in Touch</a>
                    </div>
                </div>
                <div class="col-lg-6 mt-5 mt-lg-0" data-aos="fade-left" data-aos-delay="200">
                    <div class="hero-image-frame">
                        <img src="~/Gprp/image/c1.jpeg" alt="Krishak Inter College Building" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End About Hero Section -->

    <!-- Start Mission & Values Section -->
    <div class="mission-section">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <span class="sub"><i class='bx bxs-graduation'></i> Our Purpose</span>
                <h2>OUR MISSION &amp; VALUES</h2>
            </div>
            
            <p class="mission-intro" data-aos="fade-up" data-aos-delay="100">
                The mission of the school is underpinned by the core values of: <strong>Commitment, Acceptance, Respect, Excellence, and Strength (C.A.R.E.S)</strong>. We aim to provide an encouraging environment for the children where they can bring out the best in themselves without fearing failures. The school is committed to developing self-confidence, flexibility, adaptability, and problem-solving skills in each student so that they can grow up as strong individuals with positive self-esteem, ready to face the dynamic challenges of the 21st-century world.
            </p>

            <div class="row justify-content-center mt-5 g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="value-card">
                        <div class="value-icon"><i class='bx bxs-award'></i></div>
                        <h4>Commitment</h4>
                        <p>We are dedicated to personal growth, academic excellence, and encouraging students to persist through hurdles to reach their highest potential.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="value-card">
                        <div class="value-icon"><i class='bx bxs-user-check'></i></div>
                        <h4>Acceptance</h4>
                        <p>Embracing the unique qualities, backgrounds, and talents of every child, creating an inclusive community where everyone feels valued.</p>
                    </div>
                </div>
