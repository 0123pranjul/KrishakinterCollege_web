@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zxx">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Links of CSS files -->
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/aos.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/boxicons.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/style.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/header.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <title>About Us - Krishak Inter College</title>
    <link rel="icon" type="image/png" href="~/kic_logo.png">

    <style>
        /* Shared Header Logo styling to match index/contacts page */
        .kic-logo-text {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 1px;
            line-height: 1.2;
        }

        .kic-logo-text span {
            display: block;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
            opacity: 0.85;
        }

        .logo-light .kic-logo-text {
            color: #fff;
        }

        .logo-dark .kic-logo-text {
            color: #1a1a2e;
        }

        .navbar-brand .logo-light, .navbar-brand .logo-dark {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .kic-logo-img {
            width: 55px;
            height: 55px;
            object-fit: contain;
            border-radius: 12px;
            flex-shrink: 0;
            background: var(--whiteColor);
            padding: 4px;
            box-shadow: 0 4px 15px rgba(46, 202, 127, 0.35);
            border: 2px solid var(--mainColor);
            transition: all 0.3s ease;
        }
        .kic-logo-img:hover {
            transform: scale(1.08);
            box-shadow: 0 8px 25px rgba(46, 202, 127, 0.5);
            border-color: var(--blackColor);
        }
        
        /* Fix dual logo display bug */
        .navbar-area.style-2 .navbar-brand .logo-dark {
            display: none !important;
        }
        .navbar-area.style-2.sticky .navbar-brand .logo-light {
            display: none !important;
        }
        .navbar-area.style-2.sticky .navbar-brand .logo-dark {
            display: flex !important;
        }

        /* Make navbar solid dark navy by default on inner pages */
        .navbar-area.style-2 {
            background: #120f2d !important;
            position: relative !important;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 99;
            padding-top: 15px;
            padding-bottom: 15px;
        }

        /* Premium About Us Styles */
        .about-hero-section {
            background: linear-gradient(135deg, #0b0920 0%, #151b3d 100%);
            padding: 100px 0;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .about-hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(46, 202, 127, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero-image-frame {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 3px solid rgba(46, 202, 127, 0.3);
            transition: all 0.4s ease;
        }
        .hero-image-frame:hover {
            transform: translateY(-5px);
            border-color: var(--mainColor);
            box-shadow: 0 25px 50px rgba(46, 202, 127, 0.25);
        }
        .hero-image-frame img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }

        /* Section Title Styling */
        .section-header {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 50px auto;
        }
        .section-header .sub {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(46, 202, 127, 0.1);
            color: var(--mainColor);
            padding: 6px 18px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
            border: 1px solid rgba(46, 202, 127, 0.2);
        }
        .section-header h2 {
            font-size: 36px;
            font-weight: 800;
            color: var(--blackColor);
            margin-bottom: 15px;
        }
        .section-header.text-white h2 {
            color: #fff;
        }

        /* Mission Values Cards */
        .mission-section {
            padding: 100px 0;
            background-color: var(--whiteColor);
        }
        .mission-intro {
            font-size: 18px;
            line-height: 1.8;
            color: var(--paragraphColor);
            max-width: 900px;
            margin: 0 auto 40px auto;
            text-align: center;
        }
        .value-card {
            background: var(--whiteColor);
            border-radius: 16px;
            padding: 30px 25px;
            border: 1px solid rgba(46, 202, 127, 0.15);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
            text-align: center;
            height: 100%;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }
        .value-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--mainColor), var(--blackColor));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s ease;
        }
        .value-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(46, 202, 127, 0.12);
            border-color: var(--mainColor);
        }
        .value-card:hover::after {
            transform: scaleX(1);
        }
        .value-icon {
            width: 70px;
            height: 70px;
            background: rgba(46, 202, 127, 0.1);
            color: var(--mainColor);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 20px auto;
            transition: all 0.4s ease;
        }
        .value-card:hover .value-icon {
            background: var(--mainColor);
            color: #fff;
            transform: rotateY(180deg);
        }
        .value-card h4 {
            font-size: 20px;
            font-weight: 700;
            color: var(--blackColor);
            margin-bottom: 12px;
        }
        .value-card p {
            font-size: 15px;
            color: var(--paragraphColor);
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* Learning Approach Section */
        .learning-section {
            padding: 100px 0;
            background-color: var(--secounderyColor);
        }
        .quote-box {
            background: var(--whiteColor);
            border-left: 5px solid var(--mainColor);
            padding: 30px;
            border-radius: 0 15px 15px 0;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            margin-bottom: 35px;
            position: relative;
        }
        .quote-box i.quote-icon {
            font-size: 40px;
            color: rgba(46, 202, 127, 0.2);
            position: absolute;
            top: 15px;
            right: 20px;
        }
        .quote-box blockquote {
            font-size: 18px;
            font-weight: 500;
            color: var(--blackColor);
            line-height: 1.6;
            margin-bottom: 10px;
            font-style: italic;
        }
        .quote-box span {
            font-size: 14px;
            color: var(--paragraphColor);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .approach-img-frame {
            border-radius: 20px;
            overflow: hidden;
            border: 8px solid var(--whiteColor);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            position: relative;
        }
        .approach-img-frame img {
            width: 100%;
            height: auto;
            display: block;
            transition: transform 0.5s ease;
        }
        .approach-img-frame:hover img {
            transform: scale(1.05);
        }
        .approach-list {
            list-style: none;
            padding-left: 0;
            margin-top: 25px;
        }
        .approach-list li {
            position: relative;
            padding-left: 30px;
            margin-bottom: 15px;
            font-size: 16px;
            color: var(--blackColor);
            font-weight: 500;
            line-height: 1.6;
        }
        .approach-list li i {
            position: absolute;
            left: 0;
            top: 3px;
            color: var(--mainColor);
            font-size: 20px;
        }

        /* Vision & Philosophy */
        .vision-section {
            padding: 100px 0;
            background-color: var(--whiteColor);
        }
        .philosophy-grid {
            margin-top: 40px;
        }
        .philosophy-card {
            background: var(--secounderyColor);
            border-radius: 12px;
            padding: 25px;
            height: 100%;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }
        .philosophy-card:hover {
            background: var(--whiteColor);
            border-color: rgba(46, 202, 127, 0.3);
            box-shadow: 0 10px 25px rgba(46, 202, 127, 0.08);
            transform: translateY(-3px);
        }
        .philo-num {
            font-size: 32px;
            font-weight: 800;
            color: rgba(46, 202, 127, 0.25);
            line-height: 1;
            margin-bottom: 15px;
        }
        .philosophy-card:hover .philo-num {
            color: var(--mainColor);
        }
        .philosophy-card h5 {
            font-size: 18px;
            font-weight: 700;
            color: var(--blackColor);
            margin-bottom: 10px;
        }
        .philosophy-card p {
            font-size: 14px;
            color: var(--paragraphColor);
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* Leadership Messages Sections */
        .leader-desk-section {
            padding: 100px 0;
            background-color: var(--secounderyColor);
            position: relative;
        }
        .leader-desk-section.alt-bg {
            background-color: var(--whiteColor);
        }
        .leader-card-premium {
            background: var(--whiteColor);
            border-radius: 24px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
            padding: 50px;
            border: 1px solid rgba(46, 202, 127, 0.15);
            overflow: hidden;
            position: relative;
        }
        .leader-desk-section.alt-bg .leader-card-premium {
            background: var(--secounderyColor);
            border-color: rgba(0, 33, 71, 0.08);
        }
        .leader-photo-wrapper {
            position: relative;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border: 4px solid var(--whiteColor);
        }
        .leader-photo-wrapper img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }
        .leader-badge-desk {
            display: inline-block;
            background: var(--blackColor);
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            padding: 5px 15px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }
        .leader-text-content blockquote {
            font-size: 16px;
            line-height: 1.8;
            color: var(--paragraphColor);
            position: relative;
            padding-left: 20px;
            border-left: 3px solid var(--mainColor);
            margin-bottom: 25px;
            font-style: italic;
        }
        .leader-text-content p {
            font-size: 16px;
            line-height: 1.8;
            color: var(--paragraphColor);
            margin-bottom: 20px;
        }
        .leader-signature-block {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px dashed rgba(0, 33, 71, 0.1);
        }
        .leader-sig-name {
            font-size: 20px;
            font-weight: 700;
            color: var(--blackColor);
            margin-bottom: 4px;
        }
        .leader-sig-title {
            font-size: 14px;
            color: var(--mainColor);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Image gallery grid on about page */
        .about-gallery-section {
            padding: 80px 0;
            background: #fff;
        }
        .about-img-grid {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            margin-bottom: 30px;
            height: 250px;
        }
        .about-img-grid img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .about-img-grid:hover img {
            transform: scale(1.08);
        }
        .about-img-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(0,33,71,0.8), transparent);
            opacity: 0;
            display: flex;
            align-items: flex-end;
            padding: 20px;
            transition: opacity 0.4s ease;
        }
        .about-img-grid:hover .about-img-overlay {
            opacity: 1;
        }
        .about-img-overlay span {
            color: #fff;
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>

  
