@model IEnumerable<School_CRM.Models.TblClassworkLog>
@{
    ViewData["Title"] = "Study Center Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
        color: white;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .stat-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.2s;
        overflow: hidden;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
    }
    .bg-gradient-primary { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); }
    .bg-gradient-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
    .bg-gradient-warning { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    
    .quick-link-btn {
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s;
        display: block;
        text-align: center;
        text-decoration: none;
        margin-bottom: 10px;
    }
    .quick-link-btn:hover {
        color: white;
        text-decoration: none;
        transform: translateX(5px);
    }
    .btn-ql-1 { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .btn-ql-1:hover { background: #3b82f6; }
    .btn-ql-2 { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .btn-ql-2:hover { background: #22c55e; }
    .btn-ql-3 { background: #fefce8; color: #a16207; border: 1px solid #fef08a; }
    .btn-ql-3:hover { background: #eab308; }
</style>

<div class="container-fluid mt-4 mb-5">
    <!-- Header -->
    <div class="dashboard-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 fw-bold"><i class="fas fa-graduation-cap me-2"></i>Study Center Dashboard</h3>
            <p class="mb-0 text-white-50">Overview of Materials, Assignments, and Syllabus coverage.</p>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card stat-card h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="stat-icon bg-gradient-primary shadow-sm me-3">
                        <i class="fas fa-book-reader"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-bold mb-1 text-uppercase">Study Materials</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalMaterials</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card stat-card h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="stat-icon bg-gradient-success shadow-sm me-3">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-bold mb-1 text-uppercase">Assignments</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalAssignments</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card stat-card h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="stat-icon bg-gradient-warning shadow-sm me-3">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-bold mb-1 text-uppercase">Syllabus Units</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalSyllabusUnits</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Logs Table -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-history text-primary me-2"></i>Recent Classwork Logs</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Teacher</th>
                                    <th>Class / Subject</th>
                                    <th>Topic Covered</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(!Model.Any()) {
                                    <tr><td colspan="4" class="text-center text-muted fst-italic">No recent classwork logged.</td></tr>
                                }
                                @foreach (var log in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border"><i class="far fa-calendar-alt me-1"></i>@log.LogDate.ToString("dd MMM yyyy")</span></td>
                                        <td class="fw-bold">@log.Employee?.Name</td>
                                        <td>
                                            <div>@log.Class?.ClassName</div>
                                            <small class="text-muted">@log.Subject?.SubjectName</small>
                                        </td>
                                        <td>@log.TopicCovered</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-end mt-2">
                        <a href="@Url.Action("Index", "Classwork")" class="btn btn-sm btn-link text-decoration-none fw-bold">View Full Logbook <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-bolt text-warning me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("Index", "Syllabus")" class="quick-link-btn btn-ql-1">
                        <i class="fas fa-sitemap me-2"></i> Manage Syllabus
                    </a>
                    <a href="@Url.Action("Index", "Classwork")" class="quick-link-btn btn-ql-2">
                        <i class="fas fa-pen-nib me-2"></i> Write Daily Logbook
                    </a>
                    <a href="@Url.Action("Index", "LessonPlan")" class="quick-link-btn btn-ql-3">
                        <i class="fas fa-chalkboard-teacher me-2"></i> Open Lesson Planner
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
