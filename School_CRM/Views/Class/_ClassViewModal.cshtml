@model School_CRM.Models.TblClass

<div class="row g-3">

    <!-- Class Info Card -->
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="fas fa-chalkboard me-2"></i>Class Information</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <small class="text-muted">Class ID</small>
                        <p class="fw-semibold mb-1">@Model.ClassId</p>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Class Name</small>
                        <p class="fw-semibold mb-1">@(Model.ClassName ?? "-")</p>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Status</small>
                        <p class="mb-1">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Created Date</small>
                        <p class="fw-semibold mb-1">
                            @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd-MM-yyyy hh:mm tt") : "-")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Counts -->
    <div class="col-md-6">
        <div class="card border-0 bg-light text-center">
            <div class="card-body py-3">
                <h4 class="text-primary mb-1">@Model.TblStudentSessions.Count</h4>
                <small class="text-muted">Students Enrolled</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 bg-light text-center">
            <div class="card-body py-3">
                <h4 class="text-success mb-1">@Model.TblFeeStructures.Count</h4>
                <small class="text-muted">Fee Structures</small>
            </div>
        </div>
    </div>

</div>
