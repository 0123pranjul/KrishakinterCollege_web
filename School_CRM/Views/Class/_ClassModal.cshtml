@model School_CRM.Models.TblClass

<form id="classForm"
      asp-action="CreateOrEdit"
      asp-controller="Class"
      asp-route-id="@Model.ClassId"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClassId" />

    <div class="row g-3">

        <!-- Class Name -->
        <div class="col-12">
            <label asp-for="ClassName" class="form-label fw-semibold">
                Class Name <span class="text-danger">*</span>
            </label>
            <input asp-for="ClassName"
                   class="form-control"
                   placeholder="e.g. Class 1, Class 2 ..." />
            <span asp-validation-for="ClassName" class="text-danger small"></span>
        </div>

    </div>

    <!-- Footer Buttons -->
    <div class="modal-footer px-0 pb-0 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Class
        </button>
    </div>

</form>
