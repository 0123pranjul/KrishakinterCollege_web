@{
    ViewData["Title"] = "Classes";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Class Management</h3>
                    <div class="card-tools">
                        <button class="btn btn-sm btn-primary" onclick="loadClassModal(0)">
                            <i class="fas fa-plus"></i> Add Class
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="classTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Class Name</th>
                                    <th>Created Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="classModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Class</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="classModalBody">
                @* Content loaded dynamically via AJAX *@
            </div>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Class Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="viewModalContent"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        let table;

        $(document).ready(function () {
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#classTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetAll", "Class")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    {
                        data: null, width: '8%', className: 'text-center',
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: 'className', width: '40%' },
                    { data: 'createdDate', width: '20%', className: 'text-center' },
                    {
                        data: 'status', width: '12%', className: 'text-center',
                        render: function (data) {
                            return data === 'Active'
                                ? '<span class="badge bg-success">Active</span>'
                                : '<span class="badge bg-secondary">Inactive</span>';
                        }
                    },
                    {
                        data: 'classId', width: '20%', className: 'text-center',
                        render: function (data) {
                            return `<div class="btn-group btn-group-sm">
                                        <button class="btn btn-info edit-btn" title="Edit" data-id="${data}">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-success view-btn" title="View" data-id="${data}">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-danger delete-btn" title="Delete" data-id="${data}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>`;
                        }
                    }
                ],
                language: { emptyTable: "No classes found" },
                order: [],
                columnDefs: [
                    { orderable: false, targets: 0 }
                ]
            });
        }

        // Load Create/Edit Modal
        function loadClassModal(id) {
            $.ajax({
                url: '@Url.Action("CreateOrEdit", "Class")/' + id,
                type: 'GET',
                success: function (data) {
                    $('#classModalBody').html(data);
                    $('#modalTitle').text(id == 0 ? 'Add Class' : 'Edit Class');

                    var form = $("#classForm");
                    form.removeData("validator");
                    form.removeData("unobtrusiveValidation");
                    $.validator.unobtrusive.parse(form);

                    $('#classModal').modal('show');
                },
                error: function () {
                    toastr.error("Failed to load form!");
                }
            });
        }

        // Edit Button
        $(document).on('click', '.edit-btn', function () {
            loadClassModal($(this).data('id'));
        });

        // View Button
        $(document).on('click', '.view-btn', function () {
            var id = $(this).data('id');
            $.ajax({
                url: '@Url.Action("View", "Class")/' + id,
                type: 'GET',
                success: function (data) {
                    $('#viewModalContent').html(data);
                    $('#viewModal').modal('show');
                },
                error: function () {
                    toastr.error("Failed to load details!");
                }
            });
        });

        // Delete Button
        $(document).on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            Swal.fire({
                title: 'Are you sure?',
                text: "This class will be deactivated!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete", "Class")', { id: id }, function (data) {
                        if (data.success) {
                            table.ajax.reload();
                            toastr.success(data.message);
                        } else {
                            toastr.error(data.message);
                        }
                    });
                }
            });
        });

        // Save Button
        $(document).on('click', '#btnSave', function () {
            var form = $('#classForm');
            if (form.valid()) {
                $.post(form.attr('action'), form.serialize(), function (data) {
                    if (data.success) {
                        $('#classModal').modal('hide');
                        table.ajax.reload();
                        toastr.success(data.message);
                    } else {
                        toastr.error(data.message);
                    }
                });
            }
        });
    </script>
}
