@{
    ViewData["Title"] = "Leave Management";
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div class="container-fluid">

    <!-- Stats Cards -->
    <div class="row mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold" id="statPending">-</div>
                        <div class="small">Pending</div>
                    </div>
                    <i class="fas fa-clock fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold" id="statApproved">-</div>
                        <div class="small">Approved</div>
                    </div>
                    <i class="fas fa-check-circle fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold" id="statRejected">-</div>
                        <div class="small">Rejected</div>
                    </div>
                    <i class="fas fa-times-circle fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold" id="statTotal">-</div>
                        <div class="small">Total</div>
                    </div>
                    <i class="fas fa-calendar-alt fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Card with Tabs -->
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#tabLeaves">
                        <i class="fas fa-list me-1"></i>
                        @(isAdmin ? "All Leave Applications" : "My Leaves")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#tabBalance">
                        <i class="fas fa-chart-pie me-1"></i>
                        @(isAdmin ? "Leave Balance Report" : "My Leave Balance")
                    </a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="tab-content">

                <!-- ── Tab 1: Leave Applications ── -->
                <div class="tab-pane fade show active" id="tabLeaves">

                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <!-- Filter: sirf Admin ke liye -->
                        <div>
                            @if (isAdmin)
                            {
                                <select id="filterStatus" class="form-select form-select-sm"
                                        style="width:160px">
                                    <option value="">All Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            }
                        </div>
                        <button class="btn btn-primary btn-sm" onclick="openLeaveModal(0)">
                            <i class="fas fa-plus me-1"></i>Apply Leave
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table id="leaveTable"
                               class="table table-bordered table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    @if (isAdmin)
                                    {
                                        <th>Employee</th>
                                    }
                                    <th>Leave Type</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Days</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <!-- ── Tab 2: Leave Balance ── -->
                <div class="tab-pane fade" id="tabBalance">

                    @if (!isAdmin)
                    {
                        <!-- Employee ka quick balance summary -->
                        <div class="row mb-3" id="myBalanceCards">
                            <div class="col-md-4">
                                <div class="card border-primary">
                                    <div class="card-body text-center py-2">
                                        <div class="text-muted small">Casual Leave</div>
                                        <div class="mt-1">
                                            <span class="badge bg-secondary me-1"
                                                  id="bcCasualUsed">-</span> used
                                            <span class="badge bg-success ms-2"
                                                  id="bcCasualBal">-</span> left
                                            <div class="text-muted" style="font-size:0.7rem">
                                                Max 12/year
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-warning">
                                    <div class="card-body text-center py-2">
                                        <div class="text-muted small">Sick Leave</div>
                                        <div class="mt-1">
                                            <span class="badge bg-secondary me-1"
                                                  id="bcSickUsed">-</span> used
                                            <span class="badge bg-success ms-2"
                                                  id="bcSickBal">-</span> left
                                            <div class="text-muted" style="font-size:0.7rem">
                                                Max 12/year
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-success">
                                    <div class="card-body text-center py-2">
                                        <div class="text-muted small">Earned Leave</div>
                                        <div class="mt-1">
                                            <span class="badge bg-secondary me-1"
                                                  id="bcEarnedUsed">-</span> used
                                            <span class="badge bg-success ms-2"
                                                  id="bcEarnedBal">-</span> left
                                            <div class="text-muted" style="font-size:0.7rem">
                                                Max 15/year
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table id="balanceTable"
                               class="table table-bordered table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    @if (isAdmin)
                                    {
                                        <th>Code</th>
                                        <th>Employee</th>
                                    }
                                    <th class="text-center">Casual Used</th>
                                    <th class="text-center">Casual Bal</th>
                                    <th class="text-center">Sick Used</th>
                                    <th class="text-center">Sick Bal</th>
                                    <th class="text-center">Earned Used</th>
                                    <th class="text-center">Earned Bal</th>
                                    <th class="text-center">Total Used</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ══ Leave Modal ══ -->
<div class="modal fade" id="leaveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="leaveModalTitle">Apply Leave</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="leaveId">

                @if (isAdmin)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Employee <span class="text-danger">*</span>
                        </label>
                        <select id="leaveEmployee" class="form-select">
                            <option value="">-- Select Employee --</option>
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Leave Type <span class="text-danger">*</span>
                    </label>
                    <select id="leaveType" class="form-select">
                        <option value="CasualLeave">Casual Leave (Max 12/year)</option>
                        <option value="SickLeave">Sick Leave (Max 12/year)</option>
                        <option value="EarnedLeave">Earned Leave (Max 15/year)</option>
                        <option value="MaternityLeave">Maternity Leave</option>
                        <option value="UnpaidLeave">Unpaid Leave</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">
                            From <span class="text-danger">*</span>
                        </label>
                        <input type="date" id="leaveFrom" class="form-control">
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">
                            To <span class="text-danger">*</span>
                        </label>
                        <input type="date" id="leaveTo" class="form-control">
                    </div>
                </div>

                <!-- Days count -->
                <div class="alert alert-info py-2 mb-2" id="daysInfo" style="display:none">
                    <i class="fas fa-info-circle me-1"></i>
                    Total Days: <strong id="totalDaysCount">0</strong>
                </div>

                <!-- Balance info (Employee only) -->
                <div class="alert alert-secondary py-2 mb-0"
                     id="balanceInfo" style="display:none">
                    <i class="fas fa-chart-pie me-1"></i>
                    <span id="balanceText"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="saveLeave()">
                    <i class="fas fa-save me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        const isAdmin = @Json.Serialize(isAdmin);
        let leaveTable, balanceTable;
        let myBalance = {};

        $(document).ready(function () {
            loadLeaveTable();

            if (isAdmin) {
                loadEmployees();
            } else {
                loadMyBalance();
            }

            // Balance tab — lazy load
            $('a[href="#tabBalance"]').on('shown.bs.tab', function () {
                if (!balanceTable) loadBalanceTable();
            });

            $('#leaveFrom, #leaveTo').on('change', calcDays);
            $('#leaveType').on('change', showBalanceInfo);

            // Filter — sirf admin ke liye exist karta hai
            if (isAdmin) {
                $('#filterStatus').on('change', function () {
                    leaveTable.column(5).search(this.value).draw();
                });
            }
        });

        // ── Balance load (Employee) ──────────────────────────
        function loadMyBalance() {
            $.get('@Url.Action("GetLeaveBalance", "Leave")', function (res) {
                if (!res.data || !res.data.length) return;
                const b = res.data[0];
                myBalance = {
                    CasualLeave:  b.casualBalance,
                    SickLeave:    b.sickBalance,
                    EarnedLeave:  b.earnedBalance
                };
                // Balance tab cards update karo
                $('#bcCasualUsed').text(b.casualUsed);
                $('#bcCasualBal').text(b.casualBalance)
                    .removeClass('bg-success bg-danger')
                    .addClass(b.casualBalance > 0 ? 'bg-success' : 'bg-danger');
                $('#bcSickUsed').text(b.sickUsed);
                $('#bcSickBal').text(b.sickBalance)
                    .removeClass('bg-success bg-danger')
                    .addClass(b.sickBalance > 0 ? 'bg-success' : 'bg-danger');
                $('#bcEarnedUsed').text(b.earnedUsed);
                $('#bcEarnedBal').text(b.earnedBalance)
                    .removeClass('bg-success bg-danger')
                    .addClass(b.earnedBalance > 0 ? 'bg-success' : 'bg-danger');
            });
        }

        function showBalanceInfo() {
            if (isAdmin) return;
            const type = $('#leaveType').val();
            const bal  = myBalance[type];
            if (bal !== undefined) {
                const label = type.replace('Leave', ' Leave');
                const cls   = bal > 0 ? 'alert-info' : 'alert-danger';
                $('#balanceInfo')
                    .removeClass('alert-info alert-secondary alert-danger')
                    .addClass(cls);
                $('#balanceText').html(
                    `Remaining <strong>${label}</strong>: <strong>${bal}</strong> days`
                );
                $('#balanceInfo').show();
            } else {
                $('#balanceInfo').hide();
            }
        }

        function loadEmployees() {
            $.get('@Url.Action("GetEmployees", "Leave")', function (data) {
                data.forEach(e =>
                    $('#leaveEmployee').append(
                        `<option value="${e.id}">${e.employeeCode} - ${e.name}</option>`
                    )
                );
            });
        }

        function calcDays() {
            const from = $('#leaveFrom').val();
            const to   = $('#leaveTo').val();
            if (from && to && to >= from) {
                const diff = (new Date(to) - new Date(from)) / (1000*60*60*24) + 1;
                $('#totalDaysCount').text(diff);
                $('#daysInfo').show();
            } else {
                $('#daysInfo').hide();
            }
            showBalanceInfo();
        }

        // ── Leave Table ──────────────────────────────────────
        function loadLeaveTable() {
            if ($.fn.DataTable.isDataTable('#leaveTable'))
                $('#leaveTable').DataTable().destroy();

            let cols = [];

            if (isAdmin) {
                cols.push({
                    data: null, width: '18%',
                    render: d =>
                        `<strong>${d.employeeCode||''}</strong><br>
                         <small class="text-muted">${d.employeeName||''}</small>`
                });
            }

            cols = cols.concat([
                {
                    data: 'leaveType', width: '14%',
                    render: d => {
                        const map = {
                            'CasualLeave':    ['bg-primary',           'Casual'],
                            'SickLeave':      ['bg-warning text-dark', 'Sick'],
                            'EarnedLeave':    ['bg-success',           'Earned'],
                            'MaternityLeave': ['bg-info',              'Maternity'],
                            'UnpaidLeave':    ['bg-secondary',         'Unpaid']
                        };
                        const c = map[d] || ['bg-secondary', d];
                        return `<span class="badge ${c[0]}">${c[1]}</span>`;
                    }
                },
                { data: 'fromDate', width: '11%' },
                { data: 'toDate',   width: '11%' },
                {
                    data: 'totalDays', width: '8%', className: 'text-center fw-bold',
                    render: d => `${d} days`
                },
                {
                    data: 'status', width: '12%', className: 'text-center',
                    render: d => {
                        const map = {
                            'Pending':  'bg-warning text-dark',
                            'Approved': 'bg-success',
                            'Rejected': 'bg-danger'
                        };
                        return `<span class="badge ${map[d]||'bg-secondary'}">${d}</span>`;
                    }
                },
                {
                    data: null, orderable: false, className: 'text-center',
                    render: (d, t, row) => {
                        let btns = '';

                        if (row.status === 'Pending') {
                            btns += `<button class="btn btn-info btn-sm me-1"
                                             onclick="openLeaveModal(${row.id})"
                                             title="Edit">
                                         <i class="fas fa-edit"></i></button>`;
                        }

                        if (isAdmin && row.status === 'Pending') {
                            btns += `
                                <button class="btn btn-success btn-sm me-1"
                                        onclick="updateStatus(${row.id},'Approved')"
                                        title="Approve">
                                    <i class="fas fa-check"></i></button>
                                <button class="btn btn-danger btn-sm me-1"
                                        onclick="updateStatus(${row.id},'Rejected')"
                                        title="Reject">
                                    <i class="fas fa-times"></i></button>`;
                        }

                        if (row.status === 'Pending') {
                            btns += `<button class="btn btn-secondary btn-sm"
                                             onclick="deleteLeave(${row.id})"
                                             title="Delete">
                                         <i class="fas fa-trash"></i></button>`;
                        }

                        return btns || '<span class="text-muted small">-</span>';
                    }
                }
            ]);

            // Order: Admin = fromDate col 2, Employee = fromDate col 1
            const orderCol = isAdmin ? 2 : 1;

            leaveTable = $('#leaveTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetAll", "Leave")',
                    dataSrc: d => d.data || []
                },
                columns: cols,
                order: [[orderCol, 'desc']],
                pageLength: 25,
                language: {
                    emptyTable: "No leave records found",
                    search: "Search:"
                },
                drawCallback: function () {
                    const data = this.api().data().toArray();
                    $('#statPending').text(
                        data.filter(r => r.status === 'Pending').length);
                    $('#statApproved').text(
                        data.filter(r => r.status === 'Approved').length);
                    $('#statRejected').text(
                        data.filter(r => r.status === 'Rejected').length);
                    $('#statTotal').text(data.length);
                }
            });
        }

        // ── Balance Table ────────────────────────────────────
        function loadBalanceTable() {
            if ($.fn.DataTable.isDataTable('#balanceTable'))
                $('#balanceTable').DataTable().destroy();

            let cols = [];
            if (isAdmin) {
                cols.push({ data: 'employeeCode', width: '10%' });
                cols.push({ data: 'employeeName', width: '18%' });
            }

            cols = cols.concat([
                {
                    data: 'casualUsed', className: 'text-center',
                    render: d => `<span class="badge bg-secondary">${d}</span>`
                },
                {
                    data: 'casualBalance', className: 'text-center',
                    render: d =>
                        `<span class="badge ${d > 0 ? 'bg-success' : 'bg-danger'}">${d}</span>`
                },
                {
                    data: 'sickUsed', className: 'text-center',
                    render: d => `<span class="badge bg-secondary">${d}</span>`
                },
                {
                    data: 'sickBalance', className: 'text-center',
                    render: d =>
                        `<span class="badge ${d > 0 ? 'bg-success' : 'bg-danger'}">${d}</span>`
                },
                {
                    data: 'earnedUsed', className: 'text-center',
                    render: d => `<span class="badge bg-secondary">${d}</span>`
                },
                {
                    data: 'earnedBalance', className: 'text-center',
                    render: d =>
                        `<span class="badge ${d > 0 ? 'bg-success' : 'bg-danger'}">${d}</span>`
                },
                {
                    data: 'totalUsed', className: 'text-center fw-bold',
                    render: d =>
                        `<span class="badge bg-primary">${d} days</span>`
                }
            ]);

            balanceTable = $('#balanceTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetLeaveBalance", "Leave")',
                    dataSrc: d => d.data || []
                },
                columns: cols,
                order: [[0, 'asc']],
                language: {
                    emptyTable: "No balance data",
                    search: "Search:"
                }
            });
        }

        // ── Modal Open ───────────────────────────────────────
        function openLeaveModal(id) {
            $('#leaveId').val(0);
            $('#leaveType').val('CasualLeave');
            $('#leaveFrom').val('');
            $('#leaveTo').val('');
            $('#daysInfo').hide();
            $('#balanceInfo').hide();
            if (isAdmin) $('#leaveEmployee').val('');
            $('#leaveModalTitle').text(id === 0 ? 'Apply Leave' : 'Edit Leave');

            if (id > 0) {
                $.get('@Url.Action("GetById", "Leave")/' + id, function (data) {
                    if (data.error) { toastr.error('Unauthorized!'); return; }
                    $('#leaveId').val(data.id);
                    $('#leaveType').val(data.leaveType);
                    $('#leaveFrom').val(data.fromDate);
                    $('#leaveTo').val(data.toDate);
                    if (isAdmin) $('#leaveEmployee').val(data.employeeId);
                    calcDays();
                    showBalanceInfo();
                });
            } else {
                // Naya modal — balance info turant dikhao
                showBalanceInfo();
            }

            new bootstrap.Modal(document.getElementById('leaveModal')).show();
        }

        // ── Save ─────────────────────────────────────────────
        function saveLeave() {
            const from = $('#leaveFrom').val();
            const to   = $('#leaveTo').val();

            if (isAdmin && !$('#leaveEmployee').val()) {
                toastr.warning('Select employee!'); return;
            }
            if (!from) { toastr.warning('Select from date!'); return; }
            if (!to)   { toastr.warning('Select to date!');   return; }
            if (to < from) {
                toastr.warning('To date must be after From date!'); return;
            }

            const payload = {
                id:        parseInt($('#leaveId').val()) || 0,
                employeeId: isAdmin
                    ? parseInt($('#leaveEmployee').val()) : 0,
                leaveType: $('#leaveType').val(),
                fromDate:  from,
                toDate:    to
            };

            $.ajax({
                url: '@Url.Action("Save", "Leave")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        bootstrap.Modal.getInstance(
                            document.getElementById('leaveModal')).hide();
                        leaveTable.ajax.reload();
                        if (!isAdmin) {
                            loadMyBalance();
                            if (balanceTable) balanceTable.ajax.reload();
                        }
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function () { toastr.error('Error saving!'); }
            });
        }

        // ── Approve / Reject ─────────────────────────────────
        function updateStatus(id, status) {
            const isApprove = status === 'Approved';
            Swal.fire({
                title: `${isApprove ? 'Approve' : 'Reject'} Leave?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: isApprove ? '#28a745' : '#dc3545',
                confirmButtonText: `Yes, ${status}!`
            }).then(res => {
                if (!res.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("UpdateStatus", "Leave")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ id, status }),
                    success: function (r) {
                        if (r.success) {
                            toastr.success(r.message);
                            leaveTable.ajax.reload();
                        } else {
                            toastr.error(r.message);
                        }
                    },
                    error: function () { toastr.error('Error!'); }
                });
            });
        }

        // ── Delete ───────────────────────────────────────────
        function deleteLeave(id) {
            Swal.fire({
                title: 'Delete Leave?',
                text: 'This cannot be undone!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Yes, Delete!'
            }).then(res => {
                if (!res.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("Delete", "Leave")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(id),
                    success: function (r) {
                        if (r.success) {
                            toastr.success(r.message);
                            leaveTable.ajax.reload();
                            if (!isAdmin) loadMyBalance();
                        } else {
                            toastr.error(r.message);
                        }
                    },
                    error: function () { toastr.error('Error!'); }
                });
            });
        }
    </script>
}