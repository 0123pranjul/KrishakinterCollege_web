@{
    ViewData["Title"] = "Exam Weightage";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-3">
            <div>
                <h5 class="mb-0 fw-semibold text-dark"><i class="fas fa-balance-scale me-2 text-secondary"></i>Exam Weightage</h5>
                <small class="text-muted">Set percentage weightage for each exam in a session</small>
            </div>
            <button class="btn btn-secondary btn-sm px-3" onclick="loadModal(0)">
                <i class="fas fa-plus me-1"></i> Add Weightage
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="ewTable" class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th width="8%">#</th>
                            <th>Session</th>
                            <th>Exam</th>
                            <th width="15%" class="text-center">Weight %</th>
                            <th width="12%" class="text-center">Status</th>
                            <th width="10%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-balance-scale me-2"></i>Add Weightage</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="ewModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        let table;
        $(document).ready(() => {
            table = $('#ewTable').DataTable({
                ajax: { url: '@Url.Action("GetAll","ExamWeightage")', type: 'GET', dataSrc: 'data' },
                columns: [
                    { data: 'id', className: 'text-center' },
                    { data: 'sessionName' },
                    { data: 'examName' },
                    { data: 'weightPct', className: 'text-center fw-bold fs-5' },
                    { data: 'status', className: 'text-center', render: d => d === 'Active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>' },
                    {
                        data: 'id', className: 'text-center', orderable: false,
                        render: id => `<button class="btn btn-sm btn-outline-primary me-1" onclick="loadModal(${id})"><i class="fas fa-edit"></i></button>
                                       <button class="btn btn-sm btn-outline-danger" onclick="deleteRecord(${id})"><i class="fas fa-trash"></i></button>`
                    }
                ]
            });
        });

        function loadModal(id) {
            $('#modalTitle').html(id === 0 ? '<i class="fas fa-plus me-2"></i>Add Weightage' : '<i class="fas fa-edit me-2"></i>Edit Weightage');
            $.get('@Url.Action("CreateOrEdit","ExamWeightage")', { id }, html => {
                $('#ewModalBody').html(html);
                $('#ewModal').modal('show');
                $('#btnSave').off('click').on('click', () => {
                    $.post($('#ewForm').attr('action'), $('#ewForm').serialize(), res => {
                        if (res.success) { $('#ewModal').modal('hide'); table.ajax.reload(); toastr.success(res.message); }
                        else toastr.error(res.message);
                    });
                });
            });
        }

        function deleteRecord(id) {
            Swal.fire({ title: 'Delete Weightage?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes!' })
                .then(r => { if (r.isConfirmed) $.post('@Url.Action("Delete","ExamWeightage")', { id }, res => { if (res.success) { table.ajax.reload(); toastr.success(res.message); } else toastr.error(res.message); }); });
        }
    </script>
}
