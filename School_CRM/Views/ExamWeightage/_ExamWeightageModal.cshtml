@model School_CRM.Models.TblExamWeightage

<form id="ewForm" asp-action="CreateOrEdit" asp-controller="ExamWeightage" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SessionId" class="form-label fw-semibold">Session <span class="text-danger">*</span></label>
            <select asp-for="SessionId" class="form-select" asp-items="@(new SelectList(ViewBag.Sessions, "SessionId", "SessionName"))" required>
                <option value="">-- Select Session --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="ExamId" class="form-label fw-semibold">Exam <span class="text-danger">*</span></label>
            <select asp-for="ExamId" class="form-select" asp-items="@(new SelectList(ViewBag.Exams, "ExamId", "ExamName"))" required>
                <option value="">-- Select Exam --</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="WeightPct" class="form-label fw-semibold">Weight % <span class="text-danger">*</span></label>
            <div class="input-group">
                <input asp-for="WeightPct" class="form-control" type="number" step="0.01" min="1" max="100" required />
                <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">e.g. Mid Term = 40%, Final Term = 60%</small>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" @(Model.IsActive == true ? "checked" : "") />
                <label class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="modal-footer px-0 pb-0 mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Weightage</button>
    </div>
</form>
