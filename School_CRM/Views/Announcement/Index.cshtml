@{
    ViewData["Title"] = "Motivational Quote";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-3">
            <div>
                <h5 class="mb-0 fw-semibold text-dark"><i class="fas fa-bullhorn me-2 text-warning"></i>Motivational Quote</h5>
                <small class="text-muted">Thought of the Day to classes or all students</small>
            </div>
            <button class="btn btn-warning btn-sm px-3 text-dark" onclick="loadModal(0)">
                <i class="fas fa-plus me-1"></i> Add Thought
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="announcementTable" class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th width="6%">#</th>
                            <th>Title</th>
                            <th width="15%" class="text-center">Scope</th>
                            <th width="12%" class="text-center">Type</th>
                            <th width="10%" class="text-center">Status</th>
                            <th width="12%" class="text-center">Created</th>
                            <th width="10%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="announcementModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-bullhorn me-2"></i>Add Thought</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="announcementModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        let table;
        $(document).ready(() => {
            table = $('#announcementTable').DataTable({
                ajax: { url: '@Url.Action("GetAll","Announcement")', type: 'GET', dataSrc: 'data' },
                columns: [
                    { data: 'announcementId', className: 'text-center' },
                    { data: 'title' },
                    { data: 'scope', className: 'text-center' },
                    { data: 'isGlobal', className: 'text-center', render: d => d === 'Global' ? '<span class="badge bg-primary">Global</span>' : '<span class="badge bg-info">Targeted</span>' },
                    { data: 'status', className: 'text-center', render: d => d === 'Active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>' },
                    { data: 'createdDate', className: 'text-center' },
                    {
                        data: 'announcementId', className: 'text-center', orderable: false,
                        render: id => `<button class="btn btn-sm btn-outline-primary me-1" onclick="loadModal(${id})"><i class="fas fa-edit"></i></button>
                                       <button class="btn btn-sm btn-outline-danger" onclick="deleteRecord(${id})"><i class="fas fa-trash"></i></button>`
                    }
                ]
            });
        });

        function loadModal(id) {
            $('#modalTitle').html(id === 0 ? '<i class="fas fa-plus me-2"></i>Add Announcement' : '<i class="fas fa-edit me-2"></i>Edit Announcement');
            $.get('@Url.Action("CreateOrEdit","Announcement")', { id }, html => {
                $('#announcementModalBody').html(html);
                $('#announcementModal').modal('show');
                $('#btnSave').off('click').on('click', () => {
                    $.post($('#announcementForm').attr('action'), $('#announcementForm').serialize(), res => {
                        if (res.success) { $('#announcementModal').modal('hide'); table.ajax.reload(); toastr.success(res.message); }
                        else toastr.error(res.message);
                    });
                });
            });
        }

        function deleteRecord(id) {
            Swal.fire({ title: 'Delete Announcement?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes!' })
                .then(r => { if (r.isConfirmed) $.post('@Url.Action("Delete","Announcement")', { id }, res => { if (res.success) { table.ajax.reload(); toastr.success(res.message); } else toastr.error(res.message); }); });
        }
    </script>
}
