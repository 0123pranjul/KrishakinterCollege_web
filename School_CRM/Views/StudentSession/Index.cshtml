@{
    ViewData["Title"] = "Student Session Mapping";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-semibold mb-0">
                <i class="fas fa-users-cog me-2 text-primary"></i>Student Session Mapping
            </h5>
            <small class="text-muted">Students aur unki sessions ek nazar mein dekhein</small>
        </div>
        <button class="btn btn-primary btn-sm px-3" onclick="openMappingModal(0)">
            <i class="fas fa-plus me-1"></i> Add Mapping
        </button>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-3">
        <div class="col-3">
            <div class="card border-0 bg-light text-center py-3">
                <div class="text-muted small">Total Students</div>
                <div class="fw-semibold fs-4" id="statStudents">—</div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 bg-light text-center py-3">
                <div class="text-muted small">Total Mappings</div>
                <div class="fw-semibold fs-4" id="statMappings">—</div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 bg-light text-center py-3">
                <div class="text-muted small">Sessions</div>
                <div class="fw-semibold fs-4" id="statSessions">—</div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 bg-light text-center py-3">
                <div class="text-muted small">Classes</div>
                <div class="fw-semibold fs-4" id="statClasses">—</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <input type="text" id="searchBox" class="form-control form-control-sm"
               style="max-width:220px" placeholder="Student naam ya roll…" oninput="renderCards()">
        <select id="fSession" class="form-select form-select-sm w-auto" onchange="renderCards()">
            <option value="">Sabhi Sessions</option>
        </select>
        <select id="fClass" class="form-select form-select-sm w-auto" onchange="renderCards()">
            <option value="">Sabhi Classes</option>
        </select>
        <select id="fSection" class="form-select form-select-sm w-auto" onchange="renderCards()">
            <option value="">Sabhi Sections</option>
        </select>
        <button class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">
            <i class="fas fa-redo me-1"></i>Reset
        </button>
    </div>

    <!-- Card Grid -->
    <div id="mainGrid">
        <div class="text-center text-muted py-5">
            <i class="fas fa-spinner fa-spin me-2"></i>Loading…
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="mappingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-link me-2"></i>Add Student Session Mapping
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="mappingModalBody">
                <div class="text-center py-3">
                    <i class="fas fa-spinner fa-spin"></i> Loading…
                </div>
            </div>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-eye me-2"></i>Mapping Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="viewModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        .stu-card { transition: box-shadow 0.18s; border-radius: 10px; }
        .stu-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.09); }
        .stu-avatar { width: 36px; height: 36px; border-radius: 50%; background: #cff4fc; color: #055160; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; flex-shrink: 0; }
        .info-pill { background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 20px; padding: 2px 10px; font-size: 11px; display: inline-flex; align-items: center; gap: 4px; color: #6c757d; }
        .session-label { font-size: 12px; font-weight: 600; color: #6c757d; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
        .session-badge { background: #e9ecef; padding: 1px 8px; border-radius: 20px; font-size: 11px; font-weight: 400; }
    </style>

    <script>
        let allData = [];

        $(document).ready(() => loadData());

        function loadData() {
            $.get('@Url.Action("GetAll","StudentSession")', res => {
                allData = res.data;
                buildFilters();
                renderCards();
                updateStats();
            });
        }

        function buildFilters() {
            const sessions = [...new Set(allData.map(d => d.sessionName))];
            const classes  = [...new Set(allData.map(d => d.className))];
            const sections = [...new Set(allData.map(d => d.sectionName))];

            const fSess = $('#fSession');
            const fCls  = $('#fClass');
            const fSec  = $('#fSection');

            fSess.html('<option value="">Sabhi Sessions</option>');
            fCls .html('<option value="">Sabhi Classes</option>');
            fSec .html('<option value="">Sabhi Sections</option>');

            sessions.forEach(s => fSess.append(`<option>${s}</option>`));
            classes .forEach(c => fCls .append(`<option>${c}</option>`));
            sections.forEach(s => fSec .append(`<option>${s}</option>`));
        }

        function updateStats() {
            $('#statStudents').text(new Set(allData.map(d => d.studentName)).size);
            $('#statMappings').text(allData.length);
            $('#statSessions').text(new Set(allData.map(d => d.sessionName)).size);
            $('#statClasses') .text(new Set(allData.map(d => d.className)).size);
        }

        function initials(name) {
            return (name || '?').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
        }

        function renderCards() {
            const q   = $('#searchBox').val().toLowerCase();
            const fs  = $('#fSession').val();
            const fc  = $('#fClass').val();
            const fn  = $('#fSection').val();

            let filtered = allData.filter(d => {
                if (q  && !d.studentName.toLowerCase().includes(q) && !(d.rollNo||'').toLowerCase().includes(q)) return false;
                if (fs && d.sessionName !== fs) return false;
                if (fc && d.className   !== fc) return false;
                if (fn && d.sectionName !== fn) return false;
                return true;
            });

            if (!filtered.length) {
                $('#mainGrid').html('<div class="text-center text-muted py-5">Koi result nahi mila.</div>');
                return;
            }

            // Group by session
            const bySession = {};
            filtered.forEach(d => {
                if (!bySession[d.sessionName]) bySession[d.sessionName] = [];
                bySession[d.sessionName].push(d);
            });

            let html = '';
            Object.entries(bySession).forEach(([sess, items]) => {
                const cards = items.map(d => `
                    <div class="col-md-6 col-xl-4">
                        <div class="card stu-card h-100">
                            <div class="card-header bg-white d-flex align-items-center gap-2 py-2">
                                <div class="stu-avatar">${initials(d.studentName)}</div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold" style="font-size:13px">${d.studentName}</div>
                                    <div class="text-muted" style="font-size:11px">Roll: ${d.rollNo || '—'}</div>
                                </div>
                                <span class="badge bg-success" style="font-size:10px">Active</span>
                            </div>
                            <div class="card-body py-2 d-flex flex-wrap gap-1">
                                <span class="info-pill"><i class="fas fa-school" style="font-size:9px"></i>${d.className}</span>
                                <span class="info-pill"><i class="fas fa-door-open" style="font-size:9px"></i>Sec ${d.sectionName}</span>
                                <span class="info-pill"><i class="fas fa-calendar" style="font-size:9px"></i>${d.sessionName}</span>
                            </div>
                            <div class="card-footer bg-light d-flex justify-content-between align-items-center py-2">
                                <small class="text-muted">${d.createdDate}</small>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-success" onclick="viewMapping(${d.id})" title="View">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary" onclick="openMappingModal(${d.id})" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteMapping(${d.id})" title="Remove">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>`).join('');

                html += `
                    <div class="mb-4">
                        <div class="session-label">
                            <i class="fas fa-calendar-alt"></i>
                            ${sess}
                            <span class="session-badge">${items.length} student${items.length !== 1 ? 's' : ''}</span>
                        </div>
                        <div class="row g-3">${cards}</div>
                    </div>`;
            });

            $('#mainGrid').html(html);
        }

        function resetFilters() {
            $('#searchBox').val('');
            $('#fSession, #fClass, #fSection').val('');
            renderCards();
        }

        function openMappingModal(id) {
            $('#modalTitle').html(id === 0
                ? '<i class="fas fa-link me-2"></i>Add Student Session Mapping'
                : '<i class="fas fa-edit me-2"></i>Edit Student Session Mapping');

            $.get('@Url.Action("CreateOrEdit","StudentSession")', { id }, html => {
                $('#mappingModalBody').html(html);
                $('#mappingModal').modal('show');

                var form = $('#mappingForm');
                form.removeData('validator').removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            });
        }

        function viewMapping(id) {
            $.get('@Url.Action("View","StudentSession")', { id }, html => {
                $('#viewModalBody').html(html);
                $('#viewModal').modal('show');
            });
        }

        function deleteMapping(id) {
            Swal.fire({
                title: 'Remove Mapping?',
                text: 'Student is unmapped from this session.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Haan, hatao!'
            }).then(r => {
                if (r.isConfirmed) {
                    $.post('@Url.Action("Delete","StudentSession")', { id }, res => {
                        if (res.success) { toastr.success(res.message); loadData(); }
                        else toastr.error(res.message);
                    });
                }
            });
        }

        // Save from modal
        $(document).on('click', '#btnSave', function () {
            var form = $('#mappingForm');
            if (!form.valid()) return;
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving…');
            $.post(form.attr('action'), form.serialize(), res => {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Mapping');
                if (res.success) {
                    $('#mappingModal').modal('hide');
                    toastr.success(res.message);
                    loadData();
                } else {
                    toastr.error(res.message);
                }
            });
        });
    </script>
}