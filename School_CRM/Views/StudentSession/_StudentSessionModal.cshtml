@model School_CRM.Models.TblStudentSession

@{
    var students = ViewBag.Students as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var sessions = ViewBag.Sessions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var classes  = ViewBag.Classes  as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var sections = ViewBag.Sections as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    bool isEdit  = Model.Id > 0;
}

<style>
    .step-bar { display: flex; border-bottom: 1px solid #dee2e6; margin: -1rem -1rem 1.25rem; padding: 0 1rem; }
    .step-tab { flex: 1; padding: 10px 0; text-align: center; font-size: 12px; font-weight: 500;
                color: #6c757d; border-bottom: 2px solid transparent; display: flex;
                align-items: center; justify-content: center; gap: 6px; }
    .step-tab.active { color: #0d6efd; border-bottom-color: #0d6efd; }
    .step-tab.done   { color: #198754; border-bottom-color: #198754; }
    .step-num { width: 20px; height: 20px; border-radius: 50%; background: #f0f0f0;
                font-size: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .step-tab.active .step-num { background: #cfe2ff; color: #0d6efd; }
    .step-tab.done   .step-num { background: #d1e7dd; color: #198754; }
    .pane { display: none; }
    .pane.active { display: block; }
    .student-preview-card { background: #cff4fc; border-radius: 10px; padding: 14px 16px;
                             display: flex; align-items: center; gap: 14px; margin-top: 12px; }
    .stu-avatar { width: 48px; height: 48px; border-radius: 50%; background: #9eeaf9;
                  color: #055160; display: flex; align-items: center; justify-content: center;
                  font-size: 16px; font-weight: 600; flex-shrink: 0; }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
    .summary-item { background: #f8f9fa; border-radius: 8px; padding: 10px 14px; }
    .summary-label { font-size: 11px; color: #6c757d; margin-bottom: 3px; }
    .summary-val { font-size: 13px; font-weight: 600; color: #212529; }
    .summary-student { background: #cff4fc; border-radius: 10px; padding: 12px 16px;
                        display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .section-head { font-size: 11px; font-weight: 600; color: #6c757d; text-transform: uppercase;
                    letter-spacing: 0.5px; margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
    .section-head::after { content: ''; flex: 1; height: 1px; background: #e9ecef; }
    .wizard-footer { display: flex; justify-content: space-between; align-items: center;
                     border-top: 1px solid #dee2e6; margin: 1.25rem -1rem -1rem; padding: 12px 1rem 0; }
</style>

<form id="mappingForm"
      asp-action="CreateOrEdit"
      asp-controller="StudentSession"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @if (!isEdit)
    {
        <!-- ── WIZARD MODE (Add) ──────────────────────────────── -->
        <div class="step-bar" id="stepBar">
            <div class="step-tab active" id="tab1"><div class="step-num">1</div> Student</div>
            <div class="step-tab"        id="tab2"><div class="step-num">2</div> Academic Info</div>
            <div class="step-tab"        id="tab3"><div class="step-num">3</div> Confirm</div>
        </div>

        <!-- Step 1 -->
        <div class="pane active" id="pane1">
            <div class="section-head">Student chunein</div>
            <label class="form-label fw-semibold">Student <span class="text-danger">*</span></label>
            <select asp-for="StudentId" class="form-select" id="studentSelect"
                    asp-items="@(new SelectList(students, "StudentId", "DisplayName", Model.StudentId))">
                <option value="">— Search & Select Student —</option>
            </select>
            <span asp-validation-for="StudentId" class="text-danger small"></span>
            <div class="text-muted small mt-1">Student ka naam ya roll number se search karein</div>

            <div class="student-preview-card" id="studentPreviewCard" style="display:none">
                <div class="stu-avatar" id="previewAvatar">—</div>
                <div>
                    <div class="fw-semibold" id="previewName" style="font-size:15px"></div>
                    <div class="text-muted small">Roll No: <strong id="previewRoll"></strong></div>
                </div>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="pane" id="pane2">
            <div class="section-head">Academic details</div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Academic Session <span class="text-danger">*</span></label>
                <select asp-for="SessionId" class="form-select"
                        asp-items="@(new SelectList(sessions, "SessionId", "SessionName", Model.SessionId))">
                    <option value="">— Select Session —</option>
                </select>
                <span asp-validation-for="SessionId" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
                    <select asp-for="ClassId" class="form-select"
                            asp-items="@(new SelectList(classes, "ClassId", "ClassName", Model.ClassId))">
                        <option value="">— Select Class —</option>
                    </select>
                    <span asp-validation-for="ClassId" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold">Section <span class="text-danger">*</span></label>
                    <select asp-for="SectionId" class="form-select"
                            asp-items="@(new SelectList(sections, "SectionId", "SectionName", Model.SectionId))">
                        <option value="">— Select Section —</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Step 3 — Summary -->
        <div class="pane" id="pane3">
            <div class="section-head">Confirm karo</div>
            <div class="summary-student">
                <div class="stu-avatar" id="sumAvatar" style="width:40px;height:40px;font-size:14px">—</div>
                <div>
                    <div class="fw-semibold" id="sumName" style="font-size:14px;color:#055160"></div>
                    <div class="text-muted small">Roll: <span id="sumRoll"></span></div>
                </div>
            </div>
            <div class="summary-grid">
                <div class="summary-item">
                    <div class="summary-label"><i class="fas fa-calendar me-1"></i>Session</div>
                    <div class="summary-val" id="sumSession">—</div>
                </div>
                <div class="summary-item">
                    <div class="summary-label"><i class="fas fa-school me-1"></i>Class</div>
                    <div class="summary-val" id="sumClass">—</div>
                </div>
                <div class="summary-item">
                    <div class="summary-label"><i class="fas fa-door-open me-1"></i>Section</div>
                    <div class="summary-val" id="sumSection">—</div>
                </div>
                <div class="summary-item">
                    <div class="summary-label"><i class="fas fa-circle me-1"></i>Status</div>
                    <div class="summary-val text-success">Active</div>
                </div>
            </div>
            <div class="alert alert-light border small py-2 mb-0">
                <i class="fas fa-info-circle me-1 text-info"></i>
                Save karne ke baad student is session mein map ho jayega.
            </div>
        </div>

        <!-- Wizard Footer -->
        <div class="wizard-footer">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBack"
                    style="display:none" onclick="wizardPrev()">
                <i class="fas fa-arrow-left me-1"></i> Back
            </button>
            <div class="ms-auto d-flex gap-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnNext" onclick="wizardNext()">
                    Next <i class="fas fa-arrow-right ms-1"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- ── EDIT MODE (simple form) ────────────────────────── -->
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Student <span class="text-danger">*</span></label>
                <select asp-for="StudentId" class="form-select" id="studentSelect"
                        asp-items="@(new SelectList(students, "StudentId", "DisplayName", Model.StudentId))">
                    <option value="">— Select Student —</option>
                </select>
            </div>

            <div class="col-12" id="studentPreviewCard" style="@(Model.StudentId > 0 ? "" : "display:none")">
                <div class="student-preview-card">
                    <div class="stu-avatar" id="previewAvatar">—</div>
                    <div>
                        <div class="fw-semibold" id="previewName" style="font-size:15px"></div>
                        <div class="text-muted small">Roll No: <strong id="previewRoll"></strong></div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Session <span class="text-danger">*</span></label>
                <select asp-for="SessionId" class="form-select"
                        asp-items="@(new SelectList(sessions, "SessionId", "SessionName", Model.SessionId))">
                    <option value="">— Select Session —</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
                <select asp-for="ClassId" class="form-select"
                        asp-items="@(new SelectList(classes, "ClassId", "ClassName", Model.ClassId))">
                    <option value="">— Select Class —</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold">Section <span class="text-danger">*</span></label>
                <select asp-for="SectionId" class="form-select"
                        asp-items="@(new SelectList(sections, "SectionId", "SectionName", Model.SectionId))">
                    <option value="">— Select Section —</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold">Status</label>
                <select asp-for="IsActive" class="form-select"
                        asp-items="@(new SelectList(new[] {
                            new { Value = "true",  Text = "Active"   },
                            new { Value = "false", Text = "Inactive" }
                        }, "Value", "Text", Model.IsActive?.ToString().ToLower()))">
                </select>
            </div>
        </div>

        <div class="modal-footer px-0 pb-0 mt-3">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i>Cancel
            </button>
            <button type="button" id="btnSave" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Save Changes
            </button>
        </div>
    }
</form>

<script>
    // ── Student preview (shared) ──────────────────────────────────────────────
    function initials(n) { return (n || '?').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase(); }

    function showPreview(sel) {
        const opt  = sel.options[sel.selectedIndex];
        const name = opt.text;
        const parts = name.split('|');
        const cleanName = parts[0].trim();
        const roll = (parts[1] || '').replace('Roll:', '').trim();
        if (!sel.value) { $('#studentPreviewCard').hide(); return; }
        $('#previewAvatar').text(initials(cleanName));
        $('#previewName').text(cleanName);
        $('#previewRoll').text(roll || '—');
        $('#studentPreviewCard').show();
    }

    // Init for edit mode
    (function () {
        const sel = document.getElementById('studentSelect');
        if (sel && sel.value) showPreview(sel);
    })();

    $(document).on('change', '#studentSelect', function () { showPreview(this); });

    // ── Wizard (Add mode only) ────────────────────────────────────────────────
    var wizardStep = 1;

    function wizardShowStep(n) {
        wizardStep = n;
        [1, 2, 3].forEach(i => {
            document.getElementById('pane' + i).className = 'pane' + (i === n ? ' active' : '');
            const tab = document.getElementById('tab' + i);
            if (tab) {
                tab.className = 'step-tab' + (i === n ? ' active' : i < n ? ' done' : '');
                tab.querySelector('.step-num').textContent = i < n ? '✓' : i;
            }
        });
        const back = document.getElementById('btnBack');
        const next = document.getElementById('btnNext');
        if (back) back.style.display = n > 1 ? 'inline-flex' : 'none';
        if (next) {
            if (n === 3) {
                next.className = 'btn btn-success btn-sm';
                next.innerHTML = '<i class="fas fa-check me-1"></i> Save Mapping';
            } else {
                next.className = 'btn btn-primary btn-sm';
                next.innerHTML = 'Next <i class="fas fa-arrow-right ms-1"></i>';
            }
        }
    }

    function wizardNext() {
    if (wizardStep === 1) {
        if (!$('#studentSelect').val()) { toastr.warning('Student chunein!'); return; }  // ← fix
        wizardShowStep(2);
    } else if (wizardStep === 2) {
        if (!$('#SessionId').val())  { toastr.warning('Session chunein!'); return; }
        if (!$('#ClassId').val())    { toastr.warning('Class chunein!');   return; }
        if (!$('#SectionId').val())  { toastr.warning('Section chunein!'); return; }
        fillSummary();
        wizardShowStep(3);
    } else if (wizardStep === 3) {
        var btn = $('#btnNext');
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Saving…');
        $.post($('#mappingForm').attr('action'), $('#mappingForm').serialize(), function (res) {
            btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i> Save Mapping');
            if (res.success) {
                $('#mappingModal').modal('hide');
                toastr.success(res.message);
                if (typeof loadData === 'function') loadData();
            } else {
                toastr.error(res.message);
            }
        });
    }
}

    function wizardPrev() {
        if (wizardStep > 1) wizardShowStep(wizardStep - 1);
    }

 function fillSummary() {
    const stuSel  = document.getElementById('studentSelect');  // ← fix
    const sessSel = document.getElementById('SessionId');
    const clsSel  = document.getElementById('ClassId');
    const secSel  = document.getElementById('SectionId');

    const stuText   = stuSel?.options[stuSel.selectedIndex]?.text || '';
    const parts     = stuText.split('|');
    const cleanName = parts[0].trim();
    const roll      = (parts[1] || '').replace('Roll:', '').trim();

    document.getElementById('sumAvatar') .textContent = initials(cleanName);
    document.getElementById('sumName')   .textContent = cleanName;
    document.getElementById('sumRoll')   .textContent = roll || '—';
    document.getElementById('sumSession').textContent = sessSel?.options[sessSel.selectedIndex]?.text || '—';
    document.getElementById('sumClass')  .textContent = clsSel ?.options[clsSel.selectedIndex] ?.text || '—';
    document.getElementById('sumSection').textContent = secSel ?.options[secSel.selectedIndex] ?.text || '—';
}
</script>