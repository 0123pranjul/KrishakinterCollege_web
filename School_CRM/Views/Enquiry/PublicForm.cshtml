    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        function submitEnquiry() {
            const name   = $('#studentName').val().trim();
            const parent = $('#parentName').val().trim();
            const mobile = $('#mobileNo').val().trim();
            const cls    = $('#interestedClassId').val();

            if (!name) {
                toastr.warning('Enter student name!'); return;
            }
            if (!parent) {
                toastr.warning('Enter parent name!'); return;
            }
            if (!mobile || mobile.length !== 10) {
                toastr.warning('Enter valid 10-digit mobile!');
                return;
            }
            if (!cls) {
                toastr.warning('Select interested class!'); return;
            }

            const captcha = $('#captchaInput').val().trim();
            if (!captcha) {
                toastr.warning('Enter verification code!'); return;
            }

            const source = $('input[name="source"]:checked').val()
                           || 'Website';

            $('#btnSubmit').prop('disabled', true)
                .html('<i class="bx bx-loader-alt bx-spin me-2"></i>Submitting...');

            $.ajax({
                url: '@Url.Action("SubmitPublicForm","Enquiry")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    studentName:       name,
                    dateOfBirth:       $('#dateOfBirth').val() || null,
                    gender:            $('#gender').val(),
                    parentName:        parent,
                    mobileNo:          mobile,
                    alternateMobile:   $('#alternateMobile').val(),
                    email:             $('#email').val(),
                    address:           $('#address').val(),
                    city:              $('#city').val(),
                    interestedClassId: parseInt(cls) || null,
                    sessionId: parseInt(
                        $('#sessionId').val()) || null,
                    source,
                    captchaInput: captcha
                }),
                success: function (res) {
                    if (res.success) {
                        $('#formContent').hide();
                        $('#enquiryRefId').text(
                            'ENQ-' + String(res.enquiryId)
                                         .padStart(5, '0'));
                        $('#successScreen').show();
                        // Scroll to success screen smoothly
                        $('html, body').animate({
                            scrollTop: $("#successScreen").offset().top - 150
                        }, 500);
                    } else {
                        toastr.error(res.message);
                        $('#btnSubmit').prop('disabled', false)
                            .html('<i class="bx bxs-paper-plane me-2"></i>Submit Enquiry Form');
                        refreshEnquiryCaptcha();
                    }
                },
                error: function () {
                    toastr.error('Something went wrong!');
                    $('#btnSubmit').prop('disabled', false)
                        .html('<i class="bx bxs-paper-plane me-2"></i>Submit Enquiry Form');
                    refreshEnquiryCaptcha();
                }
            });
        }

        function resetForm() {
            $('#studentName').val('');
            $('#dateOfBirth').val('');
            $('#gender').val('');
            $('#parentName').val('');
            $('#mobileNo').val('');
            $('#alternateMobile').val('');
            $('#email').val('');
            $('#city').val('');
            $('#address').val('');
            $('#interestedClassId').val('');
            $('#sessionId').val('');
            $('#captchaInput').val('');
            $('input[name="source"]').prop('checked', false);
            
            $('#formContent').show();
            $('#successScreen').hide();
            $('#btnSubmit').prop('disabled', false)
                .html('<i class="bx bxs-paper-plane me-2"></i>Submit Enquiry Form');
            refreshEnquiryCaptcha();
        }

        function refreshEnquiryCaptcha() {
            $('#enquiryCaptchaImg').attr('src', '/Enquiry/GetCaptchaImage?t=' + new Date().getTime());
        }

        // Mobile only digits
        $('#mobileNo, #alternateMobile').on('input', function () {
            this.value = this.value.replace(/\D/g, '');
        });

        $(document).ready(function() {
            refreshEnquiryCaptcha();
        });
    </script>
