@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zxx">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Links of CSS files -->
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/aos.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/boxicons.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/style.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/header.css">
    <link rel="stylesheet" href="~/collage/collage_project/assets/css/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <title>Admission Enquiry Form - Krishak Inter College</title>
    <link rel="icon" type="image/png" href="~/kic_logo.png">

    <style>
            /* Header custom styling to match index page logo */
            .kic-logo-text {
                font-size: 22px;
                font-weight: 800;
                letter-spacing: 1px;
                line-height: 1.2;
            }

            .kic-logo-text span {
                display: block;
                font-size: 11px;
                font-weight: 400;
                letter-spacing: 2px;
                text-transform: uppercase;
                opacity: 0.85;
            }

            .logo-light .kic-logo-text {
                color: #fff;
            }

            .logo-dark .kic-logo-text {
                color: #1a1a2e;
            }

            .navbar-brand .logo-light, .navbar-brand .logo-dark {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .kic-logo-img {
                width: 55px;
                height: 55px;
                object-fit: contain;
                border-radius: 12px;
                flex-shrink: 0;
                background: var(--whiteColor);
                padding: 4px;
                box-shadow: 0 4px 15px rgba(46, 202, 127, 0.35);
                border: 2px solid var(--mainColor);
                transition: all 0.3s ease;
            }
            .kic-logo-img:hover {
                transform: scale(1.08);
                box-shadow: 0 8px 25px rgba(46, 202, 127, 0.5);
                border-color: var(--blackColor);
            }
            
            /* Fix dual logo display bug by overriding d-flex's display: flex !important */
            .navbar-area.style-2 .navbar-brand .logo-dark {
                display: none !important;
            }
            .navbar-area.style-2.sticky .navbar-brand .logo-light {
                display: none !important;
            }
            .navbar-area.style-2.sticky .navbar-brand .logo-dark {
                display: flex !important;
            }

            /* Make navbar solid dark navy by default on inner page */
            .navbar-area.style-2 {
                background: #120f2d !important;
                position: relative !important;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 99;
                padding-top: 15px;
                padding-bottom: 15px;
            }

            /* Custom form controls styling */
            .form-control-custom {
                width: 100%;
                border: 1.5px solid #cbd5e1;
                padding: 12px 16px;
                border-radius: 10px;
                font-size: 14px;
                color: #334155;
                background-color: #fff;
                transition: all 0.3s ease;
            }
            .form-control-custom:focus {
                border-color: var(--mainColor) !important;
                box-shadow: 0 0 0 4px rgba(46, 202, 127, 0.15) !important;
                outline: none;
            }
            .form-select-custom {
                width: 100%;
                border: 1.5px solid #cbd5e1;
                padding: 12px 16px;
                border-radius: 10px;
                font-size: 14px;
                color: #334155;
                background-color: #fff;
                transition: all 0.3s ease;
                appearance: none;
                background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='none' stroke='%23475569' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3E%3C/svg%3E");
                background-repeat: no-repeat;
                background-position: right 16px center;
                background-size: 16px 12px;
            }
            .form-select-custom:focus {
                border-color: var(--mainColor) !important;
                box-shadow: 0 0 0 4px rgba(46, 202, 127, 0.15) !important;
                outline: none;
            }

            /* Custom radio styling */
            .source-radio-label {
                border: 1.5px solid #e2e8f0;
                cursor: pointer;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.3s ease;
            }
            .source-radio-label:hover {
                border-color: var(--mainColor) !important;
                background: rgba(46, 202, 127, 0.02);
            }
            .source-radio-label input[type="radio"]:checked {
                border-color: var(--mainColor) !important;
                background-color: var(--mainColor) !important;
            }
            .source-radio-label input[type="radio"]:checked + i + span,
            .source-radio-label input[type="radio"]:checked + i {
                color: var(--mainColor) !important;
            }

            /* Align spacing of labels */
            .form-label-custom {
                font-weight: 600;
                color: #475569;
                font-size: 14px;
                margin-bottom: 6px;
            }
            
            /* Overwrite active state for go-top to behave natively */
            .go-top.active {
                opacity: 1;
                visibility: visible;
            }
    </style>
</head>
<body>

    <!-- Start Navbar Area Start -->
    <div class="navbar-area style-2" id="navbar">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-lg">
                <a class='navbar-brand' asp-controller="Home" asp-action="Index">
                    <div class="logo-light d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#fff;">Krishak<span>Inter College</span></div>
                    </div>
                    <div class="logo-dark d-flex align-items-center gap-2" style="text-decoration:none;">
                        <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                        <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                    </div>
                </a>
                <div class="other-option d-lg-none">
                    <div class="option-item">
                        <button type="button" class="search-btn" data-bs-toggle="offcanvas" data-bs-target="#staticBackdrop">
                            <i class='bx bx-search'></i>
                        </button>
                    </div>
                </div>
                <a class="navbar-toggler" data-bs-toggle="offcanvas" href="#navbarOffcanvas" role="button" aria-controls="navbarOffcanvas">
                    <i class='bx bx-menu'></i>
                </a>
                <div class="collapse navbar-collapse justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link">
                                Home
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="Index">Home</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="javascript:void(0)" class="dropdown-toggle nav-link">
                                About & Gallery
                            </a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="about">About Us</a></li>
                                <li class="nav-item"><a class='nav-link' asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Home" asp-action="contacts">
                                Contact
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class='nav-link' asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    </ul>
                    <div class="others-option d-flex align-items-center">
                        <div class="option-item">
                            <div class="nav-btn">
                                <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                            </div>
                        </div>
                        <div class="option-item">
                            <div class="nav-search">
                                <a href="#" data-bs-toggle="offcanvas" data-bs-target="#staticBackdrop" aria-controls="staticBackdrop" class="search-button"><i class='bx bx-search'></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- End Navbar Area Start -->

    <!-- Start Responsive Navbar Area -->
    <div class="responsive-navbar offcanvas offcanvas-end" data-bs-backdrop="static" tabindex="-1" id="navbarOffcanvas">
        <div class="offcanvas-header">
            <a class='logo d-inline-block' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="accordion" id="navbarAccordion">
                <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        Home
                    </button>
                    <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <ul>
                                <li><a class='active' asp-controller="Home" asp-action="Index">Home</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        About & Gallery
                    </button>
                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#navbarAccordion">
                        <div class="accordion-body">
                            <ul>
                                <li><a asp-controller="Home" asp-action="about">About Us</a></li>
                                <li><a asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <a class='accordion-button no-after' asp-controller="Home" asp-action="contacts">
                        Contact
                    </a>
                </div>
                <div class="accordion-item">
                    <a class='accordion-button no-after' asp-controller="Account" asp-action="Login">
                        Login
                    </a>
                </div>
            </div>
            <div class="others-option">
                <div class="option-item">
                    <a class='default-btn' asp-controller="Home" asp-action="contacts">Contact Us</a>
                </div>
            </div>
        </div>
    </div>
    <!-- End Responsive Navbar Area -->

    <!-- Start Search Modal / Offcanvas -->
    <div class="clgun offcanvas offcanvas-start" data-bs-backdrop="static" tabindex="-1" id="staticBackdrop">
        <div class="offcanvas-header">
            <a class='logo' asp-controller="Home" asp-action="Index">
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" class="kic-logo-img" />
                    <div class="kic-logo-text" style="color:#1a1a2e;">Krishak<span>Inter College</span></div>
                </div>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="search-box">
                <div class="searchwrapper">
                    <div class="searchbox">
                        <div class="row align-items-center">
                            <div class="col-md-9 col-sm-9 col-8">
                                <input type="text" placeholder="Search Here..." class="form-control" />
                            </div>
                            <div class="col-md-3 col-sm-3 col-4">
                                <a href="#" class="default-btn">Search</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Search Modal -->

    <!-- Start Form Area -->
    <div class="enquiry-form-area ptb-100" style="background: #f4f6fa; min-height: 80vh;">
        <div class="container">
            <div class="section-title section-title-2" data-aos="fade-up" data-aos-delay="100">
                <div class="sub-title">
                    <p style="color: var(--mainColor); font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Admissions 2026-27</p>
                </div>
                <h2 style="font-weight: 800; font-size: 38px; color: var(--blackColor);">Admission Enquiry Form</h2>
                <p>Please fill out the form below. Our admissions team will review your enquiry and contact you within 24 hours.</p>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="form-card-wrapper" data-aos="fade-up" data-aos-delay="200" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid rgba(46, 202, 127, 0.15); overflow: hidden; position: relative;">
                        <!-- Progress indicator line -->
                        <div style="height: 5px; background: linear-gradient(90deg, var(--mainColor), var(--blackColor));"></div>
                        
                        <!-- Success Screen -->
                        <div class="success-screen" id="successScreen" style="display: none; padding: 60px 40px; text-align: center;">
                            <div class="success-icon" style="width: 90px; height: 90px; background: #e6f7ef; color: var(--mainColor); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px auto; font-size: 42px; border: 2px solid var(--mainColor); box-shadow: 0 4px 15px rgba(46, 202, 127, 0.2);">
                                <i class='bx bx-check-double'></i>
                            </div>
                            <h3 class="fw-bold text-success mb-2" style="font-size: 28px;">Enquiry Submitted Successfully!</h3>
                            <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto; font-size: 16px;">
                                Thank you for your interest in Krishak Inter College. Our representative will contact you shortly on the provided mobile number.
                            </p>
                            <div class="mt-4 p-4 rounded" style="background: #f8fffb; border: 1px solid #c6edd5; max-width: 320px; margin: 0 auto; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
                                <div class="text-muted small mb-1" style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Enquiry Reference ID</div>
                                <div class="fw-bold text-success fs-4" id="enquiryRefId" style="font-size: 22px; letter-spacing: 1px;">-</div>
                            </div>
                            <button class="default-btn mt-5" onclick="resetForm()" style="border: none;">
                                Submit Another Enquiry
                            </button>
                        </div>
                        
                        <!-- Form Content -->
                        <div id="formContent" style="padding: 40px;">
                            
                            <!-- Student Section -->
                            <div class="form-section-group mb-5">
                                <h4 class="form-section-title" style="font-size: 18px; font-weight: 700; color: var(--blackColor); margin-bottom: 25px; display: flex; align-items: center; gap: 10px; border-bottom: 2px solid #f1f3f7; padding-bottom: 12px;">
                                    <i class='bx bxs-user-badge' style="color: var(--mainColor); font-size: 22px;"></i> Student Details
                                </h4>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Student Full Name <span style="color: red;">*</span></label>
                                        <input type="text" id="studentName" class="form-control-custom" placeholder="Enter student's full name" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label-custom">Date of Birth</label>
                                        <input type="date" id="dateOfBirth" class="form-control-custom" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label-custom">Gender</label>
                                        <select id="gender" class="form-select-custom">
                                            <option value="">Select Gender</option>
                                            <option>Male</option>
                                            <option>Female</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Parent Section -->
                            <div class="form-section-group mb-5">
                                <h4 class="form-section-title" style="font-size: 18px; font-weight: 700; color: var(--blackColor); margin-bottom: 25px; display: flex; align-items: center; gap: 10px; border-bottom: 2px solid #f1f3f7; padding-bottom: 12px;">
                                    <i class='bx bxs-group' style="color: var(--mainColor); font-size: 22px;"></i> Parent / Guardian Details
                                </h4>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Parent / Guardian Name <span style="color: red;">*</span></label>
                                        <input type="text" id="parentName" class="form-control-custom" placeholder="Father's / Mother's / Guardian's name" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label-custom">Mobile Number <span style="color: red;">*</span></label>
                                        <input type="tel" id="mobileNo" class="form-control-custom" maxlength="10" placeholder="10-digit mobile" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label-custom">Alternate Mobile</label>
                                        <input type="tel" id="alternateMobile" class="form-control-custom" maxlength="10" placeholder="Optional" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Email Address</label>
                                        <input type="email" id="email" class="form-control-custom" placeholder="email@example.com" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">City</label>
                                        <input type="text" id="city" class="form-control-custom" placeholder="Enter city name" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label-custom">Full Address</label>
                                        <textarea id="address" class="form-control-custom" rows="3" placeholder="Enter complete residential address" style="resize: none;"></textarea>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Admission Section -->
                            <div class="form-section-group mb-5">
                                <h4 class="form-section-title" style="font-size: 18px; font-weight: 700; color: var(--blackColor); margin-bottom: 25px; display: flex; align-items: center; gap: 10px; border-bottom: 2px solid #f1f3f7; padding-bottom: 12px;">
                                    <i class='bx bxs-school' style="color: var(--mainColor); font-size: 22px;"></i> Admission Preference
                                </h4>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Interested Class <span style="color: red;">*</span></label>
                                        <select id="interestedClassId" class="form-select-custom">
                                            <option value="">-- Select Class --</option>
                                            @foreach (var cls in (ViewBag.Classes as List<School_CRM.Models.TblClass> ?? new()))
                                            {
                                                <option value="@cls.ClassId">@cls.ClassName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Academic Session</label>
                                        <select id="sessionId" class="form-select-custom">
                                            <option value="">-- Select Session --</option>
                                            @foreach (var ses in (ViewBag.Sessions as List<School_CRM.Models.TblAcademicSession> ?? new()))
                                            {
                                                <option value="@ses.SessionId">@ses.SessionName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label-custom">How did you hear about us?</label>
                                        <div class="d-flex flex-wrap gap-3 mt-2">
                                            @foreach (var src in new[]
                                            {
                                                ("Walk-in","bx-walk"),
                                                ("Website","bx-globe"),
                                                ("Referral","bx-group"),
                                                ("Campaign","bx-bullhorn"),
                                                ("Social Media","bx-share-alt")
                                            })
                                            {
                                                <label class="source-radio-label d-flex align-items-center gap-2 px-4 py-2.5 rounded-pill">
                                                    <input type="radio" name="source" value="@src.Item1" class="form-check-input m-0" style="width: 16px; height: 16px; border-color: #cbd5e1;" />
                                                    <i class="bx @src.Item2" style="font-size: 16px; color: var(--mainColor);"></i>
                                                    <span>@src.Item1</span>
                                                </label>
                                            }
                                        </div>
                                    </div>

                                     <!-- Captcha Block -->
                                     <div class="col-12">
                                         <label class="form-label-custom">Verification Code <span class="text-danger">*</span></label>
                                         <div class="d-flex align-items-center gap-3 flex-wrap">
                                             <div class="captcha-img-wrapper" style="border-radius: 8px; border: 1.5px solid #cbd5e1; overflow: hidden; background: #fff; display: inline-flex;">
                                                 <img src="/Enquiry/GetCaptchaImage" id="enquiryCaptchaImg" alt="Captcha" style="height: 42px;" />
                                             </div>
                                             <button type="button" onclick="refreshEnquiryCaptcha()" class="btn p-0 border-0 bg-transparent text-secondary cursor-pointer" style="font-size: 28px; color: #94a3b8; outline: none; line-height: 1;" title="Refresh Captcha">
                                                 <i class="bx bx-refresh"></i>
                                             </button>
                                             <input type="text" id="captchaInput" class="form-control-custom" placeholder="Enter code *" style="max-width: 150px; text-transform: uppercase;" required autocomplete="off" />
                                         </div>
                                     </div>
                                 </div>
                            </div>
                            
                            <!-- Action and Safety Info -->
                            <div class="submit-action-area pt-4" style="border-top: 1px solid #f1f3f7; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
                                <div class="safety-text d-flex align-items-center gap-2" style="color: #6b7280; font-size: 14px;">
                                    <i class='bx bxs-shield-quarter' style="color: var(--mainColor); font-size: 20px;"></i>
                                    <span>Your data is secure and will only be used for admission.</span>
                                </div>
                                <button class="default-btn" onclick="submitEnquiry()" id="btnSubmit" style="border: none; padding: 14px 40px; font-size: 16px; display: inline-flex; align-items: center; gap: 10px;">
                                    <i class='bx bxs-paper-plane'></i> Submit Enquiry Form
                                </button>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Form Area -->

    <!-- Start Footer Area -->
    <div class="footer-area">
        <div class="footer-widget-info ptb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index"><i class='bx bx-chevron-right'></i> Home</a></li>
                                <li><a asp-controller="Home" asp-action="about"><i class='bx bx-chevron-right'></i> About Us</a></li>
                                <li><a asp-controller="Home" asp-action="Gallery"><i class='bx bx-chevron-right'></i> Gallery</a></li>
                                <li><a asp-controller="Home" asp-action="contacts"><i class='bx bx-chevron-right'></i> Contact Us</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <h4>Account</h4>
                            <ul>
                                <li><a asp-controller="Account" asp-action="Login"><i class='bx bx-chevron-right'></i> Login</a></li>
