@model School_CRM.Models.DTOs.AssetMasterDto
@{ ViewData["Title"] = "Add Asset"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-plus-circle text-primary me-2"></i>Add New Asset</h2>
            <small class="text-muted">Create asset master record and generate QR tags</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Asset Details -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-box me-2 text-primary"></i>Asset Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="AssetName" class="form-label fw-semibold">Asset Name <span class="text-danger">*</span></label>
                                <input asp-for="AssetName" class="form-control" placeholder="e.g. Dell Projector XYZ" />
                                <span asp-validation-for="AssetName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" id="categorySelect" onchange="loadSubCategories()">
                                    <option value="">Select Category</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SubCategoryId" class="form-label fw-semibold">Sub-Category</label>
                                <select asp-for="SubCategoryId" class="form-select" id="subCategorySelect">
                                    <option value="">Select Sub-Category</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Brand" class="form-label fw-semibold">Brand</label>
                                <input asp-for="Brand" class="form-control" placeholder="Dell, HP, Samsung..." />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Model" class="form-label fw-semibold">Model</label>
                                <input asp-for="Model" class="form-control" placeholder="Model number" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Specifications" class="form-label fw-semibold">Specifications</label>
                                <textarea asp-for="Specifications" class="form-control" rows="3" placeholder="Technical details..."></textarea>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssetImage" class="form-label fw-semibold">Asset Image</label>
                                <input asp-for="AssetImage" type="file" class="form-control" accept="image/*" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pricing & Units -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-rupee-sign me-2 text-success"></i>Pricing & Units</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="UnitPrice" class="form-label fw-semibold">Unit Price (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NumberOfUnits" class="form-label fw-semibold">Number of Units <span class="text-danger">*</span></label>
                            <input asp-for="NumberOfUnits" type="number" class="form-control" min="1" max="500" />
                            <span asp-validation-for="NumberOfUnits" class="text-danger small"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="IsIssuable" class="form-check-input" type="checkbox" />
                            <label asp-for="IsIssuable" class="form-check-label">Issuable to staff/students</label>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-shopping-cart me-2 text-info"></i>Purchase Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label asp-for="PurchaseDate" class="form-label fw-semibold small">Purchase Date</label>
                            <input asp-for="PurchaseDate" type="date" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label asp-for="VendorId" class="form-label fw-semibold small">Vendor</label>
                            <select asp-for="VendorId" class="form-select form-select-sm" asp-items="ViewBag.Vendors">
                                <option value="">Select Vendor</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label asp-for="InvoiceNo" class="form-label fw-semibold small">Invoice No.</label>
                            <input asp-for="InvoiceNo" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label asp-for="WarrantyExpiry" class="form-label fw-semibold small">Warranty Expiry</label>
                            <input asp-for="WarrantyExpiry" type="date" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-2">
                            <label asp-for="DefaultLocationId" class="form-label fw-semibold small">Default Location</label>
                            <select asp-for="DefaultLocationId" class="form-select form-select-sm" asp-items="ViewBag.Locations">
                                <option value="">Select Location</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-2"></i>Save Asset & Generate QR Tags
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        async function loadSubCategories() {
            const catId = document.getElementById('categorySelect').value;
            const sel   = document.getElementById('subCategorySelect');
            sel.innerHTML = '<option value="">Loading...</option>';
            if (!catId) { sel.innerHTML = '<option value="">Select Sub-Category</option>'; return; }
            const resp = await fetch(`/Assets/GetSubCategories/${catId}`);
            const data = await resp.json();
            sel.innerHTML = '<option value="">Select Sub-Category</option>';
            data.forEach(x => sel.innerHTML += `<option value="${x.subCategoryId}">${x.subCategoryName}</option>`);
        }
    </script>
}
