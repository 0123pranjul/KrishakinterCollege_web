@model List<School_CRM.Models.AsmAssetUnit>
@{ ViewData["Title"] = "Asset Units & QR Codes"; var asset = ViewBag.Asset as School_CRM.Models.AsmAsset; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-qrcode text-primary me-2"></i>Asset Units & QR Codes</h2>
            @if (asset != null) { <small class="text-muted">@asset.AssetName — @asset.AssetCode</small> }
        </div>
        <div class="d-flex gap-2">
            @if (asset != null)
            {
                <a asp-action="AddUnits" asp-route-id="@asset.AssetId" class="btn btn-success"><i class="fas fa-plus me-1"></i>Add Units</a>
                <button onclick="printAllQR()" class="btn btn-outline-primary"><i class="fas fa-print me-1"></i>Print All QR</button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    @if (asset != null)
    {
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-body py-3">
                <div class="row">
                    <div class="col-md-3"><strong>Total Units:</strong> @asset.TotalUnits</div>
                    <div class="col-md-3"><strong>Available:</strong> <span class="text-success fw-bold">@asset.AvailableUnits</span></div>
                    <div class="col-md-3"><strong>Issued:</strong> <span class="text-warning fw-bold">@(asset.TotalUnits - asset.AvailableUnits)</span></div>
                    <div class="col-md-3"><strong>Unit Price:</strong> ₹@asset.UnitPrice.ToString("F2")</div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        @foreach (var unit in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 @(!unit.IsAvailable ? "border-start border-warning border-3" : "")">
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(unit.QrcodeImagePath))
                        {
                            <img src="@unit.QrcodeImagePath" alt="QR" class="img-fluid mb-2" style="max-width:120px;" />
                        }
                        else
                        {
                            <div class="bg-light rounded p-3 mb-2 d-inline-block"><i class="fas fa-qrcode fa-3x text-muted"></i></div>
                        }
                        <div class="fw-bold">@unit.AssetTag</div>
                        <div class="mb-2">
                            <span class="badge @(unit.UnitCondition == "Good" ? "bg-success" : unit.UnitCondition == "UnderRepair" ? "bg-warning text-dark" : "bg-danger")">@unit.UnitCondition</span>
                            <span class="badge @(unit.IsAvailable ? "bg-success" : "bg-secondary") ms-1">@(unit.IsAvailable ? "Available" : "Issued")</span>
                        </div>
                        <div class="text-muted small mb-2">
                            @if (unit.CurrentLocation != null) { <div><i class="fas fa-map-marker-alt me-1"></i>@unit.CurrentLocation.LocationName</div> }
                            @if (unit.WarrantyExpiry.HasValue) { <div><i class="fas fa-shield-alt me-1"></i>Warranty: @unit.WarrantyExpiry.Value.ToString("dd/MM/yyyy")</div> }
                        </div>
                        <div class="d-flex gap-1 justify-content-center flex-wrap">
                            <a href="/Assets/QR/@unit.AssetTag" target="_blank" class="btn btn-sm btn-outline-primary" title="View QR"><i class="fas fa-eye"></i></a>
                            <button onclick="printQR('@unit.AssetTag','@unit.QrcodeImagePath')" class="btn btn-sm btn-outline-secondary" title="Print QR"><i class="fas fa-print"></i></button>
                            <a asp-controller="AssetIssue" asp-action="Move" asp-route-unitId="@unit.UnitId" class="btn btn-sm btn-outline-info" title="Move"><i class="fas fa-arrows-alt"></i></a>
                            <a asp-controller="AssetMaintenance" asp-action="Create" asp-route-unitId="@unit.UnitId" class="btn btn-sm btn-outline-warning" title="Maintenance"><i class="fas fa-wrench"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function printQR(tag, imgPath) {
        const w = window.open('', '_blank');
        w.document.write(`<html><head><title>QR - ${tag}</title>
        <style>body{font-family:Arial;text-align:center;padding:20px}img{max-width:200px}.label{font-size:14px;font-weight:bold;margin-top:10px}</style></head>
        <body><img src="${imgPath}"/><div class="label">${tag}</div><div style="font-size:11px;color:#666">@(asset?.AssetName ?? "Asset")</div></body></html>`);
        w.document.close(); w.print();
    }
    function printAllQR() {
        const units = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Where(u => !string.IsNullOrEmpty(u.QrcodeImagePath))
                 .Select(u => new { u.AssetTag, u.QrcodeImagePath }).ToList()));
        let html = `<html><head><title>All QR Codes</title>
        <style>body{font-family:Arial}.item{display:inline-block;text-align:center;margin:10px;padding:10px;border:1px solid #ddd}img{max-width:120px}.label{font-size:11px;font-weight:bold}</style></head><body>`;
        units.forEach(u => { html += `<div class="item"><img src="${u.qrcodeImagePath}"/><div class="label">${u.assetTag}</div></div>`; });
        html += '</body></html>';
        const w = window.open('', '_blank');
        w.document.write(html); w.document.close(); w.print();
    }
</script>
}
