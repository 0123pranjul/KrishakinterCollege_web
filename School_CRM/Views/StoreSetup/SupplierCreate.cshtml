@model School_CRM.Models.DTOs.InvSupplierDto
@{ ViewData["Title"] = "Add Supplier"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-plus-circle text-primary me-2"></i>Add Supplier</h2>
        <a asp-action="Suppliers" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form asp-action="SupplierCreate" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="SupplierName" class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                                <input asp-for="SupplierName" class="form-control" />
                                <span asp-validation-for="SupplierName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactPerson" class="form-label fw-semibold">Contact Person</label>
                                <input asp-for="ContactPerson" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                                <input asp-for="Email" type="email" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GSTNo" class="form-label fw-semibold">GST No.</label>
                                <input asp-for="GSTNo" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OpeningBalance" class="form-label fw-semibold">Opening Balance (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
                                </div>
                                <small class="text-muted">Amount payable to supplier from before</small>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Save</button>
                            <a asp-action="Suppliers" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
