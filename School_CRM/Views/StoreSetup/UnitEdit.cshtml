@model School_CRM.Models.DTOs.InvUnitDto
@{ ViewData["Title"] = "Edit Unit"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-edit text-primary me-2"></i>Edit Unit of Measure</h2>
        <a asp-action="Units" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form asp-action="UnitEdit" asp-route-id="@Model.UnitId" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="UnitId" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="UnitName" class="form-label fw-semibold">Unit Name <span class="text-danger">*</span></label>
                            <input asp-for="UnitName" class="form-control" />
                            <span asp-validation-for="UnitName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UnitShort" class="form-label fw-semibold">Short Code <span class="text-danger">*</span></label>
                            <input asp-for="UnitShort" class="form-control" maxlength="10" />
                            <span asp-validation-for="UnitShort" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Save Changes</button>
                            <a asp-action="Units" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
