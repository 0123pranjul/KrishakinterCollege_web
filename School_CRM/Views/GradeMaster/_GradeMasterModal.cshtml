@model School_CRM.Models.TblGradeMaster

<form id="gradeForm" asp-action="CreateOrEdit" asp-controller="GradeMaster" asp-route-id="@Model.GradeId" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="GradeId" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="GradeName" class="form-label fw-semibold">Grade Name <span class="text-danger">*</span></label>
            <input asp-for="GradeName" class="form-control" placeholder="e.g. A+, A, B+" required />
        </div>
        <div class="col-md-6">
            <label asp-for="GradePoint" class="form-label fw-semibold">Grade Point <span class="text-danger">*</span></label>
            <input asp-for="GradePoint" class="form-control" type="number" step="0.1" min="0" max="10" required />
        </div>
        <div class="col-md-6">
            <label asp-for="MinPercent" class="form-label fw-semibold">Min % <span class="text-danger">*</span></label>
            <input asp-for="MinPercent" class="form-control" type="number" step="0.01" min="0" max="100" required />
        </div>
        <div class="col-md-6">
            <label asp-for="MaxPercent" class="form-label fw-semibold">Max % <span class="text-danger">*</span></label>
            <input asp-for="MaxPercent" class="form-control" type="number" step="0.01" min="0" max="100" required />
        </div>
        <div class="col-12">
            <label asp-for="Remark" class="form-label fw-semibold">Remark</label>
            <input asp-for="Remark" class="form-control" placeholder="e.g. Excellent, Very Good, Good" />
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" @(Model.IsActive == true ? "checked" : "") />
                <label class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="modal-footer px-0 pb-0 mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Grade</button>
    </div>
</form>
