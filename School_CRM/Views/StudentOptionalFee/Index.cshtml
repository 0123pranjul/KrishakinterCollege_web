@{
    ViewData["Title"] = "Student Optional Fees";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-bus me-2 text-primary"></i>Student Optional Fees
                        <small class="text-muted fw-normal ms-2" style="font-size:13px">(Transport / Hostel / Other)</small>
                    </h3>
                    <button class="btn btn-sm btn-primary" onclick="loadModal(0)">
                        <i class="fas fa-plus"></i> Assign Optional Fee
                    </button>
                </div>

                <!-- Info Banner -->
                <div class="card-body border-bottom py-2">
                    <div class="alert alert-info py-2 mb-0 small">
                        <i class="fas fa-info-circle me-1"></i>
                        <strong>Optional Fees</strong> — Yahan sirf un students ko fees assign karo
                        jo Transport, Hostel ya koi aur optional service le rahe hain.
                        Ye fees automatically fee collection mein add ho jaati hain.
                    </div>
                </div>

                <!-- Filters -->
                <div class="card-body border-bottom pb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Session</label>
                            <select id="filterSession" class="form-select form-select-sm">
                                <option value="">All Sessions</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Fee Type</label>
                            <select id="filterFeeType" class="form-select form-select-sm">
                                <option value="">All Fee Types</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Student Search</label>
                            <input type="text" id="filterStudent"
                                   class="form-control form-control-sm"
                                   placeholder="Search student name..." />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table id="optionalFeeTable" class="table table-bordered table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Roll No</th>
                                    <th>Session</th>
                                    <th>Fee Type</th>
                                    <th>Frequency</th>
                                    <th>Amount</th>
                                    <th>Remarks</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>

                <!-- Summary Footer -->
                <div class="card-footer bg-light">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <small class="text-muted">Total Assignments</small>
                            <h5 class="mb-0 text-primary" id="summaryTotal">0</h5>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Monthly Fees</small>
                            <h5 class="mb-0 text-info" id="summaryMonthly">0</h5>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">One-Time Fees</small>
                            <h5 class="mb-0 text-warning" id="summaryOneTime">0</h5>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Total Monthly Amount</small>
                            <h5 class="mb-0 text-success" id="summaryAmount">₹0.00</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="optFeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-plus me-2"></i>Assign Optional Fee
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="optFeeModalBody"></div>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-eye me-2"></i>Optional Fee Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="viewModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        let table;

        $(document).ready(function () { loadDataTable(); });

        function loadDataTable() {
            table = $('#optionalFeeTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetAll", "StudentOptionalFee")',
                    type: 'GET',
                    dataSrc: function (json) {
                        loadFilterDropdowns(json.data);
                        updateSummary(json.data);
                        return json.data;
                    }
                },
                columns: [
                    { data: null, width: '4%', className: 'text-center',
                      render: function(d,t,r,meta){ return meta.row + meta.settings._iDisplayStart + 1; } },
                    { data: 'studentName', width: '18%' },
                    { data: 'rollNo',      width: '7%',  className: 'text-center' },
                    { data: 'sessionName', width: '10%', className: 'text-center' },
                    { data: 'feeName',     width: '13%' },
                    {
                        data: 'isRecurring', width: '9%', className: 'text-center',
                        render: d => d === 'Monthly'
                            ? '<span class="badge bg-primary">Monthly</span>'
                            : '<span class="badge bg-secondary">One Time</span>'
                    },
                    {
                        data: 'amount', width: '9%', className: 'text-end fw-semibold',
                        render: d => '<span class="text-success">₹' + parseFloat(d).toFixed(2) + '</span>'
                    },
                    {
                        data: 'remarks', width: '12%',
                        render: d => (d && d !== '-' && d.length > 25)
                            ? `<span title="${d}">${d.substring(0, 25)}...</span>` : (d || '-')
                    },
                    {
                        data: 'status', width: '7%', className: 'text-center',
                        render: d => d === 'Active'
                            ? '<span class="badge bg-success">Active</span>'
                            : '<span class="badge bg-danger">Inactive</span>'
                    },
                    {
                        data: 'id', width: '11%', className: 'text-center',
                        render: data => `<div class="btn-group btn-group-sm">
                            <button class="btn btn-info edit-btn" title="Edit" data-id="${data}"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-success view-btn" title="View" data-id="${data}"><i class="fas fa-eye"></i></button>
                            <button class="btn btn-danger delete-btn" title="Delete" data-id="${data}"><i class="fas fa-trash"></i></button>
                        </div>`
                    }
                ],
                language: { emptyTable: "No optional fees assigned yet" },
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: 0 }],
                drawCallback: function () {
                    updateSummary(this.api().rows({ filter: 'applied' }).data().toArray());
                },
                initComplete: function () {
                    $('#filterStudent').on('keyup',  function () { table.column(1).search($(this).val()).draw(); });
                    $('#filterSession').on('change', function () { table.column(3).search($(this).val()).draw(); });
                    $('#filterFeeType').on('change', function () { table.column(4).search($(this).val()).draw(); });
                }
            });
        }

        function loadFilterDropdowns(data) {
            var sessions = [...new Map(data.map(d => [d.sessionName, d])).values()];
            var feeTypes = [...new Map(data.map(d => [d.feeName,     d])).values()];
            sessions.forEach(d => $('#filterSession').append(`<option value="${d.sessionName}">${d.sessionName}</option>`));
            feeTypes.forEach(d => $('#filterFeeType').append(`<option value="${d.feeName}">${d.feeName}</option>`));
        }

        function resetFilters() {
            $('#filterStudent').val('');
            $('#filterSession, #filterFeeType').val('');
            table.columns().search('').draw();
        }

        function updateSummary(data) {
            var monthly = data.filter(d => d.isRecurring === 'Monthly');
            var monthlyAmt = monthly.reduce((s, d) => s + parseFloat(d.amount || 0), 0);
            $('#summaryTotal')  .text(data.length);
            $('#summaryMonthly').text(monthly.length);
            $('#summaryOneTime').text(data.filter(d => d.isRecurring === 'One Time').length);
            $('#summaryAmount') .text('₹' + monthlyAmt.toFixed(2));
        }

        function loadModal(id) {
            $.ajax({
                url: '@Url.Action("CreateOrEdit", "StudentOptionalFee")/' + id,
                type: 'GET',
                success: function (data) {
                    $('#optFeeModalBody').html(data);
                    $('#modalTitle').html(id == 0
                        ? '<i class="fas fa-plus me-2"></i>Assign Optional Fee'
                        : '<i class="fas fa-edit me-2"></i>Edit Optional Fee');
                    var form = $('#optionalFeeForm');
                    form.removeData('validator').removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse(form);
                    $('#optFeeModal').modal('show');
                },
                error: function () { toastr.error('Failed to load form!'); }
            });
        }

        $(document).on('click', '.edit-btn',   function () { loadModal($(this).data('id')); });

        $(document).on('click', '.view-btn', function () {
            $.ajax({
                url: '@Url.Action("View", "StudentOptionalFee")/' + $(this).data('id'),
                type: 'GET',
                success: function (data) { $('#viewModalContent').html(data); $('#viewModal').modal('show'); },
                error: function () { toastr.error('Failed to load details!'); }
            });
        });

        $(document).on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            Swal.fire({
                title: 'Remove Optional Fee?',
                text: 'Student ki yeh optional fee assignment remove ho jaayegi. Fee collection mein nahi aayegi.',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#d33', confirmButtonText: 'Yes, remove!'
            }).then(r => {
                if (r.isConfirmed) {
                    $.post('@Url.Action("Delete", "StudentOptionalFee")', { id }, function (res) {
                        if (res.success) { table.ajax.reload(null, false); toastr.success(res.message); }
                        else toastr.error(res.message);
                    });
                }
            });
        });

        $(document).on('click', '#btnSave', function () {
            var form = $('#optionalFeeForm');
            if (form.valid()) {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');
                $.post(form.attr('action'), form.serialize(), function (res) {
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save');
                    if (res.success) {
                        $('#optFeeModal').modal('hide');
                        table.ajax.reload(null, false);
                        toastr.success(res.message);
                    } else toastr.error(res.message);
                });
            }
        });
    </script>
}
