@model School_CRM.Models.TblStudentOptionalFee

@{
    var sessions = ViewBag.Sessions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var feeTypes = ViewBag.FeeTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    bool isEdit  = Model.Id > 0;

    string selectedStudentText = "";
    if (isEdit && Model.StudentId > 0)
    {
        var s = ViewBag.SelectedStudent as dynamic;
        if (s != null) selectedStudentText = s.DisplayName ?? "";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<form id="optionalFeeForm"
      asp-action="CreateOrEdit"
      asp-controller="StudentOptionalFee"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">

        <!-- Student -->
        <div class="col-12">
            <label class="form-label fw-semibold">Student <span class="text-danger">*</span></label>

            @if (isEdit)
            {
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <div class="form-control bg-light py-2">
                    <i class="fas fa-user-graduate me-2 text-primary"></i>
                    <strong>@selectedStudentText</strong>
                    <small class="text-muted ms-2">(edit mode mein student nahi badla jaata)</small>
                </div>
            }
            else
            {
                <select name="StudentId" id="studentSelect2" style="width:100%" required>
                    <option value=""></option>
                </select>
                <div class="form-text"><i class="fas fa-search me-1"></i>Name, Roll No ya Admission No se search karo</div>
            }
        </div>

        <!-- Student Info chips -->
        <div class="col-12" id="studentInfoBar" style="display:none">
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1" style="font-size:11px">
                    <i class="fas fa-hashtag me-1"></i><span id="sib_roll">-</span>
                </span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1" style="font-size:11px">
                    <i class="fas fa-chalkboard me-1"></i><span id="sib_class">-</span>
                </span>
                <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning px-2 py-1" style="font-size:11px">
                    <i class="fas fa-layer-group me-1"></i><span id="sib_section">-</span>
                </span>
                <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1" style="font-size:11px">
                    <i class="fas fa-calendar me-1"></i><span id="sib_session">-</span>
                </span>
            </div>
        </div>

        <!-- Session -->
        <div class="col-md-6">
            <label asp-for="SessionId" class="form-label fw-semibold">
                Academic Session <span class="text-danger">*</span>
            </label>
            <select asp-for="SessionId" class="form-select" id="sessionSelect"
                    asp-items="@(new SelectList(sessions, "SessionId", "SessionName", Model.SessionId))"
                    required>
                <option value="">-- Select Session --</option>
            </select>
            <div class="form-text" id="sessionAutoNote" style="display:none">
                <i class="fas fa-magic me-1 text-success"></i>Student ke session se auto-filled
            </div>
        </div>

        <!-- Fee Type -->
        <div class="col-md-6">
            <label asp-for="FeeTypeId" class="form-label fw-semibold">
                Optional Fee Type <span class="text-danger">*</span>
            </label>
            <select asp-for="FeeTypeId" class="form-select" id="feeTypeSelect"
                    asp-items="@(new SelectList(feeTypes, "FeeTypeId", "FeeName", Model.FeeTypeId))"
                    required>
                <option value="">-- Select Fee Type --</option>
            </select>
            @if (!feeTypes.Any())
            {
                <div class="form-text text-danger">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    Koi Optional fee type nahi mili. Pehle FeeType mein "Optional" type add karo.
                </div>
            }
        </div>

        <!-- Amount -->
        <div class="col-md-6">
            <label asp-for="Amount" class="form-label fw-semibold">
                Amount (₹) <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text">₹</span>
                <input asp-for="Amount" type="number" step="0.01" min="0.01"
                       class="form-control" placeholder="e.g. 500.00" required />
            </div>
        </div>

        <!-- IsActive -->
        <div class="col-md-6">
            <label asp-for="IsActive" class="form-label fw-semibold">Status</label>
            <select asp-for="IsActive" class="form-select"
                    asp-items="@(new SelectList(new[] {
                        new { Value = "true",  Text = "Active"   },
                        new { Value = "false", Text = "Inactive" }
                    }, "Value", "Text", Model.IsActive.ToString().ToLower()))">
            </select>
        </div>

        <!-- Remarks -->
        <div class="col-12">
            <label asp-for="Remarks" class="form-label fw-semibold">
                Remarks <small class="text-muted fw-normal">(Route / Room No / Other detail)</small>
            </label>
            <input asp-for="Remarks" type="text" class="form-control"
                   placeholder="e.g. Route: Sector-15 via Main Market | Room No: A-12" />
        </div>

        <!-- Info Note -->
        <div class="col-12">
            <div class="alert alert-warning py-2 mb-0 small">
                <i class="fas fa-lightbulb me-1"></i>
                <strong>Note:</strong> Yeh fee automatically fee collection mein add ho jaayegi
                jab is student ki fee collect ki jaayegi. Agar student ne service chodh di toh
                status <strong>Inactive</strong> kar do.
            </div>
        </div>

    </div>

    <div class="modal-footer px-0 pb-0 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="fas fa-save"></i> Save
        </button>
    </div>
</form>

<script>
    $(function () {
        if ($('#studentSelect2').length) {
            function initS2() {
                if (typeof $.fn.select2 === 'undefined') { setTimeout(initS2, 100); return; }
                $('#studentSelect2').select2({
                    theme: 'bootstrap-5',
                    placeholder: 'Name, Roll No ya Admission No type karo...',
                    minimumInputLength: 1,
                    allowClear: true,
                    dropdownParent: $('#studentSelect2').closest('.modal-body'),
                    ajax: {
                        url: '@Url.Action("SearchStudents", "StudentOptionalFee")',
                        dataType: 'json', delay: 300,
                        data: function (p) { return { term: p.term, page: p.page || 1 }; },
                        processResults: function (d, p) {
                            p.page = p.page || 1;
                            return { results: d.results, pagination: d.pagination };
                        },
                        cache: true
                    },
                    templateResult: function (s) {
                        if (s.loading) return $('<span><i class="fas fa-spinner fa-spin me-1"></i>Searching...</span>');
                        if (!s.id) return s.text;
                        var cls = [s.className, s.sectionName].filter(Boolean).join(' - ');
                        return $(`<div class="py-1">
                            <div style="font-weight:600;font-size:14px">
                                <i class="fas fa-user-graduate me-1 text-primary"></i>${s.name || s.text}
                            </div>
                            <div style="font-size:11px;color:#6b7280">
                                Roll: ${s.roll || '-'}
                                ${cls ? ' &bull; ' + cls : ''}
                                ${s.sessionName ? ' &bull; ' + s.sessionName : ''}
                            </div>
                        </div>`);
                    },
                    templateSelection: function (s) {
                        if (!s.id) return s.text;
                        return (s.name || s.text) + (s.roll ? ' | Roll: ' + s.roll : '');
                    }
                });

                // Student select → info chips + auto-fill session
                $('#studentSelect2').on('select2:select', function (e) {
                    var d = e.params.data;
                    $('#sib_roll')   .text(d.roll        || '-');
                    $('#sib_class')  .text(d.className   || '-');
                    $('#sib_section').text(d.sectionName || '-');
                    $('#sib_session').text(d.sessionName || '-');
                    $('#studentInfoBar').slideDown(150);

                    // Auto-fill session
                    if (d.sessionId) {
                        $('#sessionSelect').val(d.sessionId);
                        $('#sessionAutoNote').slideDown(150);
                    }
                });

                $('#studentSelect2').on('select2:clear select2:unselect', function () {
                    $('#studentInfoBar').slideUp(150);
                    $('#sessionAutoNote').slideUp(150);
                });
            }
            initS2();
        }
    });
</script>
