@{
    ViewData["Title"] = "Manage Syllabus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Modern Aesthetic CSS */
    .syllabus-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .filter-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: #ffffff;
        margin-bottom: 25px;
    }
    .unit-card {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        margin-bottom: 15px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        background: #fff;
    }
    .unit-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }
    .unit-header {
        background: #f8fafc;
        padding: 15px 20px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e2e8f0;
    }
    .unit-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: #1e293b;
        margin: 0;
    }
    .topic-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .topic-item {
        padding: 12px 20px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
    }
    .topic-item:last-child {
        border-bottom: none;
    }
    .topic-item:hover {
        background: #f8fafc;
    }
    .btn-icon {
        background: none;
        border: none;
        color: #64748b;
        padding: 5px;
        transition: color 0.2s;
    }
    .btn-icon:hover {
        color: #3b82f6;
    }
    .btn-icon.delete:hover {
        color: #ef4444;
    }
    .badge-periods {
        background: #e2e8f0;
        color: #475569;
        font-size: 0.8rem;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
    }
    .accordion-body {
        padding: 0;
    }
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
    }
    .empty-state i {
        font-size: 3rem;
        margin-bottom: 15px;
        color: #cbd5e1;
    }
</style>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="syllabus-header d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1 fw-bold"><i class="fas fa-book-open me-2"></i>Syllabus Management</h4>
            <p class="mb-0 text-white-50">Design and structure your academic curriculum</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card filter-card p-3">
        <div class="row align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary">Select Class</label>
                <select id="ddlClass" class="form-select">
                    <option value="">-- Select Class --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary">Select Subject</label>
                <select id="ddlSubject" class="form-select" disabled>
                    <option value="">-- Select Subject --</option>
                </select>
            </div>
            <div class="col-md-4 text-end">
                <button id="btnAddUnit" class="btn btn-primary" style="display:none;">
                    <i class="fas fa-plus me-1"></i> Add New Unit
                </button>
            </div>
        </div>
    </div>

    <!-- Syllabus Content Area -->
    <div id="syllabusContainer">
        <div class="empty-state bg-white rounded-3 border">
            <i class="fas fa-layer-group"></i>
            <h5>No Syllabus Loaded</h5>
            <p>Please select a Class and Subject to view or manage the syllabus.</p>
        </div>
    </div>
</div>

<!-- Modal: Add/Edit Unit -->
<div class="modal fade" id="unitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="unitModalTitle">Add Unit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnUnitId" value="0" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Unit Name <span class="text-danger">*</span></label>
                    <input type="text" id="txtUnitName" class="form-control" placeholder="e.g. Algebra" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea id="txtUnitDescription" class="form-control" rows="3" placeholder="Brief description..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveUnit">Save Unit</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add/Edit Topic -->
<div class="modal fade" id="topicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="topicModalTitle">Add Topic</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnTopicId" value="0" />
                <input type="hidden" id="hdnParentUnitId" value="0" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Topic Name <span class="text-danger">*</span></label>
                    <input type="text" id="txtTopicName" class="form-control" placeholder="e.g. Linear Equations" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Expected Periods <span class="text-danger">*</span></label>
                    <input type="number" id="txtExpectedPeriods" class="form-control" value="1" min="1" required />
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveTopic">Save Topic</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load Classes
            $.get('/Syllabus/GetClasses', function (data) {
                let options = '<option value="">-- Select Class --</option>';
                data.forEach(c => {
                    options += `<option value="${c.id}">${c.name}</option>`;
                });
                $('#ddlClass').html(options);
            });

            // On Class Change
            $('#ddlClass').change(function () {
                let classId = $(this).val();
                if (classId) {
                    $.get('/Syllabus/GetSubjectsByClass?classId=' + classId, function (data) {
                        let options = '<option value="">-- Select Subject --</option>';
                        data.forEach(s => {
                            options += `<option value="${s.id}">${s.name}</option>`;
                        });
                        $('#ddlSubject').html(options).prop('disabled', false);
                    });
                } else {
                    $('#ddlSubject').html('<option value="">-- Select Subject --</option>').prop('disabled', true);
                    resetContainer();
                }
            });

            // On Subject Change
            $('#ddlSubject').change(function () {
                loadSyllabus();
            });

            function resetContainer() {
                $('#syllabusContainer').html(`
                    <div class="empty-state bg-white rounded-3 border">
                        <i class="fas fa-layer-group"></i>
                        <h5>No Syllabus Loaded</h5>
                        <p>Please select a Class and Subject to view or manage the syllabus.</p>
                    </div>
                `);
                $('#btnAddUnit').hide();
            }

            function loadSyllabus() {
                let classId = $('#ddlClass').val();
                let subjectId = $('#ddlSubject').val();

                if (!classId || !subjectId) {
                    resetContainer();
                    return;
                }

                $('#btnAddUnit').show();
                $('#syllabusContainer').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>');

                $.get(`/Syllabus/GetSyllabus?classId=${classId}&subjectId=${subjectId}`, function (res) {
                    if (res.success) {
                        renderSyllabus(res.data);
                    }
                });
            }

            function renderSyllabus(units) {
                if (!units || units.length === 0) {
                    $('#syllabusContainer').html(`
                        <div class="empty-state bg-white rounded-3 border">
                            <i class="fas fa-folder-open"></i>
                            <h5>Syllabus is Empty</h5>
                            <p>Click "Add New Unit" to start building the syllabus.</p>
                        </div>
                    `);
                    return;
                }

                let html = '<div class="accordion" id="syllabusAccordion">';
                units.forEach((unit, index) => {
                    html += `
                        <div class="unit-card">
                            <div class="unit-header collapsed" data-bs-toggle="collapse" data-bs-target="#unitCollapse${unit.id}">
                                <div>
                                    <h3 class="unit-title"><i class="fas fa-bookmark text-primary me-2"></i>${unit.unitName}</h3>
                                    <small class="text-muted ms-4">${unit.description || 'No description'}</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-light text-dark border me-3">${unit.topics.length} Topics</span>
                                    <button class="btn btn-sm btn-outline-primary rounded-pill me-2 btn-add-topic" data-unit-id="${unit.id}" onclick="event.stopPropagation();">
                                        <i class="fas fa-plus"></i> Topic
                                    </button>
                                    <button class="btn-icon text-secondary me-1 btn-edit-unit" data-id="${unit.id}" data-name="${unit.unitName}" data-desc="${unit.description || ''}" onclick="event.stopPropagation();">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon delete btn-delete-unit" data-id="${unit.id}" onclick="event.stopPropagation();">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <i class="fas fa-chevron-down text-muted ms-2 transition-transform"></i>
                                </div>
                            </div>
                            <div id="unitCollapse${unit.id}" class="accordion-collapse collapse" data-bs-parent="#syllabusAccordion">
                                <div class="accordion-body">
                                    <ul class="topic-list">`;
                    
                    if (unit.topics.length === 0) {
                        html += `<li class="topic-item text-muted justify-content-center fst-italic py-3">No topics added yet.</li>`;
                    } else {
                        unit.topics.forEach(topic => {
                            html += `
                                        <li class="topic-item">
                                            <div>
                                                <i class="fas fa-circle text-success" style="font-size: 0.5rem; margin-right: 10px; vertical-align: middle;"></i>
                                                <span class="fw-medium">${topic.topicName}</span>
                                            </div>
                                            <div>
                                                <span class="badge-periods me-3"><i class="far fa-clock me-1"></i>${topic.expectedPeriods} Periods</span>
                                                <button class="btn-icon btn-edit-topic" data-id="${topic.id}" data-name="${topic.topicName}" data-periods="${topic.expectedPeriods}">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-icon delete btn-delete-topic" data-id="${topic.id}">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </li>`;
                        });
                    }
                    
                    html += `       </ul>
                                </div>
                            </div>
                        </div>`;
                });
                html += '</div>';
                $('#syllabusContainer').html(html);

                bindActionButtons();
            }

            function bindActionButtons() {
                // Edit Unit
                $('.btn-edit-unit').click(function () {
                    $('#hdnUnitId').val($(this).data('id'));
                    $('#txtUnitName').val($(this).data('name'));
                    $('#txtUnitDescription').val($(this).data('desc'));
                    $('#unitModalTitle').text('Edit Unit');
                    $('#unitModal').modal('show');
                });

                // Delete Unit
                $('.btn-delete-unit').click(function () {
                    if (confirm('Are you sure you want to delete this unit and all its topics?')) {
                        let id = $(this).data('id');
                        $.post('/Syllabus/DeleteUnit', { id: id }, function (res) {
                            if (res.success) loadSyllabus();
                            else alert('Error: ' + res.message);
                        });
                    }
                });

                // Add Topic
                $('.btn-add-topic').click(function () {
                    $('#hdnParentUnitId').val($(this).data('unit-id'));
                    $('#hdnTopicId').val(0);
                    $('#txtTopicName').val('');
                    $('#txtExpectedPeriods').val(1);
                    $('#topicModalTitle').text('Add Topic');
                    $('#topicModal').modal('show');
                });

                // Edit Topic
                $('.btn-edit-topic').click(function () {
                    $('#hdnParentUnitId').val(0); // Not needed for edit
                    $('#hdnTopicId').val($(this).data('id'));
                    $('#txtTopicName').val($(this).data('name'));
                    $('#txtExpectedPeriods').val($(this).data('periods'));
                    $('#topicModalTitle').text('Edit Topic');
                    $('#topicModal').modal('show');
                });

                // Delete Topic
                $('.btn-delete-topic').click(function () {
                    if (confirm('Are you sure you want to delete this topic?')) {
                        let id = $(this).data('id');
                        $.post('/Syllabus/DeleteTopic', { id: id }, function (res) {
                            if (res.success) loadSyllabus();
                            else alert('Error: ' + res.message);
                        });
                    }
                });
            }

            // Unit Modal Save
            $('#btnAddUnit').click(function () {
                $('#hdnUnitId').val(0);
                $('#txtUnitName').val('');
                $('#txtUnitDescription').val('');
                $('#unitModalTitle').text('Add Unit');
                $('#unitModal').modal('show');
            });

            $('#btnSaveUnit').click(function () {
                let classId = $('#ddlClass').val();
                let subjectId = $('#ddlSubject').val();
                let unitId = $('#hdnUnitId').val();
                let unitName = $('#txtUnitName').val().trim();
                let description = $('#txtUnitDescription').val().trim();

                if (!unitName) { alert('Unit Name is required'); return; }

                $.post('/Syllabus/SaveUnit', {
                    classId: classId,
                    subjectId: subjectId,
                    unitId: unitId,
                    unitName: unitName,
                    description: description
                }, function (res) {
                    if (res.success) {
                        $('#unitModal').modal('hide');
                        loadSyllabus();
                    } else {
                        alert('Error: ' + res.message);
                    }
                });
            });

            // Topic Modal Save
            $('#btnSaveTopic').click(function () {
                let unitId = $('#hdnParentUnitId').val();
                let topicId = $('#hdnTopicId').val();
                let topicName = $('#txtTopicName').val().trim();
                let expectedPeriods = $('#txtExpectedPeriods').val();

                if (!topicName) { alert('Topic Name is required'); return; }

                $.post('/Syllabus/SaveTopic', {
                    unitId: unitId,
                    topicId: topicId,
                    topicName: topicName,
                    expectedPeriods: expectedPeriods
                }, function (res) {
                    if (res.success) {
                        $('#topicModal').modal('hide');
                        loadSyllabus();
                    } else {
                        alert('Error: ' + res.message);
                    }
                });
            });
        });
    </script>
}
