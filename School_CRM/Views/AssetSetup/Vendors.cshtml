@model List<School_CRM.Models.AsmVendor>
@{ ViewData["Title"] = "Asset Vendors"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-truck text-primary me-2"></i>Asset Vendors</h2>
            <small class="text-muted">@Model.Count vendors</small>
        </div>
        <a asp-action="VendorCreate" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Vendor</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Vendor Name</th><th>Contact Person</th><th>Phone</th><th>Email</th><th>GST No.</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No vendors found.</td></tr> }
                        @{ int sno = 1; }
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td class="text-muted">@sno++</td>
                                <td class="fw-semibold">@v.VendorName</td>
                                <td>@(v.ContactPerson ?? "-")</td>
                                <td>@(v.Phone ?? "-")</td>
                                <td class="text-muted small">@(v.Email ?? "-")</td>
                                <td class="text-muted small">@(v.Gstno ?? "-")</td>
                                <td><span class="badge @(v.IsActive ? "bg-success" : "bg-secondary")">@(v.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <a asp-action="VendorEdit" asp-route-id="@v.VendorId" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
