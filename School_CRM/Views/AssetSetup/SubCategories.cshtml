@model List<School_CRM.Models.AsmSubCategory>
@{ ViewData["Title"] = "Asset Sub-Categories"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-sitemap text-primary me-2"></i>Asset Sub-Categories</h2>
            <small class="text-muted">@Model.Count sub-categories</small>
        </div>
        <a asp-action="SubCategoryCreate" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Sub-Category</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Sub-Category Name</th><th>Category</th><th>Description</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No sub-categories found.</td></tr> }
                        @{ int sno = 1; }
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="text-muted">@sno++</td>
                                <td class="fw-semibold">@s.SubCategoryName</td>
                                <td><span class="badge bg-light text-dark border">@s.Category?.CategoryName</span></td>
                                <td class="text-muted small">@(s.Description ?? "-")</td>
                                <td><span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <a asp-action="SubCategoryEdit" asp-route-id="@s.SubCategoryId" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
