@model School_CRM.Models.DTOs.InvPurchaseOrderDto
@{ ViewData["Title"] = "Create Purchase Order"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-plus-circle text-primary me-2"></i>Create Purchase Order</h2>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div> }

    <form asp-action="Create" method="post" id="poForm">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Header -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">Order Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="SupplierId" class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
                            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers">
                                <option value="">Select Supplier</option>
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="OrderDate" class="form-label fw-semibold">Order Date</label>
                            <input asp-for="OrderDate" type="date" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ExpectedDate" class="form-label fw-semibold">Expected Delivery</label>
                            <input asp-for="ExpectedDate" type="date" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between py-3">
                        <h6 class="fw-bold mb-0">Order Items</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addPORow()">
                            <i class="fas fa-plus me-1"></i>Add Item
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0" id="poItemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40%">Product</th>
                                        <th style="width:15%">Unit</th>
                                        <th style="width:15%">Qty</th>
                                        <th style="width:20%">Unit Price</th>
                                        <th style="width:15%">Total</th>
                                        <th style="width:5%"></th>
                                    </tr>
                                </thead>
                                <tbody id="poItemsBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top text-end py-3">
                        <span class="fw-bold">Grand Total: </span>
                        <span class="fw-bold fs-5 text-primary" id="poGrandTotal">₹0.00</span>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="fas fa-save me-2"></i>Create Purchase Order
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let poRowIdx = 0;

    function addPORow() {
        const idx = poRowIdx++;
        const row = `
        <tr id="porow_${idx}">
            <td>
                <input type="hidden" name="Items[${idx}].ProductId" id="ppid_${idx}" />
                <input type="text" class="form-control form-control-sm" placeholder="Search product..."
                       id="ppsearch_${idx}" oninput="searchPOProduct(${idx}, this.value)" autocomplete="off" />
                <div id="ppdrop_${idx}" class="dropdown-menu w-100" style="display:none;position:absolute;z-index:1000;max-height:180px;overflow-y:auto;"></div>
            </td>
            <td><input type="text" class="form-control form-control-sm bg-light" id="ppunit_${idx}" readonly /></td>
            <td><input type="number" name="Items[${idx}].OrderQty" class="form-control form-control-sm" min="1" value="1" oninput="calcPORow(${idx})" /></td>
            <td><input type="number" name="Items[${idx}].UnitCostPrice" step="0.01" class="form-control form-control-sm" id="ppprice_${idx}" value="0" oninput="calcPORow(${idx})" /></td>
            <td><input type="text" class="form-control form-control-sm bg-light" id="pptotal_${idx}" readonly value="0.00" /></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removePORow(${idx})"><i class="fas fa-times"></i></button></td>
        </tr>`;
        document.getElementById('poItemsBody').insertAdjacentHTML('beforeend', row);
    }

    function removePORow(idx) {
        document.getElementById(`porow_${idx}`)?.remove();
        calcPOTotal();
    }

    let poSearchTimers = {};
    async function searchPOProduct(idx, q) {
        clearTimeout(poSearchTimers[idx]);
        if (q.length < 2) { document.getElementById(`ppdrop_${idx}`).style.display = 'none'; return; }
        poSearchTimers[idx] = setTimeout(async () => {
            const resp = await fetch(`/Store/Product/Search?q=${encodeURIComponent(q)}`);
            const data = await resp.json();
            const drop = document.getElementById(`ppdrop_${idx}`);
            drop.innerHTML = '';
            data.forEach(p => {
                const a = document.createElement('a');
                a.className = 'dropdown-item small';
                a.href = '#';
                a.textContent = `${p.productCode} - ${p.productName}`;
                a.onclick = (e) => {
                    e.preventDefault();
                    document.getElementById(`ppid_${idx}`).value    = p.productId;
                    document.getElementById(`ppsearch_${idx}`).value = p.productName;
                    document.getElementById(`ppunit_${idx}`).value   = p.unitShort;
                    document.getElementById(`ppprice_${idx}`).value  = p.costPrice;
                    drop.style.display = 'none';
                    calcPORow(idx);
                };
                drop.appendChild(a);
            });
            drop.style.display = data.length ? 'block' : 'none';
        }, 300);
    }

    function calcPORow(idx) {
        const qty   = parseFloat(document.querySelector(`[name="Items[${idx}].OrderQty"]`)?.value || 0);
        const price = parseFloat(document.getElementById(`ppprice_${idx}`)?.value || 0);
        const total = qty * price;
        const el = document.getElementById(`pptotal_${idx}`);
        if (el) el.value = total.toFixed(2);
        calcPOTotal();
    }

    function calcPOTotal() {
        let grand = 0;
        document.querySelectorAll('[id^="pptotal_"]').forEach(el => grand += parseFloat(el.value || 0));
        document.getElementById('poGrandTotal').textContent = '₹' + grand.toFixed(2);
    }

    // Add first row
    addPORow();
</script>
}
