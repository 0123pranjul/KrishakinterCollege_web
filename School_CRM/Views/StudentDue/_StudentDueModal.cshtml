@model School_CRM.Models.TblStudentDue

@{
    var students = ViewBag.Students as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var sessions = ViewBag.Sessions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var months   = ViewBag.Months   as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var years    = ViewBag.Years    as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var dueTypes = ViewBag.DueTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<form id="studentDueForm"
      asp-action="CreateOrEdit"
      asp-controller="StudentDue"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">

        <!-- Student -->
        <div class="col-12">
            <label asp-for="StudentId" class="form-label fw-semibold">
                Student <span class="text-danger">*</span>
            </label>
            <select asp-for="StudentId"
                    class="form-select"
                    id="studentSelect"
                    asp-items="@(new SelectList(students, "StudentId", "DisplayName", Model.StudentId))"
                    required>
                <option value="">-- Select Student --</option>
            </select>
            <span asp-validation-for="StudentId" class="text-danger small"></span>
        </div>

        <!-- Student Preview -->
        <div class="col-12" id="studentInfoCard" style="display:none">
            <div class="alert alert-info py-2 mb-0">
                <div class="row">
                    <div class="col-6">
                        <small class="text-muted">Student Name</small>
                        <p class="fw-semibold mb-0" id="previewName"></p>
                    </div>
                    <div class="col-6">
                        <small class="text-muted">Roll No</small>
                        <p class="fw-semibold mb-0" id="previewRoll"></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Session -->
        <div class="col-md-6">
            <label asp-for="SessionId" class="form-label fw-semibold">
                Session <span class="text-danger">*</span>
            </label>
            <select asp-for="SessionId"
                    class="form-select"
                    asp-items="@(new SelectList(sessions, "SessionId", "SessionName", Model.SessionId))"
                    required>
                <option value="">-- Select Session --</option>
            </select>
            <span asp-validation-for="SessionId" class="text-danger small"></span>
        </div>

        <!-- Due Type -->
        <div class="col-md-6">
            <label asp-for="DueType" class="form-label fw-semibold">
                Due Type <span class="text-danger">*</span>
            </label>
            <select asp-for="DueType"
                    class="form-select"
                    asp-items="@(new SelectList(dueTypes, "Value", "Text", Model.DueType))"
                    required>
                <option value="">-- Select Due Type --</option>
            </select>
            <span asp-validation-for="DueType" class="text-danger small"></span>
        </div>

        <!-- Month -->
        <div class="col-md-4">
            <label asp-for="Month" class="form-label fw-semibold">
                Month <span class="text-danger">*</span>
            </label>
            <select asp-for="Month"
                    class="form-select"
                    asp-items="@(new SelectList(months, "Value", "Text", Model.Month))"
                    required>
                <option value="">-- Month --</option>
            </select>
            <span asp-validation-for="Month" class="text-danger small"></span>
        </div>

        <!-- Year -->
        <div class="col-md-4">
            <label asp-for="Year" class="form-label fw-semibold">
                Year <span class="text-danger">*</span>
            </label>
            <select asp-for="Year"
                    class="form-select"
                    asp-items="@(new SelectList(years, "Value", "Text", Model.Year))"
                    required>
                <option value="">-- Year --</option>
            </select>
            <span asp-validation-for="Year" class="text-danger small"></span>
        </div>

        <!-- Due Date -->
        <div class="col-md-4">
            <label asp-for="DueDate" class="form-label fw-semibold">Due Date</label>
            <input asp-for="DueDate"
                   type="date"
                   class="form-control"
                   value="@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : "")" />
            <span asp-validation-for="DueDate" class="text-danger small"></span>
        </div>

        <!-- Total Due -->
        <div class="col-md-4">
            <label asp-for="TotalDue" class="form-label fw-semibold">
                Total Due (₹) <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text">₹</span>
                <input asp-for="TotalDue" type="number" step="0.01" min="0"
                       class="form-control" id="totalDueInput"
                       placeholder="0.00" required />
            </div>
            <span asp-validation-for="TotalDue" class="text-danger small"></span>
        </div>

        <!-- Paid Amount -->
        <div class="col-md-4">
            <label asp-for="PaidAmount" class="form-label fw-semibold">Paid Amount (₹)</label>
            <div class="input-group">
                <span class="input-group-text">₹</span>
                <input asp-for="PaidAmount" type="number" step="0.01" min="0"
                       class="form-control" id="paidAmountInput"
                       placeholder="0.00" value="@(Model.PaidAmount ?? 0)" />
            </div>
            <span asp-validation-for="PaidAmount" class="text-danger small"></span>
        </div>

        <!-- Remaining (computed) -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Remaining Due</label>
            <div class="input-group">
                <span class="input-group-text">₹</span>
                <input type="text" id="remainingDisplay"
                       class="form-control bg-light fw-bold text-danger" readonly
                       value="@(((Model.TotalDue ?? 0) - (Model.PaidAmount ?? 0)).ToString("0.00"))" />
            </div>
        </div>

        <!-- Is Settled -->
        <div class="col-md-6">
            <label asp-for="IsSettled" class="form-label fw-semibold">Settlement Status</label>
            <select asp-for="IsSettled"
                    class="form-select"
                    asp-items="@(new SelectList(new[] {
                        new { Value = "false", Text = "Pending"  },
                        new { Value = "true",  Text = "Settled"  }
                    }, "Value", "Text", Model.IsSettled?.ToString().ToLower()))">
                <option value="">-- Select --</option>
            </select>
        </div>

        <!-- IsActive -->
        <div class="col-md-6">
            <label asp-for="IsActive" class="form-label fw-semibold">Status</label>
            <select asp-for="IsActive"
                    class="form-select"
                    asp-items="@(new SelectList(new[] {
                        new { Value = "true",  Text = "Active"   },
                        new { Value = "false", Text = "Inactive" }
                    }, "Value", "Text", Model.IsActive?.ToString().ToLower()))">
                <option value="">-- Select --</option>
            </select>
        </div>

        <!-- Remarks -->
        <div class="col-12">
            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="2"
                      placeholder="e.g. Partial payment received, Waived off..."></textarea>
        </div>

    </div>

    <!-- Footer -->
    <div class="modal-footer px-0 pb-0 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Due
        </button>
    </div>

</form>

<script>
    // Real-time remaining calculation
    function recalcRemaining() {
        var total = parseFloat($('#totalDueInput').val())   || 0;
        var paid  = parseFloat($('#paidAmountInput').val()) || 0;
        var rem   = total - paid;
        $('#remainingDisplay').val(rem > 0 ? rem.toFixed(2) : '0.00');
        $('#remainingDisplay')
            .toggleClass('text-danger', rem > 0)
            .toggleClass('text-success', rem <= 0);
    }

    $('#totalDueInput, #paidAmountInput').on('input', recalcRemaining);

    // Student preview on load (edit mode)
    (function () {
        var sel = $('#studentSelect');
        if (sel.val()) {
            var parts = sel.find('option:selected').text().split('|');
            $('#previewName').text(parts[0]?.trim() || '-');
            $('#previewRoll').text(parts[1]?.replace('Roll:', '').trim() || '-');
            $('#studentInfoCard').show();
        }
    })();

    $(document).on('change', '#studentSelect', function () {
        if ($(this).val()) {
            var parts = $(this).find('option:selected').text().split('|');
            $('#previewName').text(parts[0]?.trim() || '-');
            $('#previewRoll').text(parts[1]?.replace('Roll:', '').trim() || '-');
            $('#studentInfoCard').slideDown(200);
        } else {
            $('#studentInfoCard').slideUp(200);
        }
    });
</script>
