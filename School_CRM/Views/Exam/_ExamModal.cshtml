@model School_CRM.Models.TblExam

<form id="examForm" asp-action="CreateOrEdit" asp-controller="Exam" asp-route-id="@Model.ExamId" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ExamId" />
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="ExamName" class="form-label fw-semibold">Exam Name <span class="text-danger">*</span></label>
            <input asp-for="ExamName" class="form-control" placeholder="e.g. Mid Term, Final Term" required />
        </div>
        <div class="col-md-4">
            <label asp-for="SessionId" class="form-label fw-semibold">Session <span class="text-danger">*</span></label>
            <select asp-for="SessionId" class="form-select" asp-items="@(new SelectList(ViewBag.Sessions, "SessionId", "SessionName"))" required>
                <option value="">-- Select --</option>
            </select>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" @(Model.IsActive == true ? "checked" : "") />
                <label class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="modal-footer px-0 pb-0 mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Exam</button>
    </div>
</form>
