@model List<School_CRM.Models.ViewModels.IdCardTemplateDto>
@{
    ViewData["Title"] = "ID Card Templates";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0 fw-bold text-primary"><i class="bi bi-person-badge me-2"></i>ID Card Templates</h3>
            <p class="text-muted mb-0">Manage premium ID card designs for students and staff.</p>
        </div>
        <a href="@Url.Action("CreateOrEdit")" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Create New Template
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 py-5 text-center bg-light">
                    <div class="card-body">
                        <i class="bi bi-palette text-muted mb-3" style="font-size: 3rem;"></i>
                        <h5>No Templates Found</h5>
                        <p class="text-muted">Create your first ID card template to get started.</p>
                        <a href="@Url.Action("CreateOrEdit")" class="btn btn-outline-primary mt-2">Create Template</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            foreach (var t in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden template-card" style="transition: transform 0.3s, box-shadow 0.3s;">
                        <div class="card-header border-0 d-flex justify-content-between align-items-center" style="background: @(t.ThemeColor ?? "#0d6efd"); color: white;">
                            <h5 class="mb-0 text-truncate" title="@t.TemplateName">@t.TemplateName</h5>
                            @if(t.IsActive)
                            {
                                <span class="badge bg-white text-dark rounded-pill">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white rounded-pill">Inactive</span>
                            }
                        </div>
                        <div class="card-body bg-light position-relative">
                            <!-- Background preview mockup -->
                            <div class="d-flex justify-content-center align-items-center mb-3">
                                <div class="bg-white rounded-3 shadow-sm border p-2 d-flex flex-column" 
                                     style="width: @(t.Orientation == "Vertical" ? "120px" : "180px"); 
                                            height: @(t.Orientation == "Vertical" ? "180px" : "120px");
                                            background-image: url('@(t.BackgroundFrontPath ?? "")'); background-size: cover; background-position: center;">
                                    <div class="d-flex justify-content-between w-100">
                                        <div style="width: 20px; height: 20px; background: #eee; border-radius: 50%;"></div>
                                        <div style="width: 40px; height: 8px; background: @(t.ThemeColor ?? "#ddd"); border-radius: 4px;"></div>
                                    </div>
                                    <div class="mt-auto d-flex justify-content-center">
                                        <div style="width: 40px; height: 50px; background: #eee; border-radius: 4px; border: 1px solid #ccc;"></div>
                                    </div>
                                    <div class="mt-2 text-center">
                                        <div style="width: 60px; height: 4px; background: #333; margin: 0 auto; border-radius: 2px;"></div>
                                        <div style="width: 80px; height: 4px; background: #999; margin: 4px auto 0; border-radius: 2px;"></div>
                                    </div>
                                </div>
                            </div>
                            
                            <ul class="list-unstyled mb-0 small text-muted">
                                <li class="mb-1"><i class="bi bi-rulers me-2"></i> Orientation: <strong>@t.Orientation</strong></li>
                                <li class="mb-1"><i class="bi bi-building me-2"></i> School: <strong>@(t.SchoolName ?? "Default")</strong></li>
                                <li><i class="bi bi-calendar-event me-2"></i> Created: <strong>@t.CreatedDate.ToString("MMM dd, yyyy")</strong></li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top d-flex justify-content-between">
                            <a href="@Url.Action("Generate", new { templateId = t.TemplateId })" class="btn btn-sm btn-success rounded-pill px-3">
                                <i class="bi bi-printer me-1"></i> Generate
                            </a>
                            <div>
                                <a href="@Url.Action("CreateOrEdit", new { id = t.TemplateId })" class="btn btn-sm btn-outline-primary rounded-circle" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle ms-1" onclick="deleteTemplate(@t.TemplateId)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // Hover effect
        document.querySelectorAll('.template-card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-5px)';
                card.style.boxShadow = '0 10px 20px rgba(0,0,0,0.1)';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'translateY(0)';
                card.style.boxShadow = '0 .125rem .25rem rgba(0,0,0,.075)';
            });
        });

        function deleteTemplate(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/IdCard/Delete', { id: id }, function(res) {
                        if(res.success) {
                            Swal.fire('Deleted!', 'Template has been deleted.', 'success')
                            .then(() => location.reload());
                        } else {
                            Swal.fire('Error!', 'Could not delete template.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
