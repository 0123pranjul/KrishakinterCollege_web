@model School_CRM.Models.TblClassSubject

<form id="classSubjectForm" asp-action="BulkSave" asp-controller="ClassSubject" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
        <select name="ClassId" id="modalClassId" class="form-select" required onchange="loadSubjectsForClass(this.value)">
            <option value="">— Select Class —</option>
            @foreach (var c in (List<TblClass>)ViewBag.Classes)
            {
                <option value="@c.ClassId">@c.ClassName</option>
            }
        </select>
    </div>

    <div id="subjectCheckboxArea" style="display:none">
        <label class="form-label fw-semibold">Subjects</label>
        <div id="subjectChips" class="d-flex flex-wrap gap-2 mt-1"></div>
    </div>

    <div class="modal-footer px-0 pb-0 mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="fas fa-save me-1"></i> Save Mapping
        </button>
    </div>
</form>