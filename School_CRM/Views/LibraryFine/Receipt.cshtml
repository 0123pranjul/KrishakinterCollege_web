@{
    ViewData["Title"] = "Fine Receipt";
    string receiptNo = ViewBag.ReceiptNo ?? "";
}

<div class="container py-4" style="max-width: 500px;">
    <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
        <h5 class="fw-bold mb-0">Fine Receipt</h5>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary btn-sm">
                <i class="fas fa-print me-1"></i>Print
            </button>
            <a asp-controller="LibraryIssue" asp-action="Overdue" class="btn btn-outline-secondary btn-sm">Done</a>
        </div>
    </div>

    <div class="card border shadow-sm">
        <div class="card-header text-center py-3 bg-success text-white">
            <i class="fas fa-check-circle fa-2x mb-1 d-block"></i>
            <h5 class="mb-0">FINE RECEIPT</h5>
            <small>School Library Management System</small>
        </div>
        <div class="card-body">
            <div class="text-center mb-3">
                <div class="text-muted small">Receipt No.</div>
                <div class="fw-bold fs-5">@receiptNo</div>
                <div class="text-muted small">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <hr />
            <div class="alert alert-success text-center">
                <i class="fas fa-check-circle me-2"></i>
                Fine payment collected successfully.
            </div>
        </div>
        <div class="card-footer text-center text-muted small py-2">
            Thank you for clearing your dues!
        </div>
    </div>
</div>

<style>
    @@media print {
        .d-print-none { display: none !important; }
        body { background: white; }
    }
</style>
