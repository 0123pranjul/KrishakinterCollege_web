@model School_CRM.Models.DTOs.FinePaymentDto
@{
    ViewData["Title"] = "Collect Fine";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-rupee-sign text-warning me-2"></i>Collect Fine</h2>
            <small class="text-muted">Process fine payment</small>
        </div>
        <a asp-controller="LibraryIssue" asp-action="Overdue" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-info-circle me-2 text-primary"></i>Fine Details</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Member</label>
                            <div class="fw-bold">@Model.MemberName</div>
                            <small class="text-muted">@Model.UserType</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Book</label>
                            <div class="fw-bold">@Model.BookTitle</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Total Fine</label>
                            <div class="fw-bold text-danger fs-5">₹@Model.TotalFine.ToString("F2")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Already Paid</label>
                            <div class="fw-bold text-success">₹@Model.AlreadyPaid.ToString("F2")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Remaining</label>
                            <div class="fw-bold text-warning fs-5">₹@Model.RemainingAmount.ToString("F2")</div>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Pay" asp-route-issueId="@Model.IssueId" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IssueId" type="hidden" />
                <input asp-for="UserType" type="hidden" />
                <input asp-for="UserId" type="hidden" />

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-money-bill me-2 text-success"></i>Payment Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AmountPaid" class="form-label fw-semibold">
                                    Amount Paid (₹) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="AmountPaid" type="number" step="0.01" class="form-control"
                                           max="@Model.RemainingAmount" />
                                </div>
                                <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PaymentMode" class="form-label fw-semibold">Payment Mode</label>
                                <select asp-for="PaymentMode" class="form-select">
                                    <option value="Cash">Cash</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Online">Online</option>
                                    <option value="Waived">Waived</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReceiptNo" class="form-label fw-semibold">Receipt No.</label>
                                <input asp-for="ReceiptNo" class="form-control" placeholder="Auto-generated if empty" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="fas fa-check me-2"></i>Collect Payment
                    </button>
                    <a asp-controller="LibraryIssue" asp-action="Overdue" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
