@inject School_CRM.Services.Interface.IMenuService MenuService
@{
    var roleId = Context.Request.Cookies["roleId"];
    List<School_CRM.Models.ViewModels.MenuItemViewModel> menus = new List<School_CRM.Models.ViewModels.MenuItemViewModel>();
    if (!string.IsNullOrEmpty(roleId))
    {
        menus = await MenuService.GetMenusByRoleAsync(roleId);
        
        // Prepend static Dashboard menu item pointing to /Account/SecurePage
        menus.Insert(0, new School_CRM.Models.ViewModels.MenuItemViewModel
        {
            MenuId = 0,
            MenuName = "Dashboard",
            Url = "/Account/SecurePage",
            Icon = "fas fa-tachometer-alt"
        });
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School CRM</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" crossorigin="anonymous" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Layout CSS -->
    
    <link href="~/css/layout.css" rel="stylesheet" />
</head>
<body>
    <div class="layout-wrapper">

        <!-- ========== SIDEBAR ========== -->
        <nav class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <button class="sidebar-toggle-btn" onclick="toggleSidebarCollapse()">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="d-flex align-items-center gap-2">
                    <img src="/kic_logo.png" alt="Logo" style="height: 35px; width: auto; object-fit: contain; background: white; padding: 2px; border-radius: 4px;" />
                    <div>
                        <h3 class="mb-0" style="font-size: 0.95rem; line-height: 1.2; font-weight: 700; color: var(--text-light);">K.I.C</h3>
                        <h6 class="mb-0" style="font-size: 0.58rem; line-height: 1.2; color: var(--text-muted-light); font-weight: 400; letter-spacing: 0.02em;">School ERP</h6>
                    </div>
                </div>
                <!-- Mobile sidebar close button -->
                <button class="sidebar-close-btn d-md-none" onclick="toggleSidebarMobile()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="sidebar-menu">
                @if (menus.Any())
                {
                    <div class="menu-section-title">Navigation</div>
                    @await Html.PartialAsync("_MenuItems", menus)
                }
                else
                {
                    <!-- Main -->
                    <div class="menu-section-title">Main</div>
                    <div class="menu-item">
                        <a class="menu-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link" asp-controller="AcademicDashboard" asp-action="Index">
                            <i class="fas fa-graduation-cap"></i><span>Academic Dashboard</span>
                        </a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link" asp-controller="DocumentBuilder" asp-action="MyDocuments">
                            <i class="fas fa-file-signature"></i><span>Document Builder</span>
                        </a>
                    </div>

                    <!-- Academic -->
                    <div class="menu-section-title">Academic</div>
                    <div class="menu-item">
                        <a href="#menu-teaching" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-chalkboard"></i><span>Teaching Setup</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-teaching">
                            <div class="menu-item"><a class="menu-link" asp-controller="Subject" asp-action="Index"><i class="fas fa-book"></i><span>Subjects</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Teacher" asp-action="Index"><i class="fas fa-chalkboard-teacher"></i><span>Teachers</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ClassSubject" asp-action="Index"><i class="fas fa-link"></i><span>Class-Subject Map</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="TeacherAssignment" asp-action="Index"><i class="fas fa-user-tie"></i><span>Teacher Assignment</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Period" asp-action="Index"><i class="fas fa-clock"></i><span>Periods</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="TimeTable" asp-action="Index"><i class="fas fa-calendar-alt"></i><span>Time Table</span></a></div>
                        </div>
                    </div>
                    <div class="menu-item">
                        <a href="#menu-activity" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-user-graduate"></i><span>Student Activity</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-activity">
                            <div class="menu-item"><a class="menu-link" asp-controller="StudentAttendance" asp-action="Index"><i class="fas fa-user-check"></i><span>Attendance</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Assignment" asp-action="Index"><i class="fas fa-clipboard-list"></i><span>Assignments</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="StudyMaterial" asp-action="Index"><i class="fas fa-folder-open"></i><span>Study Materials</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Announcement" asp-action="Index"><i class="fas fa-bullhorn"></i><span>Announcements</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="CustomTest" asp-action="Index"><i class="fas fa-vial"></i><span>Custom Tests</span></a></div>
                        </div>
                    </div>
                    <div class="menu-item">
                        <a href="#menu-exam" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-file-alt"></i><span>Exam System</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-exam">
                            <div class="menu-item"><a class="menu-link" asp-controller="Exam" asp-action="Index"><i class="fas fa-file-alt"></i><span>Exams</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ExamSubject" asp-action="Index"><i class="fas fa-tasks"></i><span>Exam Subjects</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ExamMarks" asp-action="Index"><i class="fas fa-pen-alt"></i><span>Marks Entry</span></a></div>
                        </div>
                    </div>
                    <div class="menu-item">
                        <a href="#menu-report" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-graduation-cap"></i><span>Report Cards</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-report">
                            <div class="menu-item"><a class="menu-link" asp-controller="GradeMaster" asp-action="Index"><i class="fas fa-star"></i><span>Grade Master</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ExamWeightage" asp-action="Index"><i class="fas fa-balance-scale"></i><span>Exam Weightage</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ReportCard" asp-action="Index"><i class="fas fa-graduation-cap"></i><span>Report Cards</span></a></div>
                        </div>
                    </div>

                    <!-- Fee Management -->
                    <div class="menu-section-title">Fee Management</div>
                    <div class="menu-item">
                        <a href="#menu-fees" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-rupee-sign"></i><span>Fees</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-fees">
                            <div class="menu-item"><a class="menu-link" asp-controller="FeeType" asp-action="Index"><i class="fas fa-tags"></i><span>Fee Types</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="FeeStructure" asp-action="Index"><i class="fas fa-file-invoice-dollar"></i><span>Fee Structure</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="FeeCollection" asp-action="Index"><i class="fas fa-hand-holding-usd"></i><span>Fee Collection</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="FeesDashboard" asp-action="Index"><i class="fas fa-chart-pie"></i><span>Fees Dashboard</span></a></div>
                        </div>
                    </div>

                    <!-- Administration -->
                    <div class="menu-section-title">Administration</div>
                    <div class="menu-item">
                        <a href="#menu-admin" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-cogs"></i><span>Setup</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-admin">
                            <div class="menu-item"><a class="menu-link" asp-controller="AcademicSession" asp-action="Index"><i class="fas fa-calendar"></i><span>Academic Sessions</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Class" asp-action="Index"><i class="fas fa-layer-group"></i><span>Classes</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Section" asp-action="Index"><i class="fas fa-sitemap"></i><span>Sections</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ClassSection" asp-action="Index"><i class="fas fa-object-group"></i><span>Class Sections</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Holiday" asp-action="Index"><i class="fas fa-umbrella-beach"></i><span>Holidays</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="ActivityCalendar" asp-action="Index"><i class="fas fa-calendar-check"></i><span>Activity Calendar</span></a></div>
                        </div>
                    </div>
                    <div class="menu-item">
                        <a href="#menu-students" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-users"></i><span>Students</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-students">
                            <div class="menu-item"><a class="menu-link" asp-controller="Enquiry" asp-action="Index"><i class="fas fa-question-circle"></i><span>Enquiries</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="AdminStudent" asp-action="Index"><i class="fas fa-user-plus"></i><span>Admissions</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="StudentSession" asp-action="Index"><i class="fas fa-id-card"></i><span>Student Sessions</span></a></div>
                        </div>
                    </div>

                    <!-- HR -->
                    <div class="menu-section-title">HR &amp; Payroll</div>
                    <div class="menu-item">
                        <a href="#menu-hr" class="menu-link" data-bs-toggle="collapse" onclick="toggleMenu(this)">
                            <i class="fas fa-user-tie"></i><span>HR</span>
                            <i class="fas fa-chevron-down menu-toggle"></i>
                        </a>
                        <div class="collapse submenu" id="menu-hr">
                            <div class="menu-item"><a class="menu-link" asp-controller="Employee" asp-action="Index"><i class="fas fa-id-badge"></i><span>Employees</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Leave" asp-action="Index"><i class="fas fa-calendar-minus"></i><span>Leave</span></a></div>
                            <div class="menu-item"><a class="menu-link" asp-controller="Payroll" asp-action="Index"><i class="fas fa-money-check-alt"></i><span>Payroll</span></a></div>
                        </div>
                    </div>

                    <!-- Settings -->
                    <div class="menu-section-title">Settings</div>
                    <div class="menu-item">
                        <a class="menu-link" asp-controller="Report" asp-action="Index"><i class="fas fa-chart-bar"></i><span>Reports</span></a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link" asp-controller="Menu" asp-action="Index"><i class="fas fa-bars"></i><span>Menu Manager</span></a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-link" asp-controller="Account" asp-action="Login"><i class="fas fa-sign-in-alt"></i><span>Login</span></a>
                    </div>
                }
            </div>

        </nav>

        <!-- Mobile Sidebar Backdrop Overlay -->
        <div class="sidebar-backdrop" onclick="toggleSidebarMobile()"></div>

        <!-- ========== MAIN CONTENT ========== -->
        <div class="main-content" id="main-content">

            <!-- Header -->
            <header class="top-header">
                <div class="header-content">

                    <div class="header-left">
                        <button class="sidebar-toggle d-md-none" onclick="toggleSidebarMobile()">
                            <i class="fas fa-bars"></i>
                        </button>
                        <nav class="breadcrumb-modern">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="header-right">
                        <div class="header-actions">
                            <button class="header-btn" title="Notifications">
                                <i class="fas fa-bell"></i>
                                <span class="notification-badge"></span>
                            </button>
                            <button class="header-btn" title="Messages">
                                <i class="fas fa-envelope"></i>
                            </button>
                            <button class="header-btn" title="Settings">
                                <i class="fas fa-cog"></i>
                            </button>
                        </div>

                        <div class="user-profile" onclick="toggleUserMenu()">
                            <div class="user-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="user-info">
                                <div class="user-name">@(Context.Request.Cookies["EntityName"] ?? Context.Request.Cookies["userName"] ?? "User")</div>
                                <div class="user-role">@(Context.Request.Cookies["roleName"] ?? "Guest")</div>
                            </div>
                            <i class="fas fa-chevron-down ms-1" style="font-size:0.65rem;color:#9aa5b4;"></i>
                        </div>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="logout-btn">
                                <i class="fas fa-sign-out-alt me-1"></i>Logout
                            </button>
                        </form>
                    </div>

                </div>
            </header>

            <!-- Page Content -->
            <main class="content-area">
                @RenderBody()
            </main>

        </div>
    </div>

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

  
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>

    
    <script>
        function toggleSidebarCollapse() {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.querySelector('.layout-wrapper').classList.toggle('sidebar-collapsed');
        }

        function toggleSidebarMobile() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        function toggleMenu(element) {
            element.querySelector('.menu-toggle')?.classList.toggle('rotated');
        }

        function toggleUserMenu() { }

        $(document).ready(function () {
            const currentPath = window.location.pathname;
            $('.menu-link').each(function () {
                const href = $(this).attr('href');
                if (href && href !== '#' && href === currentPath) {
                    $(this).addClass('active');
                    let parent = $(this).closest('.collapse');
                    while (parent.length) {
                        parent.addClass('show');
                        $('[data-bs-target="#' + parent.attr('id') + '"] .menu-toggle').addClass('rotated');
                        parent = parent.closest('.menu-item').closest('.collapse');
                    }
                }
            });

            $(document).click(function (e) {
                if ($(window).width() <= 768) {
                    const sidebar = $('#sidebar');
                    if (!sidebar.is(e.target) && sidebar.has(e.target).length === 0 &&
                        !$('.sidebar-toggle').is(e.target)) {
                        sidebar.removeClass('active');
                    }
                }
            });

            $(window).resize(function () {
                if ($(window).width() > 768) $('#sidebar').removeClass('active');
            });
        });
    </script>

  
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>






