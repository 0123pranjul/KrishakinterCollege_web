@model List<School_CRM.ClassAttendanceRowVm>
@{ ViewData["Title"] = "Class Attendance Report"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-users text-primary me-2"></i>Class Attendance Report</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
                    <select name="classId" class="form-select" asp-items="ViewBag.Classes">
                        <option value="">Select Class</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Section</label>
                    <select name="sectionId" class="form-select" asp-items="ViewBag.Sections">
                        <option value="">All Sections</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Session</label>
                    <select name="sessionId" class="form-select" asp-items="ViewBag.Sessions">
                        <option value="">All Sessions</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">Month</label>
                    <select name="month" class="form-select">
                        @{
                            var mNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedMonthNames;
                            int todayMonth = DateTime.Today.Month;
                        }
                        @for (int m = 1; m <= 12; m++)
                        {
                            var mn = mNames[m - 1];
                            if (m == todayMonth)
                            {
                                <option value="@m" selected>@mn</option>
                            }
                            else
                            {
                                <option value="@m">@mn</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">Year</label>
                    <input type="number" name="year" class="form-control" value="@DateTime.Today.Year" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Generate</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Legend -->
        <div class="d-flex gap-3 mb-3 small">
            <span><span class="badge bg-success">●</span> &gt;85% (Good)</span>
            <span><span class="badge bg-warning text-dark">●</span> 75–85% (Average)</span>
            <span><span class="badge bg-danger">●</span> &lt;75% (Low)</span>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between py-3">
                <h6 class="fw-bold mb-0">Class Attendance — @Model.Count students</h6>
                <div class="text-muted small">
                    Class Avg: <strong>@Model.Average(r => r.Percentage).ToString("F1")%</strong>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th class="text-center">Present</th>
                                <th class="text-center">Absent</th>
                                <th class="text-center">Late</th>
                                <th class="text-center">Total Days</th>
                                <th class="text-center">Attendance %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sno = 1; }
                            @foreach (var row in Model)
                            {
                                <tr class="@row.ColorClass">
                                    <td class="text-muted">@sno++</td>
                                    <td class="fw-semibold">@row.StudentName</td>
                                    <td class="text-center text-success fw-bold">@row.Present</td>
                                    <td class="text-center text-danger fw-bold">@row.Absent</td>
                                    <td class="text-center text-warning fw-bold">@row.Late</td>
                                    <td class="text-center">@row.Total</td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1" style="height:6px;max-width:80px;">
                                                <div class="progress-bar @(row.Percentage < 75 ? "bg-danger" : row.Percentage <= 85 ? "bg-warning" : "bg-success")"
                                                     style="width:@row.Percentage%"></div>
                                            </div>
                                            <span class="fw-bold">@row.Percentage%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (ViewBag.ClassId != null)
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No attendance records found for the selected filters.</div>
    }
</div>
