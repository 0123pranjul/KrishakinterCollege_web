@model School_CRM.ClassPerformanceVm
@{ ViewData["Title"] = "Class Performance Report"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-graduation-cap text-success me-2"></i>Class Performance Report</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
                    <select name="classId" class="form-select" asp-items="ViewBag.Classes">
                        <option value="">Select Class</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Section</label>
                    <select name="sectionId" class="form-select" asp-items="ViewBag.Sections">
                        <option value="">All Sections</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Exam <span class="text-danger">*</span></label>
                    <select name="examId" class="form-select" asp-items="ViewBag.Exams">
                        <option value="">Select Exam</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Generate</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SubjectStats.Any())
    {
        <div class="row g-4">
            <!-- Subject-wise stats -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">Subject-wise Performance — @Model.ExamName</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Subject</th><th class="text-center">Average</th><th class="text-center">Highest</th><th class="text-center">Lowest</th><th class="text-center">Students</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.SubjectStats)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@s.SubjectName</td>
                                            <td class="text-center">
                                                <span class="badge @(s.Average >= 75 ? "bg-success" : s.Average >= 50 ? "bg-warning text-dark" : "bg-danger")">
                                                    @s.Average
                                                </span>
                                            </td>
                                            <td class="text-center text-success fw-bold">@s.Highest</td>
                                            <td class="text-center text-danger fw-bold">@s.Lowest</td>
                                            <td class="text-center text-muted">@s.TotalStudents</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top 5 students -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-trophy text-warning me-2"></i>Top 5 Students</h6>
                    </div>
                    <div class="card-body p-0">
                        @{ int rank = 1; }
                        @foreach (var s in Model.TopStudents)
                        {
                            string medal = rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : $"#{rank}";
                            <div class="d-flex align-items-center p-3 border-bottom">
                                <span class="me-3 fs-5">@medal</span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@s.StudentName</div>
                                    <small class="text-muted">Total: @s.TotalMarks marks</small>
                                </div>
                            </div>
                            rank++;
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.ExamId.HasValue)
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No exam marks found for the selected filters.</div>
    }
</div>
