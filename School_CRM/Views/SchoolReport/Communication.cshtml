@model List<object>
@{
    ViewData["Title"] = "Communication Reports";
    string tab      = ViewBag.Tab ?? "notifications";
    DateTime from   = ViewBag.FromDate;
    DateTime to     = ViewBag.ToDate;
    string? notiType = ViewBag.NotificationType;
    int? annId       = ViewBag.AnnouncementId;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-bell text-primary me-2"></i>Communication Reports</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
    </div>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(tab == "notifications" ? "active" : "")" asp-action="Communication" asp-route-tab="notifications">
                <i class="fas fa-bell me-1"></i>Notification Stats
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tab == "reads" ? "active" : "")" asp-action="Communication" asp-route-tab="reads">
                <i class="fas fa-eye me-1"></i>Announcement Reads
            </a>
        </li>
    </ul>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="tab" value="@tab" />
                @if (tab == "notifications")
                {
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">From Date</label>
                        <input type="date" name="fromDate" class="form-control" value="@from.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">To Date</label>
                        <input type="date" name="toDate" class="form-control" value="@to.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Notification Type</label>
                        <select name="notificationType" class="form-select">
                            <option value="">All Types</option>
                            @foreach (var t in new[] { "FeeReminder","FeeReceived","BookOverdue","BookIssued","HomeworkAssigned","ResultPublished","Announcement","LowStock","Emergency","MessageReceived","CircularUploaded","General" })
                            {
                                if (notiType == t)
                                {
                                    <option value="@t" selected>@t</option>
                                }
                                else
                                {
                                    <option value="@t">@t</option>
                                }
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Select Announcement</label>
                        <select name="announcementId" class="form-select" asp-items="ViewBag.Announcements">
                            <option value="">Select Announcement</option>
                        </select>
                    </div>
                }
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i>Filter</button>
                </div>
            </form>
        </div>
    </div>

    @if (tab == "notifications")
    {
        var stats = Model.Cast<School_CRM.NotiStatVm>().ToList();
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Notification Type</th><th class="text-center">Total Sent</th><th class="text-center">Read</th><th class="text-center">Unread</th><th>Read Rate</th></tr>
                        </thead>
                        <tbody>
                            @if (!stats.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No notifications found for the selected period.</td></tr> }
                            @foreach (var s in stats)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.NotificationType</td>
                                    <td class="text-center">@s.Total</td>
                                    <td class="text-center text-success fw-bold">@s.ReadCount</td>
                                    <td class="text-center text-danger">@(s.Total - s.ReadCount)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:6px;max-width:100px;">
                                                <div class="progress-bar @(s.ReadRate >= 75 ? "bg-success" : s.ReadRate >= 50 ? "bg-warning" : "bg-danger")"
                                                     style="width:@s.ReadRate%"></div>
                                            </div>
                                            <span class="fw-bold">@s.ReadRate%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        var reads = Model.Cast<School_CRM.Models.CommAnnouncementRead>().ToList();
        @if (annId.HasValue)
        {
            <div class="alert alert-info py-2">
                <i class="fas fa-eye me-2"></i>
                <strong>@ViewBag.ReadCount</strong> unique reader(s) for this announcement.
            </div>
        }
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Reader Type</th><th>Reader ID</th><th>Read At</th></tr>
                        </thead>
                        <tbody>
                            @if (!reads.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">No read records found.</td></tr> }
                            @foreach (var r in reads)
                            {
                                <tr>
                                    <td><span class="badge @(r.ReaderType == "Student" ? "bg-info" : r.ReaderType == "Teacher" ? "bg-secondary" : "bg-dark")">@r.ReaderType</span></td>
                                    <td>@r.ReaderId</td>
                                    <td class="text-muted">@r.ReadAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
