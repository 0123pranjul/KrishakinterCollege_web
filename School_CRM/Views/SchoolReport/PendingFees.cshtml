@model List<School_CRM.PendingFeeRowVm>
@{ ViewData["Title"] = "Pending Fees Report"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-rupee-sign text-warning me-2"></i>Pending Fees Report</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Class</label>
                    <select name="classId" class="form-select" asp-items="ViewBag.Classes">
                        <option value="">All Classes</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Section</label>
                    <select name="sectionId" class="form-select" asp-items="ViewBag.Sections">
                        <option value="">All Sections</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Session</label>
                    <select name="sessionId" class="form-select" asp-items="ViewBag.Sessions">
                        <option value="">All Sessions</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">Month</label>
                    <select name="month" class="form-select">
                        <option value="">All</option>
                        @{
                            var pfMonthNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedMonthNames;
                        }
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@pfMonthNames[m - 1]</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">Year</label>
                    <input type="number" name="year" class="form-control" value="@DateTime.Today.Year" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Generate</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm bg-danger text-white mb-4">
            <div class="card-body text-center py-3">
                <h3 class="fw-bold mb-0">₹@ViewBag.GrandTotal.ToString("F2")</h3>
                <small>Total Pending Amount — @Model.Count students</small>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>#</th><th>Student Name</th><th>Oldest Due</th><th class="text-end">Total Due</th></tr>
                        </thead>
                        <tbody>
                            @{ int sno = 1; }
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td class="text-muted">@sno++</td>
                                    <td class="fw-semibold">@row.StudentName</td>
                                    <td class="text-muted small">@(row.OldestMonth > 0 ? $"{new DateTime(2000, row.OldestMonth, 1).ToString("MMM")} {row.OldestYear}" : "-")</td>
                                    <td class="text-end fw-bold text-danger">₹@row.TotalDue.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="fw-bold text-end">Grand Total</td>
                                <td class="text-end fw-bold text-danger">₹@ViewBag.GrandTotal.ToString("F2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>No pending fees found for the selected filters.</div>
    }
</div>
