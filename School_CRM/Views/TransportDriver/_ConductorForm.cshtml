@model School_CRM.Models.TblTrnConductor
@{
    bool isNew = Model.ConductorId == 0;
}

<div class="modal-header">
    <h5 class="modal-title"><i class="fas fa-user-tag me-2 text-primary"></i>@(isNew ? "Add Conductor" : "Edit Conductor")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form onsubmit="return saveConductor(this)">
    <input type="hidden" name="ConductorId" value="@Model.ConductorId" />
    <div class="modal-body">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Conductor Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="ConductorName" value="@Model.ConductorName" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Contact Number <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="ContactNumber" value="@Model.ContactNumber" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Employee ID</label>
                <input type="number" class="form-control" name="EmployeeId" value="@Model.EmployeeId" placeholder="Optional" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Conductor</button>
    </div>
</form>
