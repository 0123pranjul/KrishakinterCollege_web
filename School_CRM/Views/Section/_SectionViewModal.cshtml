@model School_CRM.Models.TblSection

<div class="row g-3">

    <!-- Section Info Card -->
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="fas fa-layer-group me-2"></i>Section Information</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <small class="text-muted">Section ID</small>
                        <p class="fw-semibold mb-1">@Model.SectionId</p>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Section Name</small>
                        <p class="fw-semibold mb-1">@(Model.SectionName ?? "-")</p>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Status</small>
                        <p class="mb-1">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Created Date</small>
                        <p class="fw-semibold mb-1">
                            @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd-MM-yyyy hh:mm tt") : "-")
                        </p>
                    </div>
                    @if (Model.UpdatedDate.HasValue)
                    {
                        <div class="col-md-3 mt-2">
                            <small class="text-muted">Last Updated</small>
                            <p class="fw-semibold mb-1">
                                @Model.UpdatedDate.Value.ToString("dd-MM-yyyy hh:mm tt")
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Count -->
    <div class="col-12">
        <div class="card border-0 bg-light text-center">
            <div class="card-body py-3">
                <h4 class="text-primary mb-1">@Model.TblStudentSessions.Count</h4>
                <small class="text-muted">Students Enrolled in this Section</small>
            </div>
        </div>
    </div>

</div>
