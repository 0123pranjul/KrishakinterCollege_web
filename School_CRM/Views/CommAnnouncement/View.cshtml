@model School_CRM.Models.CommAnnouncement
@{ ViewData["Title"] = Model.Title; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
            {
                <a href="@Model.AttachmentPath" target="_blank" class="btn btn-outline-primary">
                    <i class="fas fa-download me-1"></i>Download PDF
                </a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h4 class="fw-bold mb-1">@Model.Title</h4>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge @(Model.Priority == "Emergency" ? "bg-danger" : Model.Priority == "High" ? "bg-warning text-dark" : "bg-primary")">
                            @Model.Priority
                        </span>
                        <span class="badge bg-light text-dark border">@Model.TargetType</span>
                        @if (Model.IsPinned) { <span class="badge bg-secondary"><i class="fas fa-thumbtack me-1"></i>Pinned</span> }
                    </div>
                </div>
                <div class="text-end text-muted small">
                    <div>Published: @Model.PublishAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                    @if (Model.ExpiresAt.HasValue) { <div>Expires: @Model.ExpiresAt.Value.ToString("dd MMM yyyy")</div> }
                    <div class="mt-1"><i class="fas fa-eye me-1"></i>@ViewBag.ReadCount read(s)</div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="announcement-body" style="line-height:1.8; font-size:1rem;">
                @Html.Raw(Model.Body.Replace("\n", "<br/>"))
            </div>
        </div>
    </div>
</div>
