@model School_CRM.Models.CommAnnouncement
@{ ViewData["Title"] = "Edit Announcement"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-edit text-primary me-2"></i>Edit Announcement</h2>
        </div>
        <a asp-action="Manage" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.AnnouncementId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="AnnouncementId" type="hidden" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">Announcement Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Body" class="form-label fw-semibold">Message <span class="text-danger">*</span></label>
                            <textarea asp-for="Body" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Body" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Replace PDF Attachment (optional)</label>
                            <input type="file" name="attachment" class="form-control" accept=".pdf" />
                            @if (!string.IsNullOrEmpty(Model.AttachmentName))
                            {
                                <small class="text-muted">Current: @Model.AttachmentName</small>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0">Settings</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Normal">Normal</option>
                                <option value="High">High</option>
                                <option value="Emergency">🚨 Emergency</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="TargetType" class="form-label fw-semibold">Target Audience</label>
                            <select asp-for="TargetType" class="form-select" id="targetTypeSelect"
                                    onchange="toggleTargetFields()">
                                <option value="All">All (Everyone)</option>
                                <option value="AllStudents">All Students</option>
                                <option value="AllTeachers">All Teachers</option>
                                <option value="ClassWise">Class-wise</option>
                                <option value="SectionWise">Section-wise</option>
                            </select>
                        </div>
                        <div id="classRow" class="mb-3 @(Model.TargetType == "ClassWise" || Model.TargetType == "SectionWise" ? "" : "d-none")">
                            <label asp-for="TargetClassId" class="form-label fw-semibold">Class</label>
                            <select asp-for="TargetClassId" class="form-select" asp-items="ViewBag.Classes">
                                <option value="">Select Class</option>
                            </select>
                        </div>
                        <div id="sectionRow" class="mb-3 @(Model.TargetType == "SectionWise" ? "" : "d-none")">
                            <label asp-for="TargetSectionId" class="form-label fw-semibold">Section</label>
                            <select asp-for="TargetSectionId" class="form-select" asp-items="ViewBag.Sections">
                                <option value="">Select Section</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PublishAt" class="form-label fw-semibold">Publish At</label>
                            <input asp-for="PublishAt" type="datetime-local" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ExpiresAt" class="form-label fw-semibold">Expires At</label>
                            <input asp-for="ExpiresAt" type="datetime-local" class="form-control" />
                        </div>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                                <label asp-for="IsPublished" class="form-check-label">Published</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsPinned" class="form-check-input" type="checkbox" />
                                <label asp-for="IsPinned" class="form-check-label">Pinned</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                    <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function toggleTargetFields() {
            const t = document.getElementById('targetTypeSelect').value;
            document.getElementById('classRow').classList.toggle('d-none', t !== 'ClassWise' && t !== 'SectionWise');
            document.getElementById('sectionRow').classList.toggle('d-none', t !== 'SectionWise');
        }
    </script>
}
