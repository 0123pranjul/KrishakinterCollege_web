@model List<School_CRM.Models.CommAnnouncement>
@{ ViewData["Title"] = "Manage Announcements"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-bullhorn text-primary me-2"></i>Manage Announcements</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Announcement</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Title</th><th>Target</th><th>Priority</th><th>Published</th><th>Expires</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ann in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@ann.Title</div>
                                    @if (ann.IsPinned) { <span class="badge bg-secondary small"><i class="fas fa-thumbtack me-1"></i>Pinned</span> }
                                    @if (!string.IsNullOrEmpty(ann.AttachmentPath)) { <span class="badge bg-light text-dark border small"><i class="fas fa-paperclip me-1"></i>PDF</span> }
                                </td>
                                <td><span class="badge bg-light text-dark border">@ann.TargetType</span></td>
                                <td>
                                    <span class="badge @(ann.Priority == "Emergency" ? "bg-danger" : ann.Priority == "High" ? "bg-warning text-dark" : ann.Priority == "Normal" ? "bg-primary" : "bg-secondary")">
                                        @ann.Priority
                                    </span>
                                </td>
                                <td class="text-muted small">@ann.PublishAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted small">@(ann.ExpiresAt?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>
                                    <span class="badge @(ann.IsPublished ? "bg-success" : "bg-secondary")">
                                        @(ann.IsPublished ? "Published" : "Draft")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="View" asp-route-id="@ann.AnnouncementId" class="btn btn-outline-primary" title="View"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@ann.AnnouncementId" class="btn btn-outline-secondary" title="Edit"><i class="fas fa-edit"></i></a>
                                        <form asp-action="Delete" asp-route-id="@ann.AnnouncementId" method="post" onsubmit="return confirm('Delete this announcement?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
