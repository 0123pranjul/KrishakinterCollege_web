@{
    ViewData["Title"] = "Study Materials";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-3">
            <div>
                <h5 class="mb-0 fw-semibold text-dark"><i class="fas fa-folder-open me-2 text-success"></i>Study Materials</h5>
                <small class="text-muted">Upload and manage study notes and materials</small>
            </div>
            <button class="btn btn-success btn-sm px-3" onclick="loadModal(0)">
                <i class="fas fa-plus me-1"></i> Add Material
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="smTable" class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th width="6%">#</th>
                            <th>Title</th>
                            <th>Teacher</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Subject</th>
                            <th width="8%" class="text-center">File</th>
                            <th width="10%" class="text-center">Status</th>
                            <th width="10%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="smModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-folder-open me-2"></i>Add Material</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="smModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        let table;
        $(document).ready(() => {
            table = $('#smTable').DataTable({
                ajax: { url: '@Url.Action("GetAll","StudyMaterial")', type: 'GET', dataSrc: 'data' },
                columns: [
                    { data: 'materialId', className: 'text-center' },
                    { data: 'title' },
                    { data: 'teacherName' },
                    { data: 'className' },
                    { data: 'sectionName' },
                    { data: 'subjectName' },
                    { data: 'hasFile', className: 'text-center', render: d => d ? '<span class="badge bg-success"><i class="fas fa-paperclip"></i></span>' : '<span class="badge bg-light text-muted">None</span>' },
                    { data: 'status', className: 'text-center', render: d => d === 'Active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>' },
                    {
                        data: 'materialId', className: 'text-center', orderable: false,
                        render: id => `<button class="btn btn-sm btn-outline-primary me-1" onclick="loadModal(${id})"><i class="fas fa-edit"></i></button>
                                       <button class="btn btn-sm btn-outline-danger" onclick="deleteRecord(${id})"><i class="fas fa-trash"></i></button>`
                    }
                ]
            });
        });

        function loadModal(id) {
            $('#modalTitle').html(id === 0 ? '<i class="fas fa-plus me-2"></i>Add Material' : '<i class="fas fa-edit me-2"></i>Edit Material');
            $.get('@Url.Action("CreateOrEdit","StudyMaterial")', { id }, html => {
                $('#smModalBody').html(html);
                $('#smModal').modal('show');
                $('#btnSave').off('click').on('click', () => {
                    const formData = new FormData($('#smForm')[0]);
                    $.ajax({
                        url: $('#smForm').attr('action'), type: 'POST', data: formData,
                        processData: false, contentType: false,
                        success: res => {
                            if (res.success) { $('#smModal').modal('hide'); table.ajax.reload(); toastr.success(res.message); }
                            else toastr.error(res.message);
                        }
                    });
                });
            });
        }

        function deleteRecord(id) {
            Swal.fire({ title: 'Delete Material?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes!' })
                .then(r => { if (r.isConfirmed) $.post('@Url.Action("Delete","StudyMaterial")', { id }, res => { if (res.success) { table.ajax.reload(); toastr.success(res.message); } else toastr.error(res.message); }); });
        }
    </script>
}
