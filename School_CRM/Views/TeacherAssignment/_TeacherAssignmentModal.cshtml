@model School_CRM.Models.TblTeacherAssignment

<form id="taForm" asp-action="CreateOrEdit" asp-controller="TeacherAssignment" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SessionId" class="form-label fw-semibold">Session <span class="text-danger">*</span></label>
            <select asp-for="SessionId" class="form-select" asp-items="@(new SelectList(ViewBag.Sessions, "SessionId", "SessionName"))" required>
                <option value="">-- Select Session --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="TeacherId" class="form-label fw-semibold">Teacher <span class="text-danger">*</span></label>
            <select asp-for="TeacherId" class="form-select" asp-items="@(new SelectList(ViewBag.Teachers, "TeacherId", "TeacherName"))" required>
                <option value="">-- Select Teacher --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="ClassId" class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
            <select asp-for="ClassId" class="form-select" asp-items="@(new SelectList(ViewBag.Classes, "ClassId", "ClassName"))" required>
                <option value="">-- Select Class --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="SectionId" class="form-label fw-semibold">Section <span class="text-danger">*</span></label>
            <select asp-for="SectionId" class="form-select" asp-items="@(new SelectList(ViewBag.Sections, "SectionId", "SectionName"))" required>
                <option value="">-- Select Section --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="SubjectId" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
            <select asp-for="SubjectId" class="form-select" asp-items="@(new SelectList(ViewBag.Subjects, "SubjectId", "SubjectName"))" required>
                <option value="">-- Select Subject --</option>
            </select>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" @(Model.IsActive == true ? "checked" : "") />
                <label class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="modal-footer px-0 pb-0 mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Assignment</button>
    </div>
</form>
