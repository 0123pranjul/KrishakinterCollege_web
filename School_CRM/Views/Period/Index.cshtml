@{
    ViewData["Title"] = "Period Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-3">
                    <div>
                        <h5 class="mb-0 fw-semibold text-dark"><i class="fas fa-clock me-2 text-purple" style="color:#6f42c1"></i>Period Management</h5>
                        <small class="text-muted">Configure school periods and break times</small>
                    </div>
                    <button class="btn btn-sm px-3 text-white" style="background:#6f42c1" onclick="loadModal(0)">
                        <i class="fas fa-plus me-1"></i> Add Period
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="periodTable" class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th width="8%">#</th>
                                    <th>Period Name</th>
                                    <th width="12%" class="text-center">Start Time</th>
                                    <th width="12%" class="text-center">End Time</th>
                                    <th width="8%" class="text-center">Seq</th>
                                    <th width="10%" class="text-center">Is Break</th>
                                    <th width="10%" class="text-center">Status</th>
                                    <th width="10%" class="text-center">Actions</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="periodModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white" style="background:#6f42c1">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-clock me-2"></i>Add Period</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="periodModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        let table;
        $(document).ready(() => {
            table = $('#periodTable').DataTable({
                ajax: { url: '@Url.Action("GetAll","Period")', type: 'GET', dataSrc: 'data' },
                order: [[4, 'asc']],
                columns: [
                    { data: null, className: 'text-center', render: function (data, type, row, meta) { return meta.row + meta.settings._iDisplayStart + 1; } },
                    { data: 'periodName' },
                    { data: 'startTime', className: 'text-center' },
                    { data: 'endTime', className: 'text-center' },
                    { data: 'sequenceNo', className: 'text-center' },
                    { data: 'isBrake', className: 'text-center', render: d => d === 'Yes' ? '<span class="badge bg-warning text-dark">Break</span>' : '<span class="badge bg-light text-dark border">No</span>' },
                    { data: 'status', className: 'text-center', render: d => d === 'Active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>' },
                    {
                        data: 'periodId', className: 'text-center', orderable: false,
                        render: id => `<button class="btn btn-sm btn-outline-primary me-1" onclick="loadModal(${id})"><i class="fas fa-edit"></i></button>
                                       <button class="btn btn-sm btn-outline-danger" onclick="deleteRecord(${id})"><i class="fas fa-trash"></i></button>`
                    }
                ]
            });
        });

        function loadModal(id) {
            $('#modalTitle').html(id === 0 ? '<i class="fas fa-plus me-2"></i>Add Period' : '<i class="fas fa-edit me-2"></i>Edit Period');
            $.get('@Url.Action("CreateOrEdit","Period")', { id }, html => {
                $('#periodModalBody').html(html);
                $('#periodModal').modal('show');
                $('#btnSave').off('click').on('click', () => {
                    $.post($('#periodForm').attr('action'), $('#periodForm').serialize(), res => {
                        if (res.success) { $('#periodModal').modal('hide'); table.ajax.reload(); toastr.success(res.message); }
                        else toastr.error(res.message);
                    });
                });
            });
        }

        function deleteRecord(id) {
            Swal.fire({ title: 'Delete Period?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes!' })
                .then(r => { if (r.isConfirmed) $.post('@Url.Action("Delete","Period")', { id }, res => { if (res.success) { table.ajax.reload(); toastr.success(res.message); } else toastr.error(res.message); }); });
        }
    </script>
}
