@model IEnumerable<School_CRM.Models.TblLessonPlan>
@{
    ViewData["Title"] = "Review Lesson Plans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .review-header {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .split-container {
        display: flex;
        gap: 20px;
        height: calc(100vh - 200px);
        min-height: 600px;
    }
    .list-pane {
        width: 35%;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .detail-pane {
        width: 65%;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .pane-header {
        background: #f8fafc;
        padding: 15px 20px;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 600;
        color: #1e293b;
    }
    .list-body {
        flex: 1;
        overflow-y: auto;
        padding: 0;
    }
    .plan-item {
        padding: 15px 20px;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: background 0.2s;
    }
    .plan-item:hover, .plan-item.active {
        background: #eff6ff;
    }
    .plan-item.active {
        border-left: 4px solid #3b82f6;
    }
    .status-badge {
        font-size: 0.75rem;
        padding: 4px 8px;
        border-radius: 12px;
        font-weight: 600;
    }
    .status-Pending { background: #fef3c7; color: #d97706; }
    .status-Approved { background: #d1fae5; color: #059669; }
    .status-Rejected { background: #fee2e2; color: #dc2626; }

    .detail-body {
        flex: 1;
        overflow-y: auto;
        padding: 25px;
    }
    .detail-footer {
        background: #f8fafc;
        padding: 15px 25px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .empty-detail {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #94a3b8;
    }
    .empty-detail i {
        font-size: 4rem;
        color: #cbd5e1;
        margin-bottom: 15px;
    }
    
    /* Content styling */
    .content-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid mt-4">
    <div class="review-header">
        <h4 class="mb-1 fw-bold"><i class="fas fa-clipboard-check me-2"></i>Review Lesson Plans</h4>
        <p class="mb-0 text-white-75">Evaluate and approve teaching strategies submitted by the faculty.</p>
    </div>

    <div class="split-container">
        <!-- List Pane -->
        <div class="list-pane">
            <div class="pane-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-list me-2"></i>Submissions</span>
                <span class="badge bg-primary rounded-pill">@Model.Count()</span>
            </div>
            <div class="list-body">
                @if(!Model.Any()) {
                    <div class="text-center p-4 text-muted">No plans available for review.</div>
                }
                @foreach (var item in Model)
                {
                    <div class="plan-item" data-id="@item.Id" onclick="loadDetails(@item.Id, this)">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="mb-0 fw-bold text-dark">@item.PlanTitle</h6>
                            <span class="status-badge status-@item.Status">@item.Status</span>
                        </div>
                        <div class="text-muted small mb-1">
                            <i class="fas fa-user-circle me-1"></i> @item.Employee?.Name
                        </div>
                        <div class="text-muted small">
                            <i class="far fa-calendar-alt me-1"></i> @item.StartDate.ToString("dd MMM") - @item.EndDate.ToString("dd MMM")
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Detail Pane -->
        <div class="detail-pane" id="detailPane">
            <div class="empty-detail">
                <i class="fas fa-file-signature"></i>
                <h5>Select a Lesson Plan</h5>
                <p>Click on a submission from the list to view its details.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPlanId = 0;

        function loadDetails(id, element) {
            $('.plan-item').removeClass('active');
            $(element).addClass('active');
            currentPlanId = id;

            $('#detailPane').html('<div class="empty-detail"><div class="spinner-border text-primary"></div></div>');

            $.get('/LessonPlanReview/GetDetails/' + id, function (data) {
                renderDetails(data);
            });
        }

        function renderDetails(data) {
            let actionButtons = '';
            if (data.status === 'Pending') {
                actionButtons = `
                    <button class="btn btn-danger fw-bold px-4" onclick="updateStatus('Rejected')">
                        <i class="fas fa-times me-2"></i>Reject
                    </button>
                    <button class="btn btn-success fw-bold px-4" onclick="updateStatus('Approved')">
                        <i class="fas fa-check me-2"></i>Approve
                    </button>
                `;
            } else {
                actionButtons = `<button class="btn btn-secondary disabled" disabled>Already ${data.status}</button>`;
            }

            let html = `
                <div class="pane-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-info-circle me-2"></i>Plan Details</span>
                    <span class="status-badge status-${data.status}">${data.status}</span>
                </div>
                <div class="detail-body">
                    <h3 class="fw-bold mb-3">${data.title}</h3>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="mb-1"><span class="text-muted"><i class="fas fa-user me-2"></i>Teacher:</span> <span class="fw-bold">${data.teacher}</span></p>
                            <p class="mb-1"><span class="text-muted"><i class="fas fa-users me-2"></i>Class:</span> <span class="fw-bold">${data.className}</span></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><span class="text-muted"><i class="fas fa-book me-2"></i>Subject:</span> <span class="fw-bold">${data.subject}</span></p>
                            <p class="mb-1"><span class="text-muted"><i class="far fa-clock me-2"></i>Duration:</span> <span class="fw-bold">${data.duration}</span></p>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary"><i class="fas fa-bullseye me-2"></i>Learning Objectives</h6>
                    <div class="content-box">${data.objectives}</div>

                    <h6 class="fw-bold text-primary"><i class="fas fa-chalkboard-teacher me-2"></i>Teaching Methodology</h6>
                    <div class="content-box">${data.methodology}</div>

                    <h6 class="fw-bold text-primary"><i class="fas fa-tools me-2"></i>Required Materials</h6>
                    <div class="content-box">${data.materials || '<span class="text-muted fst-italic">None specified</span>'}</div>

                    <div class="mt-4">
                        <label class="fw-bold text-primary"><i class="fas fa-comment-dots me-2"></i>Review Remarks (Optional)</label>
                        <textarea id="txtRemarks" class="form-control" rows="3" placeholder="Add your feedback here...">${data.remarks || ''}</textarea>
                    </div>
                </div>
                <div class="detail-footer">
                    ${actionButtons}
                </div>
            `;
            $('#detailPane').html(html);
        }

        function updateStatus(status) {
            let remarks = $('#txtRemarks').val().trim();
            if (status === 'Rejected' && remarks === '') {
                alert('Please provide review remarks for rejecting the plan.');
                $('#txtRemarks').focus();
                return;
            }

            if(confirm(`Are you sure you want to mark this plan as ${status}?`)) {
                $.post('/LessonPlanReview/UpdateStatus', {
                    id: currentPlanId,
                    status: status,
                    remarks: remarks
                }, function(res) {
                    if (res.success) {
                        window.location.reload();
                    } else {
                        alert('Error: ' + res.message);
                    }
                });
            }
        }
    </script>
}
