@model School_CRM.Models.InvStockReceipt
@{ ViewData["Title"] = "GRN Details — " + Model.Grnnumber; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-truck text-primary me-2"></i>@Model.Grnnumber</h2>
            <small class="text-muted">@Model.Supplier?.SupplierName — @Model.ReceiptDate.ToString("dd/MM/yyyy")</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2"><label class="text-muted small">GRN No.</label><div class="fw-bold"><code>@Model.Grnnumber</code></div></div>
                <div class="col-md-3"><label class="text-muted small">Supplier</label><div class="fw-semibold">@Model.Supplier?.SupplierName</div></div>
                <div class="col-md-2"><label class="text-muted small">Receipt Date</label><div>@Model.ReceiptDate.ToString("dd/MM/yyyy")</div></div>
                <div class="col-md-2"><label class="text-muted small">Invoice No.</label><div>@(Model.InvoiceNo ?? "-")</div></div>
                <div class="col-md-2"><label class="text-muted small">Invoice Amount</label><div class="fw-semibold">₹@Model.InvoiceAmount.ToString("F2")</div></div>
                <div class="col-md-1"><label class="text-muted small">Status</label><div><span class="badge @(Model.Status == "Verified" ? "bg-success" : "bg-primary")">@Model.Status</span></div></div>
                @if (Model.Po != null) { <div class="col-md-3"><label class="text-muted small">Linked PO</label><div><code>@Model.Po.Ponumber</code></div></div> }
                @if (!string.IsNullOrEmpty(Model.Remarks)) { <div class="col-12"><label class="text-muted small">Remarks</label><div class="text-muted">@Model.Remarks</div></div> }
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0">Received Items</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Product</th><th class="text-center">Received Qty</th><th class="text-end">Unit Price</th><th>Batch No.</th><th>Expiry</th><th class="text-end">Line Total</th></tr>
                    </thead>
                    <tbody>
                        @{ int sno = 1; }
                        @foreach (var item in Model.InvStockReceiptItems)
                        {
                            <tr>
                                <td class="text-muted">@sno++</td>
                                <td class="fw-semibold">@item.Product?.ProductName</td>
                                <td class="text-center">@item.ReceivedQty</td>
                                <td class="text-end">₹@item.UnitCostPrice.ToString("F2")</td>
                                <td class="text-muted">@(item.BatchNo ?? "-")</td>
                                <td class="text-muted">@(item.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end fw-semibold">₹@((item.ReceivedQty * item.UnitCostPrice).ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="6" class="text-end fw-bold">Total Amount</td>
                            <td class="text-end fw-bold text-success">₹@Model.TotalAmount.ToString("F2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
