@model School_CRM.Models.DTOs.MaintenanceLogDto
@{ ViewData["Title"] = "Log Maintenance"; }

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fas fa-wrench text-warning me-2"></i>Log Maintenance</h2>
            @if (!string.IsNullOrEmpty(Model.AssetTag)) { <small class="text-muted">Asset Tag: <code>@Model.AssetTag</code> — @Model.AssetName</small> }
        </div>
        <a asp-controller="Asset" asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" asp-route-unitId="@Model.UnitId" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="UnitId" type="hidden" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MaintenanceType" class="form-label fw-semibold">Maintenance Type <span class="text-danger">*</span></label>
                                <select asp-for="MaintenanceType" class="form-select">
                                    <option value="">Select Type</option>
                                    <option value="Repair">Repair</option>
                                    <option value="Service">Service</option>
                                    <option value="AMC">AMC</option>
                                    <option value="Inspection">Inspection</option>
                                    <option value="Disposal">Disposal</option>
                                </select>
                                <span asp-validation-for="MaintenanceType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Pending">Pending</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the maintenance work..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VendorId" class="form-label fw-semibold">Vendor</label>
                                <select asp-for="VendorId" class="form-select" asp-items="ViewBag.Vendors">
                                    <option value="">Select Vendor (optional)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ServicedBy" class="form-label fw-semibold">Serviced By</label>
                                <input asp-for="ServicedBy" class="form-control" placeholder="Technician name..." />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompletionDate" class="form-label fw-semibold">Completion Date</label>
                                <input asp-for="CompletionDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Cost" class="form-label fw-semibold">Cost (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="Cost" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillNo" class="form-label fw-semibold">Bill No.</label>
                                <input asp-for="BillNo" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ConditionBefore" class="form-label fw-semibold">Condition Before</label>
                                <select asp-for="ConditionBefore" class="form-select">
                                    <option value="">Select</option>
                                    <option value="Good">Good</option>
                                    <option value="Fair">Fair</option>
                                    <option value="Damaged">Damaged</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning text-dark px-4">
                                <i class="fas fa-save me-2"></i>Save Maintenance Log
                            </button>
                            <a asp-controller="Asset" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
