@model School_CRM.Models.TblStudentFeeOverride

@{
    var feeTypes = ViewBag.FeeTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    bool isEdit  = Model.Id > 0;
    string selectedStudentText = "";
    if (isEdit && Model.StudentId.HasValue)
    {
        var s = (ViewBag.SelectedStudent as dynamic);
        if (s != null) selectedStudentText = s.DisplayName ?? "";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<style>
    .select2-container { width: 100% !important; }
    .student-result-name  { font-weight: 600; font-size: 14px; }
    .student-result-roll  { font-size: 12px; color: #6c757d; }
</style>

<form id="overrideForm"
      asp-action="CreateOrEdit"
      asp-controller="StudentFeeOverride"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">

        <!-- Student — Select2 searchable -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                Student <span class="text-danger">*</span>
            </label>

            @if (isEdit)
            {
                <!-- Edit mode: current student fixed, hidden input -->
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <div class="form-control bg-light text-muted" style="height:auto; padding:8px 12px">
                    <i class="fas fa-user-graduate me-2 text-primary"></i>
                    <span class="fw-semibold" id="editStudentName">@selectedStudentText</span>
                    <small class="text-muted ms-2">(edit mode mein student nahi badla jaata)</small>
                </div>
            }
            else
            {
                <!-- Add mode: Select2 AJAX search -->
                <select name="StudentId" id="studentSelect2" class="form-select" required
                        style="width:100%">
                    <option value=""></option>
                </select>
                <div class="form-text text-muted">
                    <i class="fas fa-search me-1"></i>
                    Name, Roll Number ya Admission No se search karo
                </div>
            }
        </div>

        <!-- Student Info Preview (add mode) -->
        <div class="col-12" id="studentInfoCard" style="display:none">
            <div class="alert alert-info py-2 mb-0">
                <div class="row g-2">
                    <div class="col-6">
                        <small class="text-muted">Student Name</small>
                        <p class="fw-semibold mb-0" id="previewName"></p>
                    </div>
                    <div class="col-6">
                        <small class="text-muted">Roll No</small>
                        <p class="fw-semibold mb-0" id="previewRoll"></p>
                    </div>
                    <div class="col-6">
                        <small class="text-muted">Class - Section</small>
                        <p class="fw-semibold mb-0" id="previewClass"></p>
                    </div>
                    <div class="col-6">
                        <small class="text-muted">Session</small>
                        <p class="fw-semibold mb-0" id="previewSession"></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fee Type -->
        <div class="col-md-6">
            <label asp-for="FeeTypeId" class="form-label fw-semibold">
                Fee Type <span class="text-danger">*</span>
            </label>
            <select asp-for="FeeTypeId" class="form-select" id="feeTypeSelect"
                    asp-items="@(new SelectList(feeTypes, "FeeTypeId", "FeeName", Model.FeeTypeId))"
                    required>
                <option value="">-- Select Fee Type --</option>
            </select>
        </div>

        <!-- Override Amount -->
        <div class="col-md-6">
            <label asp-for="Amount" class="form-label fw-semibold">
                Override Amount (₹) <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text">₹</span>
                <input asp-for="Amount" type="number" step="0.01" min="0"
                       class="form-control" placeholder="0.00" required />
            </div>
        </div>

        <!-- FeeType Info Preview -->
        <div class="col-12" id="feeTypeInfoCard" style="display:none">
            <div class="alert alert-primary py-2 mb-0 small">
                <i class="fas fa-info-circle me-1"></i>
                Fee Type: <span class="fw-semibold" id="previewFeeName"></span>
                &nbsp;—&nbsp;<span id="previewFeeRecurring"></span>
            </div>
        </div>

        <!-- Status -->
        <div class="col-md-6">
            <label asp-for="IsActive" class="form-label fw-semibold">
                Status <span class="text-danger">*</span>
            </label>
            <select asp-for="IsActive" class="form-select"
                    asp-items="@(new SelectList(new[] {
                        new { Value = "true",  Text = "Active"   },
                        new { Value = "false", Text = "Inactive" }
                    }, "Value", "Text", Model.IsActive?.ToString().ToLower()))" required>
                <option value="">-- Select Status --</option>
            </select>
        </div>

    </div>

    <div class="modal-footer px-0 pb-0 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Override
        </button>
    </div>
</form>

<script>
    // ── FeeType preview data ──────────────────────────────────────────────────
    var feeTypeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (ViewBag.FeeTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>())
        .Select(f => new {
            feeTypeId   = (int)f.FeeTypeId,
            feeName     = (string)f.FeeName,
            isRecurring = (string)f.IsRecurring
        })
    ));

    $(function () {

        // ── Select2 — AJAX student search (only in add mode) ─────────────────
        if ($('#studentSelect2').length) {
            function initSelect2Override() {
                if (typeof $.fn.select2 === 'undefined') { setTimeout(initSelect2Override, 100); return; }
                $('#studentSelect2').select2({
                theme           : 'bootstrap-5',
                placeholder     : 'Name, Roll No ya Admission No type karo...',
                minimumInputLength: 1,
                allowClear      : true,
                dropdownParent  : $('#studentSelect2').closest('.modal-body'),
                ajax: {
                    url      : '@Url.Action("SearchStudents", "StudentFeeOverride")',
                    dataType : 'json',
                    delay    : 300,
                    data     : function (params) {
                        return { term: params.term, page: params.page || 1 };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return { results: data.results, pagination: data.pagination };
                    },
                    cache: true
                },
                templateResult  : formatStudent,
                templateSelection: formatStudentSelected
            });

            // Student select hone pe preview show karo
            $('#studentSelect2').on('select2:select', function (e) {
                var d = e.params.data;
                $('#previewName')   .text(d.name    || '-');
                $('#previewRoll')   .text(d.roll    || '-');
                $('#previewClass')  .text((d.className || '-') + (d.sectionName ? ' - ' + d.sectionName : ''));
                $('#previewSession').text(d.sessionName || '-');
                $('#studentInfoCard').slideDown(200);
            });
            $('#studentSelect2').on('select2:unselect select2:clear', function () {
                $('#studentInfoCard').slideUp(200);
            });
            }
            initSelect2Override();
        }

        // ── FeeType change preview ────────────────────────────────────────────
        var ftVal = $('#feeTypeSelect').val();
        if (ftVal) showFeeTypePreview(parseInt(ftVal));

        $(document).on('change', '#feeTypeSelect', function () {
            var v = $(this).val();
            if (v) showFeeTypePreview(parseInt(v));
            else   $('#feeTypeInfoCard').slideUp(200);
        });
    });

    // ── Select2 custom render ─────────────────────────────────────────────────
    function formatStudent(s) {
        if (s.loading) return $('<span><i class="fas fa-spinner fa-spin me-1"></i>Searching...</span>');
        if (!s.id)     return s.text;
        var name    = s.name    || s.text;
        var roll    = s.roll    || '-';
        var cls     = s.className   || '';
        var section = s.sectionName || '';
        var session = s.sessionName || '';
        var clsBadge = cls ? `<span class="badge bg-primary bg-opacity-10 text-primary border border-primary" style="font-size:10px">${cls}${section ? ' - ' + section : ''}</span>` : '';
        var sesBadge = session ? `<span class="badge bg-secondary bg-opacity-10 text-secondary border ms-1" style="font-size:10px">${session}</span>` : '';
        return $(`<div class="py-1">
            <div style="font-weight:600; font-size:14px">
                <i class="fas fa-user-graduate me-1 text-primary"></i>${name}
            </div>
            <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                <span class="text-muted" style="font-size:12px"><i class="fas fa-hashtag me-1"></i>Roll: ${roll}</span>
                ${clsBadge}${sesBadge}
            </div>
        </div>`);
    }
    function formatStudentSelected(s) {
        if (!s.id) return s.text;
        var name    = s.name    || (s.text || '').split('|')[0]?.trim() || s.text;
        var roll    = s.roll    || '';
        var cls     = s.className   || '';
        var section = s.sectionName || '';
        var extra   = [roll ? 'Roll: ' + roll : '', cls ? cls + (section ? '-' + section : '') : ''].filter(Boolean).join(' | ');
        return $(`<span><strong>${name}</strong>${extra ? '<small class="text-muted ms-2">' + extra + '</small>' : ''}</span>`);
    }

    function showFeeTypePreview(id) {
        var ft = feeTypeData.find(f => f.feeTypeId === id);
        if (ft) {
            $('#previewFeeName').text(ft.feeName);
            var badge = ft.isRecurring === 'Monthly'
                ? '<span class="badge bg-primary">Monthly (Recurring)</span>'
                : '<span class="badge bg-secondary">One Time</span>';
            $('#previewFeeRecurring').html(badge);
            $('#feeTypeInfoCard').slideDown(200);
        }
    }
</script>
