@model IEnumerable<School_CRM.Models.TblLessonPlan>
@{
    ViewData["Title"] = "Lesson Planner Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .lp-dashboard-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: white;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .status-card {
        border-radius: 12px;
        border: none;
        padding: 20px;
        color: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }
    .status-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    .card-total { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); }
    .card-pending { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    .card-approved { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
    .card-rejected { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
    
    .coverage-widget {
        background: #f8fafc;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        border: 1px solid #e2e8f0;
    }
    .coverage-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: conic-gradient(#3b82f6 @ViewBag.AvgCoverage%, #e2e8f0 0);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        position: relative;
    }
    .coverage-circle::before {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        background: #f8fafc;
        border-radius: 50%;
    }
    .coverage-value {
        position: relative;
        font-size: 2rem;
        font-weight: 800;
        color: #1e293b;
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="lp-dashboard-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 fw-bold"><i class="fas fa-chalkboard-teacher me-2"></i>Lesson Planner Dashboard</h3>
            <p class="mb-0 text-white-50">High-level view of teaching plans and overall syllabus coverage.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "LessonPlanReview")" class="btn btn-primary fw-bold rounded-pill px-4 shadow">
                <i class="fas fa-clipboard-check me-2"></i>Review Pending Plans
            </a>
        </div>
    </div>

    <!-- Status Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="status-card card-total h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-75 fw-bold mb-1 text-uppercase">Total Plans</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalPlans</h2>
                    </div>
                    <i class="fas fa-folder-open fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="status-card card-pending h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-75 fw-bold mb-1 text-uppercase">Pending Review</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.PendingPlans</h2>
                    </div>
                    <i class="fas fa-clock fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="status-card card-approved h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-75 fw-bold mb-1 text-uppercase">Approved</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.ApprovedPlans</h2>
                    </div>
                    <i class="fas fa-check-circle fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="status-card card-rejected h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-75 fw-bold mb-1 text-uppercase">Rejected</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.RejectedPlans</h2>
                    </div>
                    <i class="fas fa-times-circle fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Average Coverage Widget -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h5 class="fw-bold text-dark">Average Lesson Coverage</h5>
                </div>
                <div class="card-body">
                    <div class="coverage-widget h-100 d-flex flex-column justify-content-center">
                        <div class="coverage-circle">
                            <div class="coverage-value">@ViewBag.AvgCoverage%</div>
                        </div>
                        <p class="text-muted fw-bold mb-0">School-wide completion metric</p>
                        <small class="text-muted mt-2 d-block">Based on daily teacher logs</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Approvals Table -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-inbox text-primary me-2"></i>Recent Submissions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Plan Title</th>
                                    <th>Teacher</th>
                                    <th>Subject</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(!Model.Any()) {
                                    <tr><td colspan="4" class="text-center text-muted fst-italic">No recent submissions found.</td></tr>
                                }
                                @foreach (var plan in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@plan.PlanTitle</td>
                                        <td>@plan.Employee?.Name</td>
                                        <td>@plan.Subject?.SubjectName</td>
                                        <td>
                                            @if (plan.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Pending</span>
                                            }
                                            else if (plan.Status == "Approved")
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Approved</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
